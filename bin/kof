#!/usr/bin/env bash
#
# kof — Kof platform launcher.
#
# Uses the embedded OpenJDK shipped with the official distribution when
# present (jdk/ next to bin/). Falls back to a system `java` only in
# development builds that do not carry an embedded JDK.
#
# Resolves symlinks so the distribution can be invoked from anywhere.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
KOF_BIN="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
KOF_HOME="$(dirname "$KOF_BIN")"

JAR="$KOF_HOME/lib/kof.jar"
if [ ! -f "$JAR" ]; then
    echo "kof: distribution incomplete — missing $JAR" >&2
    echo "kof: build it with: mvn clean package -DskipTests && scripts/package.sh" >&2
    exit 1
fi

EMBEDDED=false
JAVA="$(command -v java || true)"
if [ -x "$KOF_HOME/jdk/bin/java" ]; then
    JAVA="$KOF_HOME/jdk/bin/java"
    EMBEDDED=true
elif [ -f "$KOF_HOME/jdk/bin/java.exe" ]; then
    # no Windows o zip não preserva o bit de execução unix — basta existir
    JAVA="$KOF_HOME/jdk/bin/java.exe"
    EMBEDDED=true
elif [ -x "$KOF_HOME/jdk/Contents/Home/bin/java" ]; then
    JAVA="$KOF_HOME/jdk/Contents/Home/bin/java"
    EMBEDDED=true
fi
if [ -z "$JAVA" ]; then
    echo "kof: no java found — install the official Kof distribution (it embeds a JDK)" >&2
    exit 1
fi

# KofJS embeds a JavaScript engine (GraalJS/Truffle) in the Kof process;
# quiet the JDK warnings it emits when it initializes on stock JDKs.
# The Unsafe-access option only exists on JDK 24+; the embedded JDK is
# Temurin 21, so the flag is added only when the runtime supports it.
UNSAFE_FLAG=""
JAVA_MAJOR="$("$JAVA" -version 2>&1 | sed -n 's/.*version "\([0-9]*\).*/\1/p' | head -1)"
if [ -n "$JAVA_MAJOR" ] && [ "$JAVA_MAJOR" -ge 24 ] 2>/dev/null; then
    UNSAFE_FLAG="--sun-misc-unsafe-memory-access=allow"
fi
# kof4shell (CVE-2026-114938): the HotSpot AVX-512 Base64 decode intrinsic
# overflows the heap on padded inputs (Intel Ice Lake+/AMD Zen 4+, JDK
# 17.0.6+/21/25) — unauthenticated RCE. The CLI's child JVMs carry
# -XX:-UseBASE64Intrinsics (KofStdio) and so does THIS launcher process: the
# CLI itself runs java.util.Base64 (deps/config/acme). KOF_B64_INTRINSICS=1
# opts out for a JDK carrying the fix (11.0.33.1/17.0.21.1/21.0.13.1/
# 25.0.5.1/27.0.1.1).
B64_FLAG="-XX:-UseBASE64Intrinsics"
# #1173 (19/11, decisão da mantenedora: version-gate): o desarme é automático
# SÓ abaixo do build corrigido da linha do JDK em uso. KOF_B64_INTRINSICS=1
# força ligado; =0 força desarmado; sem env, decide a versão (linhas fora da
# tabela ficam desarmadas por conservadorismo; 28+ presume-se corrigida).
case "${KOF_B64_INTRINSICS:-}" in
  1) B64_FLAG="" ;;
  0) ;;
  *)
    JV=$("$JAVA" -XshowSettings:properties -version 2>&1 | sed -n 's/^ *java\.version = //p' | head -1)
    MAJ=${JV%%.*}
    FIX=""
    case "$MAJ" in
      17) FIX="17.0.21.1" ;;
      21) FIX="21.0.13.1" ;;
      25) FIX="25.0.5.1" ;;
      27) FIX="27.0.1.1" ;;
    esac
    if [ -n "$FIX" ] && sort -V </dev/null >/dev/null 2>&1; then
      LOW=$(printf '%s\n%s\n' "$FIX" "$JV" | sort -V | head -1)
      if [ "$LOW" = "$FIX" ]; then B64_FLAG=""; fi
    elif [ -z "$FIX" ]; then
      case "$MAJ" in
        ''|*[!0-9]*) ;;                       # desconhecido → conservador
        *) [ "$MAJ" -gt 27 ] && B64_FLAG="" ;; # linha acima da tabela
      esac
    fi
    ;;
esac
exec "$JAVA" --enable-native-access=ALL-UNNAMED $UNSAFE_FLAG $B64_FLAG \
    -Dkof.install.dir="$KOF_HOME" -Dkof.embedded.jdk="$EMBEDDED" \
    -jar "$JAR" "$@"