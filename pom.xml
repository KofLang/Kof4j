<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.kof</groupId>
    <artifactId>kof-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Kof</name>
    <description>A modern statically-typed language for the JVM</description>

    <modules>
        <module>kof-compiler</module>
        <module>kof-cli</module>
        <module>kof-runtime</module>
        <module>kof-script</module>
        <module>kof-c-compiler</module>
    </modules>

    <properties>
        <!--
          Single source of truth for the build version is the VERSION file at the
          repository root. The release pipeline reads it and updates this property
          (scripts/bump-version.sh). Do not edit this by hand.
        -->
        <revision>0.5.0-beta</revision>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Reproducible builds: a fixed timestamp for archive entries makes the kof-cli jar
          byte-identical across clean builds and build paths (measured: 3 builds, same sha256;
          without it every build had a different digest). Needed for any "rebuild and compare
          digests" verification — see scripts/check-reproducible-build.sh.
        -->
        <project.build.outputTimestamp>2020-01-01T00:00:00Z</project.build.outputTimestamp>
        <asm.version>9.10.1</asm.version>
        <junit.version>6.1.3</junit.version>
        <graaljs.version>25.3.4.1</graaljs.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-util</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm-tree</artifactId>
                <version>${asm.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <release>25</release>
                        <compilerReuseStrategy>alwaysNew</compilerReuseStrategy>
                        <!-- o incremental do javac corrompe o target/classes
                             (NoClassDefFoundError intermitente de inner
                             classes: KofLog$LogCall, KofUi$UiCall...) -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                    <configuration>
                        <!-- -Xshare:off: o CDS do fork quebra o class loading
                             com NoClassDefFoundError intermitente de classes
                             que existem no classpath -->
                        <argLine>-Xshare:off -Xmx1g</argLine>
                        <!-- D-BASELINE (release 25): os testes E2E spawnam
                             `java` do PATH para rodar o binário compilado —
                             sem isto um host com JDK 21 no PATH carrega
                             KofRuntime class-file 69 com JVM 65
                             (UnsupportedClassVersionError em massa). O `bin`
                             do JDK QUE COMPILA vai primeiro. -->
                        <environmentVariables>
                            <PATH>${java.home}/bin:${env.PATH}</PATH>
                        </environmentVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- CI-friendly ${revision} (0.5.0-beta): sem o flatten, o `install`
                 grava poms com parent `<version>${revision}</version>` LITERAL —
                 pom podre no ~/.m2 que quebra todo `-pl <modulo>` offline
                 ("Failed to read artifact descriptor ... :${revision}") e faz o
                 shade do kof-cli desviar p/ artifacts velhos do repo local.
                 resolveCiFriendliesOnly = só reescreve os placeholders de
                 versão no pom instalado; o grafo de build não muda. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.0</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
