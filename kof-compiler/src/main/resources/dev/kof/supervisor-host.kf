interface KofWorker {
    Object run()
}

interface KofWorkerFactory {
    KofWorker novo()
}

interface KofEscalate {
    Void disparou(String id, String motivo, Int reinicios)
}

class KofSupStats {
    Int started
    Int restarts
    Int dropped
    Int vivos
}

// ===== S3 (DD-OTP-02/10 ratificados 13/09): janela deslizante por filho =====
// Anel fixo (capacidade maxReinicios): guardo o timestamp de cada falha que
// consome um reinicio; a contagem "na janela" expira entradas antigas
// (timestamp + windowMillis <= agora). Relógio injetável (.clock) torna o
// gate determinístico — default time.now().
class KofSupWindow {
    Int[] stamp
    Int size = 0
    Int head = 0
    Int windowMs = 0
    () -> Long clock = null

    public constructor(Int cap, Int windowMs, () -> Long clock) {
        if (cap < 1) { cap = 1 }
        this.stamp = new Int[cap]
        this.windowMs = windowMs
        this.clock = clock
    }

    Void falha(Long agora) {
        var idx = (head + size) % stamp.length
        var t: Int = (agora / 1000) as Int
        stamp[idx] = t
        if (size < stamp.length) { size = size + 1 } else { head = (head + 1) % stamp.length }
    }

    // reinicios disponíveis na janela = falhas ainda vivas nela
    // (while + índice: `stamp[i]` dentro de for-range tropeça no parser,
    //  catalogado à parte — não é semântica desta unidade)
    Int naJanela(Long agora) {
        var vivos = 0
        var i = 0
        while (i < size) {
            var t = stamp[(head + i) % stamp.length]
            if (!(windowMs > 0 && t + windowMs <= agora)) { vivos = vivos + 1 }
            i = i + 1
        }
        return vivos
    }
}

class KofSupNode {
    String id
    KofWorkerFactory fabrica
    String politica
    Handle<Object> h = null
    Bool running = false
    Int reinicios = 0
    KofSupWindow janela = null
    Bool dropada = false
    // DD-OTP-08: wrap VIVO da volta atual — stop() escreve wrap.parar=true
    // (campo mutável = volatile, SG-020) e o worker cooperativo consulta
    // via shouldStop() do handle de contexto.
    KofSupWrap wrap = null
}

class Supervisor {
    String nome
    List<KofSupNode> filhos
    Int maxReinicios = 0
    Int janelaMs = 0
    () -> Long clockFn = null
    Bool vivo = false
    Bool drenando = false
    KofEscalate escalar = null

    public constructor(String nome) {
        this.nome = nome
        this.filhos = listOf()
    }

    Supervisor child(String id, KofWorkerFactory fabrica, String politica) {
        if (vivo) { throw "supervisor '" + nome + "': child() depois de start()" }
        if (fabrica == null) { throw "supervisor '" + nome + "': fabrica nula" }
        if (!(politica == "permanent" || politica == "transient" || politica == "temporary")) {
            throw "supervisor '" + nome + "': politica desconhecida '" + politica + "'"
        }
        var n = KofSupNode()
        n.id = id
        n.fabrica = fabrica
        n.politica = politica
        filhos.add(n)
        return this
    }

    Supervisor restartLimit(Int max) {
        if (vivo) { throw "supervisor '" + nome + "': restartLimit() depois de start()" }
        if (max < 0) { throw "supervisor '" + nome + "': maxReinicios negativo" }
        maxReinicios = max
        return this
    }

    // S3: limite COM janela deslizante (DD-OTP-02). windowMs <= 0 = janela
    // infinita (equivalente ao restartLimit(max) de 1 arg).
    Supervisor restartLimitWindow(Int max, Int windowMs) {
        restartLimit(max)
        if (windowMs < 0) { throw "supervisor '" + nome + "': windowMs negativo" }
        janelaMs = windowMs
        return this
    }

    // S3/DD-OTP-10: relógio injetável p/ gate determinístico (default time.now).
    Supervisor clock(() -> Long nowFn) {
        if (vivo) { throw "supervisor '" + nome + "': clock() depois de start()" }
        if (nowFn == null) { throw "supervisor '" + nome + "': clock nulo" }
        clockFn = nowFn
        return this
    }

    Long agora() {
        // copia o campo p/ local: chamada direta do field de function-type
        // dentro da classe não é resolvida como função (SEM015)
        var tickFn = this.clockFn
        if (tickFn != null) { return tickFn() }
        return time.now()
    }

    KofSupWindow janelaDe(KofSupNode n) {
        if (n.janela == null) {
            var cap = maxReinicios
            if (cap < 1) { cap = 1 }
            n.janela = KofSupWindow(cap, janelaMs, clock)
        }
        return n.janela
    }

    Supervisor escalate(KofEscalate callback) {
        escalar = callback
        return this
    }

    Void start() {
        if (vivo) { return }
        if (filhos.size == 0) { throw "supervisor '" + nome + "': sem children" }
        vivo = true
        drenando = false
        var self = this
        for (var n in filhos) {
            n.running = true
            spawn { self.vigiar(n) }
        }
    }

    Void vigiar(KofSupNode n) {
        while (n.running) {
            var w = n.fabrica.novo()
            n.reinicios = n.reinicios + 1
            this.anotarReinicio(n)
            n.h = spawn { w.run() }
            var motivo = "normal"
            var falhou = false
            try {
                var r = await n.h
            } catch (String e) {
                motivo = e
                falhou = true
            }
            if (drenando) { n.running = false; return }
            if (!falhou && n.politica != "permanent") {
                n.running = false
                return
            }
            var reiniciosUsados = n.reinicios - 1
            if (n.politica == "temporary") {
                n.dropada = true
                this.relatar(n, motivo, reiniciosUsados, true)
                n.running = false
                return
            }
            if (this.excedeuLimite(n)) {
                this.relatar(n, motivo, reiniciosUsados, true)
                n.running = false
                return
            }
            this.relatar(n, motivo, reiniciosUsados, false)
            time.sleep(1)
        }
    }

    Void relatar(KofSupNode n, String motivo, Int reinicios, Bool excedeu) {
        if (escalar != null) {
            escalar.disparou(n.id, motivo, reinicios)
            return
        }
        var extra = ""
        if (excedeu) { extra = " — limite excedido, nao reinicia (R6)" }
        println("supervisor '" + nome + "': child '" + n.id + "' (" + motivo
            + ", reinicios=" + reinicios + extra + ")")
    }

    // S3: limite com janela deslizante — cada REINICIO lançado registra o
    // timestamp no anel do filho; a falha atual excede o limite quando os
    // reinicios ainda vivos na janela alcançam maxReinicios. Com janelaMs==0
    // nada expira → contagem total = semântica antiga (restartLimit(max)).
    Bool excedeuLimite(KofSupNode n) {
        if (maxReinicios <= 0) { return false }
        if (janelaMs <= 0) {
            var usados = n.reinicios - 1
            return usados >= maxReinicios
        }
        var j = janelaDe(n)
        return j.naJanela(agora()) >= maxReinicios
    }

    Void anotarReinicio(KofSupNode n) {
        if (maxReinicios <= 0 || janelaMs <= 0) { return }
        janelaDe(n).falha(agora())
    }

    Void stop(Int deadlineMs) {
        if (!vivo) { return }
        drenando = true
        // DD-OTP-08: 1a alavanca = flag cooperativa. Campo mutável de classe
        // Kof é ACC_VOLATILE (SG-020) — a escrita é observável pelo worker
        // em TODOS os alvos (JVM/x86/JS/Script; riscv/aarch = gate OTP001).
        // O cancel(handle) continua como bônus onde existe.
        for (var c in filhos) {
            if (c.wrap != null) { c.wrap.parar = true }
            if (c.running && c.h != null) { cancel(c.h) }
        }
        var limites = time.now() + deadlineMs
        while (temVivo() && time.now() < limites) {
            time.sleep(2)
        }
        for (var e2 in filhos) {
            if (e2.running) {
                println("supervisor '" + nome + "': child '" + e2.id
                    + "' nao parou em " + deadlineMs + "ms (cancel cooperativo)")
                e2.running = false
            }
        }
        vivo = false
        drenando = false
    }

    Bool temVivo() {
        var t = false
        for (var n in filhos) {
            if (n.running) { t = true }
        }
        return t
    }

    KofSupStats stats() {
        var s = KofSupStats()
        s.started = filhos.size
        s.restarts = 0
        s.dropped = 0
        s.vivos = 0
        for (var n in filhos) {
            if (n.reinicios > 0) { s.restarts = s.restarts + n.reinicios - 1 }
            if (n.running) { s.vivos = s.vivos + 1 }
            if (n.dropada) { s.dropped = s.dropped + 1 }
        }
        return s
    }

Supervisor startAll() {
    if (vivo) { return this }
    if (filhos.size == 0) { throw "supervisor '" + nome + "': sem children" }
    vivo = true
    drenando = false
    var self = this
    spawn { self.lacoUnico() }
    return this
}

Void lacoUnico() {
    while (!drenando) {
        var vivos = listOf()
        for (var n in filhos) {
            if (n.running) { vivos.add(n) }
        }
        if (vivos.size == 0) { return }
        var handles = listOf()
        for (var n in vivos) {
            var w = n.fabrica.novo()
            n.reinicios = n.reinicios + 1
            this.anotarReinicio(n)
            var wrap = KofSupWrap(n.id, w)
            n.wrap = wrap
            n.h = spawn kofSupRun(wrap)
            handles.add(n.h)
        }
        // espera o PRIMEIRO terminar (selectAny devolve o id — wrapper 1a)
        try {
            var id = selectAny(handles)
            for (var n in vivos) {
                if (n.id == id) {
                    if (n.politica == "permanent") {
                        this.relatar(n, "normal", n.reinicios - 1, false)
                        time.sleep(1)
                    } else {
                        n.running = false
                    }
                }
            }
        } catch (String e) {
            // falha: mensagem = "id: motivo" (wrapper de identidade)
            var sep = e.indexOf(":")
            var id2 = ""
            var motivo2 = ""
            if (sep > 0) { id2 = e.substring(0, sep); motivo2 = e.substring(sep + 2) } else { motivo2 = e }
            var achou = false
            for (var n in vivos) {
                if (n.id == id2) {
                    achou = true
                    var reiniciosUsados = n.reinicios - 1
                    if (n.politica == "temporary") {
                        n.dropada = true
                        this.relatar(n, motivo2, reiniciosUsados, true)
                        n.running = false
                    } else if (this.excedeuLimite(n)) {
                        this.relatar(n, motivo2, reiniciosUsados, true)
                        n.running = false
                    } else {
                        this.relatar(n, motivo2, reiniciosUsados, false)
                        time.sleep(1)
                    }
                }
            }
            if (!achou) { throw e }
        }
    }
}
}

// ===== S2 (DD-OTP-03, opção 1a ratificada 13/09): N workers sem bloquear =====
// Um laço único com selectAny sobre os handles vivos; cada filho roda um
// WRAPPER que devolve o id (término normal) ou lança "id: motivo" (falha) —
// o par (id, motivo) ratificado. Custo: 1 thread supervisora, zero threads
// extras por filho. riscv/aarch: PARTIAL (selectAny ausente — gate R6 já
// bloqueia o pacote no compile-time com OTP001).

class KofSupWrap {
    String id
    KofWorker w
    // DD-OTP-08: flag de parada cooperativa. Campo MUTÁVEL de classe Kof =
    // emitido ACC_VOLATILE (SG-020, emenda 14/09) — a escrita de stop() é
    // observável pelo laço/worker sem risco de o C2 hoistar o load.
    Bool parar = false
    constructor(String id, KofWorker w) { this.id = id; this.w = w }
}

class KofSupResult {
    String id
    String motivo
    Object valor
    Bool falhou
}

// wrapper (opção 1a): devolve o id (término normal) — falha propaga como
// "id: motivo"; o selectAny do laço devolve o id ou relança a falha.
String kofSupRun(KofSupWrap wrap) {
    try {
        wrap.w.run()
        return wrap.id
    } catch (String e) {
        throw wrap.id + ": " + e
    }
}

// DD-OTP-08: consulta da flag cooperativa pelo worker. A flag vive no wrap
// da volta atual do filho (campo mutável = volatile, SG-020); lida por um
// clojure/lambda capturado — o padrão provado por
// KofConcurrency2Test.stopFlagCapturedBoxObservedBySpinReader.
Bool kofSupShouldStop(KofSupWrap wrap) {
    return wrap.parar
}


Supervisor supervisor(String nome) {
    return Supervisor(nome)
}
