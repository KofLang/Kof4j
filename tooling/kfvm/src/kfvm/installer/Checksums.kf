package kfvm.installer

class Checksums {
    static String of(String? sums, String file) {
        if (sums == null) {
            return ""
        }

        for (var line in sums.split("\n")) {
            var entry = line.trim()
            var space = entry.indexOf(" ")
            if (space > 0 && nameOf(entry.substring(space)) == file) 
                return entry.substring(0, space).toLowerCase()
        }

        return ""
    }

    static String nameOf(String field) {
        var name = field.trim()
        return if (name.startsWith("*")) name.substring(1) else name
    }
}
