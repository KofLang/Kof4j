package kfvm.platform

import kof.io

class WindowsFileSystem implements kfvm.platform.FileSystem {
    void link(String target, String link) {
        unlink(link)
        PowerShell.run("New-Item -ItemType Junction -Path $env:KFVM_LINK -Target $env:KFVM_TARGET | Out-Null",
            mapOf("KFVM_LINK", PowerShell.windowsPath(link), "KFVM_TARGET", PowerShell.windowsPath(target)))
    }

    String linkTarget(String link) {
        if (!File(link).exists()) return ""
        return PowerShell.run("$item = Get-Item -LiteralPath $env:KFVM_LINK -Force; if ($item.LinkType) { $item.Target }",
            mapOf("KFVM_LINK", PowerShell.windowsPath(link))).trim()
    }

    void unlink(String link) {
        PowerShell.run("$item = Get-Item -LiteralPath $env:KFVM_LINK -Force -ErrorAction Ignore; if ($item) { $item.Delete() }",
            mapOf("KFVM_LINK", PowerShell.windowsPath(link)))
    }

    void deleteTree(String path) {
        PowerShell.run("if (Test-Path -LiteralPath $env:KFVM_PATH) { " +
            "$trash = $env:KFVM_PATH + '.' + [guid]::NewGuid().ToString('N'); " +
            "Move-Item -LiteralPath $env:KFVM_PATH -Destination $trash; " +
            "Remove-Item -LiteralPath $trash -Recurse -Force }",
            mapOf("KFVM_PATH", PowerShell.windowsPath(path)))
    }

    String sha256(String file) {
        return PowerShell.run("(Get-FileHash -LiteralPath $env:KFVM_PATH -Algorithm SHA256).Hash",
            mapOf("KFVM_PATH", PowerShell.windowsPath(file))).trim().toLowerCase()
    }
}
