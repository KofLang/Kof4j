package kfvm.system

import kof.config

class Env {
    static String get(String name) {
        var value = config.env(name)
        if (value == null) return ""
        return value
    }

    static String getOr(String name, String fallback) {
        var value = get(name)
        return if (value == "") fallback else value
    }

    static String userHome() {
        return getOr("HOME", get("USERPROFILE"))
    }
}
