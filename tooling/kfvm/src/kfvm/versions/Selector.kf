package kfvm.versions

class Selector {
    static Bool isChannel(String query) {
        return isStable(query) || query == "nightly"
    }

    static Bool isStable(String query) {
        return query == "lts" || query == "latest"
    }

    static String select(String query, List<Candidate> candidates) {
        var want = if (query.startsWith("v")) query.substring(1) else query
        if (isChannel(want))
            return newestOfChannel(want == "nightly", candidates)

        var newest = ""
        for (var c in candidates) {
            if (c.version() == want) return want;
            if (matchesPrefix(c.version(), want) && (newest == "" || Versions.compare(c.version(), newest) > 0))
                newest = c.version()
        }

        return newest
    }

    static Bool matchesPrefix(String version, String prefix) {
        if (prefix == "" || !version.startsWith(prefix) || version.length == prefix.length)
            return false
        var next = version.substring(prefix.length, prefix.length + 1)
        return next == "." || next == "-" || next == "+"
    }

    static String newestOfChannel(Bool nightly, List<Candidate> candidates) {
        var newest = ""
        for (var c in candidates) {
            if (c.nightly() == nightly && (newest == "" || Versions.compare(c.version(), newest) > 0))
                newest = c.version()
        }
        return newest
    }
}
