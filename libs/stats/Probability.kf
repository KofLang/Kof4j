package stats

// kof.stats — probability faces (universal platform Stage 4.3, the exact
// discrete half). uniform/bernoulli/binomial over `random.double()` — the
// S10 OS-entropy primitive (getrandom / SecureRandom / the JS host), in
// [0, 1) by contract, never seedable. Pure Kof: no FFI, no new primitive.
//
// The CONTINUOUS faces (normal/exponential) ride `math.log`/`math.exp` —
// the primitives that did NOT exist until MATH-LOG-EXP landed them on every
// target (07/11). They are the reason the primitive was added: a hand-rolled
// series would have been a platform fake wearing a library's name.
//
// normal() is the Box-Muller transform (two uniforms -> two independent
// normals; the second is discarded — the caller who needs both calls it
// twice, which is honest and costs one extra draw). exponential() is the
// inverse-CDF transform -ln(1-u)/rate.
//
// Refusals (honest diagnostics, never a silent 0):
//   STATS003 — uniform requires min < max
//   STATS004 — bernoulli requires 0 <= p <= 1
//   STATS005 — binomial requires n >= 0
//
// uniform returns [min, max) (the half-open interval inherits random.double's
// contract). bernoulli's edges are exact: p = 0 is always false, p = 1 is
// always true (a draw in [0,1) is never >= 1). binomial sums n exact trials.

// uniform — one draw from [min, max); a degenerate interval refuses (STATS003).
Double uniform(Double min, Double max) {
    if (min >= max) {
        throw "STATS003: uniform requires min < max"
    }
    return min + (max - min) * random.double()
}

// bernoulli — a single yes/no trial with probability p.
Bool bernoulli(Double p) {
    if (p < 0.0 || p > 1.0) {
        throw "STATS004: bernoulli requires 0 <= p <= 1"
    }
    return random.double() < p
}

// binomial — the count of hits over n independent bernoulli(p) trials;
// n = 0 is the empty sum and returns 0.
Int binomial(Int n, Double p) {
    if (n < 0) {
        throw "STATS005: binomial requires n >= 0"
    }
    var hits = 0
    var i = 0
    while (i < n) {
        if (bernoulli(p)) {
            hits = hits + 1
        }
        i = i + 1
    }
    return hits
}

// normal — one draw from N(mean, stddev^2) via the Box-Muller transform.
// stddev must be > 0 (STATS006): a zero or negative spread is not a
// distribution. The transform is exact in the sense that it maps two
// independent uniforms to two independent normals; the second is discarded
// here (a caller needing both calls normal twice — one extra draw, honest).
Double normal(Double mean, Double stddev) {
    if (stddev <= 0.0) {
        throw "STATS006: normal requires stddev > 0"
    }
    var u1 = random.double()
    var u2 = random.double()
    // u1 can be 0.0 (random.double is [0,1)); log(0) is -Inf, so clamp the
    // argument to the smallest positive double the transform can use.
    if (u1 <= 0.0) {
        u1 = 1.0e-300
    }
    var r = math.sqrt(-2.0 * math.log(u1))
    var theta = 2.0 * math.pi() * u2
    return mean + stddev * r * math.cos(theta)
}

// exponential — one draw from Exp(rate) via the inverse-CDF transform
// -ln(1-u)/rate. rate must be > 0 (STATS007): a zero rate has no mean.
Double exponential(Double rate) {
    if (rate <= 0.0) {
        throw "STATS007: exponential requires rate > 0"
    }
    var u = random.double()
    // 1-u is in (0,1]; log(1) = 0 is fine, log(0) cannot happen since u < 1.
    return -math.log(1.0 - u) / rate
}
