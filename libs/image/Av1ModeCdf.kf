package image

// kof.image — AV1 default mode-info CDFs (slice 3m of the AVIF front, plan §34).
// The non-coefficient entropy tables the tile block syntax reads: the partition
// tree, the intra frame Y mode, the Y/UV mode, angle delta, filter-intra, the
// segment/skip/tx-size/delta-q/delta-lf symbols, the CFL sign/alpha and the
// transform-partition split. Every table is the AV1 Bitstream & Decoding Process
// Specification §10 (additional tables) table, read on the dev host 06/10, and
// independently confirmed value-for-value against libaom
// `av1/common/entropymode.c` (15 tables, zero differences).
//
// A CDF array is the spec representation: N+1 entries where cdf[0..N-1] are the
// cumulative probabilities scaled by 1<<15 (cdf[N-1] == 1<<15) and cdf[N] is the
// adaptation counter. The accessors return a fresh copy so a caller (the tile
// walk) can adapt it in place without mutating the defaults.
//
// Pure Kof: strings parsed with `split`/`toInt`, so all targets.

// Parses a comma-separated int table into a flat Int[].
Int[] av1ModeCdfParse(String s) {
    var parts = s.split(",")
    var out = new Int[parts.size]
    var i = 0
    while (i < parts.size) {
        out[i] = parts[i].toInt()
        i = i + 1
    }
    return out
}

// Copies the CDF slice at `index` of `n` entries out of a flat table.
Int[] av1ModeCdfAt(Int[] data, Int index, Int n) {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = data[index * n + i]
        i = i + 1
    }
    return out
}

// Copies `n` entries starting at `offset` out of a flat table.
Int[] av1ModeCdfSlice(Int[] data, Int offset, Int n) {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = data[offset + i]
        i = i + 1
    }
    return out
}

class Av1ModeCdf {
    Int[] partitionData
    Int[] kfYData
    Int[] ifYData
    Int[] uvData
    Int[] angleData
    Int[] filterModeData
    Int[] filterIntraData
    Int[] skipData
    Int[] intrabcData
    Int[] deltaQData
    Int[] deltaLfData
    Int[] txSizeData
    Int[] cflSignData
    Int[] cflAlphaData
    Int[] txfmSplitData

