    // Partition: bsl 1..5 (8/16/32/64/128) -> the per-context CDFs, row widths
    // 5/11/11/11/9 (spec Default_Partition_W*_Cdf).
    Int[] partitionW(Int bsl, Int ctx) {
        if (bsl == 1) {
            return av1ModeCdfSlice(partitionData, ctx * 5, 5)
        }
        if (bsl == 2) {
            return av1ModeCdfSlice(partitionData, 20 + ctx * 11, 11)
        }
        if (bsl == 3) {
            return av1ModeCdfSlice(partitionData, 64 + ctx * 11, 11)
        }
        if (bsl == 4) {
            return av1ModeCdfSlice(partitionData, 108 + ctx * 11, 11)
        }
        return av1ModeCdfSlice(partitionData, 152 + ctx * 9, 9)
    }

    // Key-frame Y mode: kfY[ aboveCtx ][ leftCtx ], 5x5 contexts of 14 entries.
    Int[] kfY(Int aboveCtx, Int leftCtx) {
        return av1ModeCdfAt(kfYData, aboveCtx * 5 + leftCtx, 14)
    }

    // Intra-frame Y mode: ifY[ sizeGroup ], 4 groups of 14 entries.
    Int[] ifY(Int sizeGroup) {
        return av1ModeCdfAt(ifYData, sizeGroup, 14)
    }

    // UV mode: cfl-not-allowed rows are 14 entries; cfl-allowed rows 15 entries.
    Int[] uv(Int cflAllowed, Int mode) {
        if (cflAllowed == 0) {
            return av1ModeCdfSlice(uvData, mode * 14, 14)
        }
        return av1ModeCdfSlice(uvData, 182 + mode * 15, 15)
    }

    // Angle delta: 8 directional modes of 8 entries.
    Int[] angle(Int mode) {
        return av1ModeCdfAt(angleData, mode, 8)
    }

    // Filter-intra mode: one CDF of 6 entries.
    Int[] filterMode() {
        return av1ModeCdfAt(filterModeData, 0, 6)
    }

    // Filter-intra use: 22 block sizes of 3 entries.
    Int[] filterIntra(Int bs) {
        return av1ModeCdfAt(filterIntraData, bs, 3)
    }

    // Skip: 3 contexts of 3 entries.
    Int[] skip(Int ctx) {
        return av1ModeCdfSlice(skipData, ctx * 3, 3)
    }

    // Intra block copy: one CDF of 3 entries.
    Int[] intrabc() {
        return av1ModeCdfAt(intrabcData, 0, 3)
    }

    // Delta Q: one CDF of 5 entries.
    Int[] deltaQ() {
        return av1ModeCdfAt(deltaQData, 0, 5)
    }

    // Delta LF: one CDF of 5 entries.
    Int[] deltaLf() {
        return av1ModeCdfAt(deltaLfData, 0, 5)
    }

    // Tx size: cat 0 rows are 3 entries; cats 1..3 rows are 4 entries.
    Int[] txSize(Int cat, Int ctx) {
        if (cat == 0) {
            return av1ModeCdfSlice(txSizeData, ctx * 3, 3)
        }
        if (cat == 1) {
            return av1ModeCdfSlice(txSizeData, 9 + ctx * 4, 4)
        }
        if (cat == 2) {
            return av1ModeCdfSlice(txSizeData, 21 + ctx * 4, 4)
        }
        return av1ModeCdfSlice(txSizeData, 33 + ctx * 4, 4)
    }

    // CFL sign: one CDF of 9 entries.
    Int[] cflSign() {
        return av1ModeCdfAt(cflSignData, 0, 9)
    }

    // CFL alpha: 6 contexts of 17 entries.
    Int[] cflAlpha(Int ctx) {
        return av1ModeCdfAt(cflAlphaData, ctx, 17)
    }

    // Transform-partition split: 21 contexts of 3 entries.
    Int[] txfmSplit(Int ctx) {
        return av1ModeCdfAt(txfmSplitData, ctx, 3)
    }
}
