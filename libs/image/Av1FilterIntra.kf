package image

// kof.image — AV1 recursive filter-intra prediction (slice 3l of the AVIF front,
// plan §34). Implements the AV1 Bitstream & Decoding Process Specification
// §7.11.2.3 (recursive intra prediction process), the `use_filter_intra` face of
// §7.11.2 that the directional/base prediction does not cover.
//
// The five `filter_intra_mode` values each carry an `Intra_Filter_Taps` table
// (`FILTER_INTRA_MODES = 5`, `8` outputs per 4x2 block, `7` taps); each 4x2 block
// is predicted from the seven neighbouring samples p[0..6] (the above row to the
// left, the corner, and the left column), then `Clip1( Round2Signed( pr,
// INTRA_FILTER_SCALE_BITS ) )` with `INTRA_FILTER_SCALE_BITS = 4`. The taps are
// quoted verbatim from the spec additional tables and cross-checked against
// libaom's `av1_filter_intra_taps`.
//
// The process is inherently serial (each block reads the predicted samples of
// the block above/left), so the whole block is built in a local `(h+1) x (w+1)`
// buffer. Valid only for `w <= 32` and `h <= 32` (libaom asserts the same).
//
// Pure Kof, all targets: no I/O, no compiler change.

// `Intra_Filter_Taps[ mode ][ k ][ tap ]`, flattened `5*8*7`.
Int av1FilterIntraTap(Int mode, Int k, Int tap) {
    var base = listOf(
        listOf(-6, 10, 0, 0, 0, 12, 0),
        listOf(-5, 2, 10, 0, 0, 9, 0),
        listOf(-3, 1, 1, 10, 0, 7, 0),
        listOf(-3, 1, 1, 2, 10, 5, 0),
        listOf(-4, 6, 0, 0, 0, 2, 12),
        listOf(-3, 2, 6, 0, 0, 2, 9),
        listOf(-3, 2, 2, 6, 0, 2, 7),
        listOf(-3, 1, 2, 2, 6, 3, 5),
        listOf(-10, 16, 0, 0, 0, 10, 0),
        listOf(-6, 0, 16, 0, 0, 6, 0),
        listOf(-4, 0, 0, 16, 0, 4, 0),
        listOf(-2, 0, 0, 0, 16, 2, 0),
        listOf(-10, 16, 0, 0, 0, 0, 10),
        listOf(-6, 0, 16, 0, 0, 0, 6),
        listOf(-4, 0, 0, 16, 0, 0, 4),
        listOf(-2, 0, 0, 0, 16, 0, 2),
        listOf(-8, 8, 0, 0, 0, 16, 0),
        listOf(-8, 0, 8, 0, 0, 16, 0),
        listOf(-8, 0, 0, 8, 0, 16, 0),
        listOf(-8, 0, 0, 0, 8, 16, 0),
        listOf(-4, 4, 0, 0, 0, 0, 16),
        listOf(-4, 0, 4, 0, 0, 0, 16),
        listOf(-4, 0, 0, 4, 0, 0, 16),
        listOf(-4, 0, 0, 0, 4, 0, 16),
        listOf(-2, 8, 0, 0, 0, 10, 0),
        listOf(-1, 3, 8, 0, 0, 6, 0),
        listOf(-1, 2, 3, 8, 0, 4, 0),
        listOf(0, 1, 2, 3, 8, 2, 0),
        listOf(-1, 4, 0, 0, 0, 3, 10),
        listOf(-1, 3, 4, 0, 0, 4, 6),
        listOf(-1, 2, 3, 4, 0, 4, 4),
        listOf(-1, 2, 2, 3, 4, 3, 3),
        listOf(-12, 14, 0, 0, 0, 14, 0),
        listOf(-10, 0, 14, 0, 0, 12, 0),
        listOf(-9, 0, 0, 14, 0, 11, 0),
        listOf(-8, 0, 0, 0, 14, 10, 0),
        listOf(-10, 12, 0, 0, 0, 0, 14),
        listOf(-9, 1, 12, 0, 0, 0, 12),
        listOf(-8, 0, 0, 12, 0, 1, 11),
        listOf(-7, 0, 0, 1, 12, 1, 9)
    )
    return base.get(mode * 8 + k).get(tap)
}

// §7.11.2.3 recursive intra prediction. `above`/`left` are the raw edge arrays
// with `co` indexing `AboveRow[0]`/`LeftCol[0]`; `above[co-1]` is the corner.
// Returns the `w*h` prediction in raster order. `mode` is the
// `filter_intra_mode` (0..4).
Int[] av1FilterIntraPred(Int[] above, Int[] left, Int w, Int h, Int co, Int mode) {
    var stride = w + 1
    var buf = new Int[(h + 1) * stride]
    var c = 0
    while (c < w + 1) {
        buf[c] = above[co - 1 + c]
        c = c + 1
    }
    var i2 = 0
    var h2 = h >> 1
    var w4 = w >> 2
    while (i2 < h2) {
        var j4 = 0
        while (j4 < w4) {
            var p = new Int[7]
            var i = 0
            while (i < 7) {
                if (i < 5) {
                    if (i2 == 0) {
                        p[i] = above[co + (j4 << 2) + i - 1]
                    } else {
                        if (j4 == 0 && i == 0) {
                            p[i] = left[co + (i2 << 1) - 1]
                        } else {
                            p[i] = buf[(i2 << 1) * stride + (j4 << 2) + i]
                        }
                    }
                } else {
                    if (j4 == 0) {
                        p[i] = left[co + (i2 << 1) + i - 5]
                    } else {
                        p[i] = buf[((i2 << 1) + i - 4) * stride + (j4 << 2)]
                    }
                }
                i = i + 1
            }
            var i1 = 0
            while (i1 < 2) {
                var j1 = 0
                while (j1 < 4) {
                    var k = (i1 << 2) + j1
                    var pr = 0
                    var t = 0
                    while (t < 7) {
                        pr = pr + av1FilterIntraTap(mode, k, t) * p[t]
                        t = t + 1
                    }
                    var v = (pr + 8) >> 4
                    if (v < 0) {
                        v = 0
                    }
                    if (v > 255) {
                        v = 255
                    }
                    buf[(((i2 << 1) + i1) + 1) * stride + (j4 << 2) + j1 + 1] = v
                    j1 = j1 + 1
                }
                i1 = i1 + 1
            }
            j4 = j4 + 1
        }
        i2 = i2 + 1
    }
    var out = new Int[w * h]
    var r = 0
    while (r < h) {
        c = 0
        while (c < w) {
            out[r * w + c] = buf[(r + 1) * stride + c + 1]
            c = c + 1
        }
        r = r + 1
    }
    return out
}
