package image

import image.Av1Coeffs
import image.Av1CoeffPlane
import image.Av1Symbol
import image.Av1Tx

// AVIF slice 3y: the AV1 intra transform-block loop of `decode_token_recon_block`
// (`libs/image/Av1DecodeBlock.kf`), the frame-level glue between a decoded
// mode-info block and the slice-3x-edge coefficient plane driver.
//
// Governed by AV1 §5.11.4 (`decode_block`) / §5.11.3 and libaom's
// `decode_token_recon_block` intra branch (`av1/decoder/decodeframe.c:908`),
// which walks one plane's transform blocks in this exact order:
//
//   - `max_blocks_wide/high` are the block's 4x4-unit extents clamped to the
//     plane edge (libaom `max_block_wide`/`max_block_high`, `av1_common_int.h`).
//   - The block is chunked into `mu_blocks` units of `BLOCK_64X64` (16x16
//     4x4 units, `AOMMIN` with the block extent) so the per-plane subsampled
//     loop bounds never round a 64x64 chunk past the block.
//   - For each chunk the plane's unit bounds are
//     `ROUND_POWER_OF_TWO(AOMMIN(mu + row/col, max_blocks), subsampling)`.
//   - The transform blocks step by `tx_size_wide_unit`/`tx_size_high_unit`.
//
// `av1DecodeBlockGridOrder` returns that enumeration as a flat list of
// `(blk_row, blk_col)` pairs in decode order; `av1DecodeBlockGrid` drives the
// slice-3x-edge per-block decode over it (neighbour context, coefficient walk,
// context store) and returns the decoded signed coefficient arrays.
//
// Pure Kof, all targets: no I/O, no compiler change. Prediction, dequantization,
// inverse transform and reconstruction of the enumerated blocks are the next
// slice; this slice is the enumeration + coefficient read that libaom runs
// before `predict_and_recon_intra_block_visit`.

// `ROUND_POWER_OF_TWO(value, n)` (`aom_ports/mem.h`): the plane unit bound.
// `n == 0` (no subsampling) is the identity, matching the C macro.
Int av1RoundPow2(Int value, Int n) {
    if (n == 0) {
        return value
    }
    return (value + (1 << (n - 1))) >> n
}

// The `decode_token_recon_block` intra transform-block enumeration of ONE
// plane, in decode order. `txSz` is the plane's transform-size index, `ssX`/
// `ssY` the plane's chroma subsampling (0 for luma), `maxBlocksWide`/
// `maxBlocksHigh` the plane's block extents in 4x4 units (the caller derives
// them from `max_block_wide`/`max_block_high`).
//
// Returns a flat list of `(blk_row, blk_col)` pairs, length 2xN.
List<Int> av1DecodeBlockGridOrder(Int txSz, Int ssX, Int ssY,
                                  Int maxBlocksWide, Int maxBlocksHigh) {
    // mu_blocks: AOMMIN( max_blocks, mi_size_wide/high[BLOCK_64X64] = 16 ).
    var muW = maxBlocksWide
    if (muW > 16) {
        muW = 16
    }
    var muH = maxBlocksHigh
    if (muH > 16) {
        muH = 16
    }
    var stepc = av1TxWidth(txSz) >> 2
    var stepr = av1TxHeight(txSz) >> 2
    var out = listOf<Int>()
    var row = 0
    while (row < maxBlocksHigh) {
        var col = 0
        while (col < maxBlocksWide) {
            var hCap = muH + row
            if (hCap > maxBlocksHigh) {
                hCap = maxBlocksHigh
            }
            var unitH = av1RoundPow2(hCap, ssY)
            var wCap = muW + col
            if (wCap > maxBlocksWide) {
                wCap = maxBlocksWide
            }
            var unitW = av1RoundPow2(wCap, ssX)
            var br = row >> ssY
            while (br < unitH) {
                var bc = col >> ssX
                while (bc < unitW) {
                    out.add(br)
                    out.add(bc)
                    bc = bc + stepc
                }
                br = br + stepr
            }
            col = col + muW
        }
        row = row + muH
    }
    return out
}

// Decodes one plane's transform-block grid: enumerates the blocks with
// `av1DecodeBlockGridOrder` and runs the slice-3x-edge per-block decode
// (`av1DecodeCoeffsBlockEdge`: neighbour context -> slice-3e coefficient walk
// -> packed-context store, clamped to the plane edge) over each.
//
// Parameters mirror the slice-3x-edge driver plus the block geometry:
//   - `reader`: the symbol range decoder positioned at the first block.
//   - `store`: the tile's adapting coefficient CDF store.
//   - `planeBsize`: the plane residual block size index (`get_plane_block_size`).
//   - `plane`: 0 = luma, 1 = cb, 2 = cr.
//   - `txSz`, `txType`: the plane's transform size and type.
//   - `ssX`, `ssY`: the plane's chroma subsampling.
//   - `maxBlocksWide`/`maxBlocksHigh`: the LUMA block extents in 4x4 units
//     (`max_block_wide/high(xd, bsize, 0)`), which bound the chunk loop.
//   - `planeW`/`planeH`: the PLANE block extents in the plane's 4x4 units
//     (`max_block_wide/high(xd, plane_bsize, plane)`), the context-store clamp.
//   - `above`/`left`: the plane's above/left entropy-context arrays.
//
// Returns the decoded signed coefficient arrays, one per block in enumeration
// order, each sized `txw * txh` (the adjusted dimensions).
List<Int[]> av1DecodeBlockGrid(Av1Symbol reader, Av1CoeffCdfStore store,
                               Int planeBsize, Int plane,
                               Int txSz, Int txType, Int ssX, Int ssY,
                               Int maxBlocksWide, Int maxBlocksHigh,
                               Int planeW, Int planeH,
                               Int[] above, Int[] left) {
    var order = av1DecodeBlockGridOrder(txSz, ssX, ssY, maxBlocksWide, maxBlocksHigh)
    var out = listOf<Int[]>()
    var i = 0
    while (i < order.size) {
        var levels = av1DecodeCoeffsBlockEdge(reader, store, planeBsize, plane,
                order.get(i), order.get(i + 1), txSz, txType, above, left,
                planeW, planeH)
        out.add(levels)
        i = i + 2
    }
    return out
}
