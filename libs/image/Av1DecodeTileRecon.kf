package image

import image.Av1Block
import image.Av1CoeffPlane
import image.Av1Coeffs
import image.Av1DecodeBlock
import image.Av1DecodeChroma
import image.Av1IntraAvail
import image.Av1IntraBlock
import image.Av1ModeInfo
import image.Av1Palette
import image.Av1ReconBlock
import image.Av1Symbol
import image.Av1Tx
import image.Av1TxSize
import image.Av1TxType

// kof.image — AV1 intra TILE DRIVER (slice 3ag of the AVIF front, plan §34).
// The stage libaom runs for every block of a tile as `parse_decode_block`
// (`av1/decoder/decodeframe.c`): the mode info and the transform size are read,
// and THEN the SAME block's coefficients are decoded and predicted/reconstructed
// — before the next block. That interleaving is what this slice composes: slices
// 3af (mode info + tx size), 3e/3x (the coefficient walk) and 3z/3ae (the
// intra predict + inverse transform + reconstruct), driven from ONE shared
// entropy stream so each block sees the CDF adaptations and the reconstructed
// samples the previous blocks left behind.
//
// Per block `(r, c, bs)`, in libaom's order:
//
//   1. mode info  — prefix (segment id + skip, 3p), tail (CDEF/delta-Q/delta-LF,
//                   3r) and body (Y/UV mode, angles, CFL, palette, filter-intra, 3q);
//   2. transform size (3s) and the `set_txfm_ctxs` broadcast the NEXT block's
//      `get_tx_size_context` reads;
//   3. the block's transform blocks (3y enumeration), each: transform type
//      (3t `Av1TxType.readTxType`) -> coefficients (3e/3x
//      `av1DecodeCoeffsBlockEdge`) -> availability (3ab `av1IntraAvail`)
//      -> prediction (3u `av1IntraPredictBlock`) -> dequantize + inverse
//      transform + reconstruct (3z `av1ReconBlockInto`) with the DECODED
//      transform type.
//
// The per-block stage lives on `class Av1TileDecode` below (slice 3au), so the
// partition walk (`Av1Partition.bindDecoder`) can call it per leaf: libaom calls
// `decode_block` from INSIDE `decode_partition`, and with no closures in Kof the
// recursion and the block decode have to share one scope. `av1DecodeTileRecon`
// keeps its original 38-parameter signature as a thin wrapper over the class, so
// the harnesses that pass an explicit block list are unchanged.
//
// Pure Kof, all targets: no I/O, no compiler change. `decodeRaster` still
// refuses AVIF until the chain closes (chroma planes and the frame assembly).

// Decodes and reconstructs one luma plane of a tile.
//
//   - `frame`/`stride`: the plane buffer with its one-sample border (the
//     interior lives at `[1 .. frameW] x [1 .. frameH]`).
//   - `frameW`/`frameH`: the plane's extent in samples.
//   - `blocks`: a flat list of `(r, c, bs)` triples, one per mode-info block,
//     in decode order.
//   - `cfg`/`lossless`/`hasChroma`/`enableFilterIntra`/`palettePossible`/
//     `bitDepth`/`txMode`/`baseQIndex`/`segEnabled`/`segIdPreSkip`/
//     `lastActiveSegId`/`segSkipActive`: the frame-level mode-info state (3af).
//   - `dcQuant`/`acQuant`: the dequantization factors (slice 3f).
//   - `disableEdgeFilter`/`intraEdgeFilterType`: the intra edge filter controls.
//   - `reducedTxSet`: the frame-header `reduced_tx_set` flag (forces the
//     transform set of §5.9.2 to `TX_SET_INTRA_2`).
//   - `store`: the tile's adapting coefficient CDF store.
//   - `txTypeStore`/`txTypes`: the tile's adapting transform-type CDF store and
//     the frame's `TxTypes` map (4x4 units, `miW` columns — the same ALIGNED mi
//     grid every other mi-keyed array here uses), which the luma
//     `transform_type` read fills per transform block.
//   - `above`/`left`: the plane's entropy-context arrays (4x4 units); the
//     coefficient walk reads and updates them, so they must span the tile.
//   - `levelsOut`: receives each transform block's decoded signed coefficients,
//     in decode order (the caller-visible decode record).
//   - `txTypeOut`: receives each transform block's DECODED transform type, in
//     decode order (the caller-visible record of the `transform_type` reads).
//   - `modeOut`: receives each block's mode-info record, 17 ints per block in
//     the slice-3af layout (`skip, segId, cdef, qIndex, txSz, yMode, angleY,
//     uvMode, angleUV, cflU, cflV, useFilterIntra, filterIntraMode,
//     deltaLf0..3`).
//
// Returns the reconstructed plane, flat row-major of size `frameW * frameH`.

import image.Av1ModeCdf

// kof.image — the tile DECODER as a class (slice 3au).  The per-block stage
// used to be the body of `av1DecodeTileRecon`; it is now a method so the
// partition recursion (`Av1TileTree`, same file) can call it per leaf — the
// only way to stay in sync with libaom's interleaved tile stream, since Kof
// has no closures and a top-level function cannot be re-entered per block.
class Av1TileDecode {
    Int[] frame
    Int stride
    Int frameW
    Int frameH
    Int miW
    Int miH
    Av1ModeTail cfg
    Int lossless
    Int hasChroma
    Int numPlanes
    Int enableFilterIntra
    Int palettePossible
    Int bitDepth
    Int txMode
    Int baseQIndex
    Int segEnabled
    Int segIdPreSkip
    Int lastActiveSegId
    Int segSkipActive
    Int dcQuant
    Int acQuant
    Int disableEdgeFilter
    Int intraEdgeFilterType
    Int reducedTxSet
    Av1Symbol reader
    Av1CoeffCdfStore store
    Av1TxType txTypeStore
    Int[] txTypes
    Int[] above
    Int[] left
    List<Int[]> levelsOut
    List<Int> txTypeOut
    List<Int> modeOut
    List<Int> posOut
    // Per-TX-block prediction/reconstruction diagnostic (read via `predBlocks()`):
    // 7 ints per transform block — the global TX index, the mode block's `(r, c)`,
    // the TX block's pixel origin `(x, y)`, the predicted sample at that origin
    // and the reconstructed sample there after the residual. It pairs a
    // prediction with its own block without touching the reconstruction path.
    List<Int> predLog
    // Per-block STAGE reader positions (diagnostic, read via `stages()`):
    // two ints per block — the position after the mode-info BODY (Y/UV mode,
    // angles, CFL, palette MODE info, filter-intra) and after the palette
    // TOKENS, i.e. immediately before the transform size. Paired with
    // `positions()` (after the transform size, and after the residuals) it
    // shows which stage of one block eats the bits.
    List<Int> stagesOut
    // Per-block palette MODE info (diagnostic, read via `palInfos()`): two ints
    // per block — the decoded Y and UV palette sizes (0 = no palette).
    List<Int> palOut
    // Per-TRANSFORM-BLOCK end positions (diagnostic, read via `txEnds()`): the
    // reader position right after each transform block's coefficients, so a
    // symbol in the trace can be placed INSIDE one transform block's span
    // instead of being inferred from a window.
    List<Int> txEndOut
    // Per-block reader position at block ENTRY (diagnostic, read via
    // `blockStarts()`): one int per block, taken after the walk's partition
    // symbols and before the mode info, so the PARTITION cost of a block is
    // its entry minus the previous block's residual end.
    List<Int> blockStartOut
    Int[] colorIndexY
    Int[] colorIndexUv
    Av1ChromaPlanes chroma
    Int ssX
    Int ssY
    List<Int[]> levelsUOut
    List<Int> chromaPredOut
    List<Int[]> levelsVOut
    List<Int> txTypeUOut
    List<Int> txTypeVOut

    // Derived state, shared across the blocks of the tile.
    Av1ModeInfo modeInfo
    Av1TxSize txSize
    Int maxX
    Int maxY
    Bool edgeFilter
    List<Int> cur
    Int qIndex
    Int[] cdefUnits

    constructor(Int[] frame, Int stride, Int frameW, Int frameH,
                Av1ModeTail cfg, Int lossless, Int hasChroma, Int numPlanes,
                Int enableFilterIntra, Int palettePossible, Int bitDepth,
                Int txMode, Int baseQIndex, Int segEnabled,
                Int segIdPreSkip, Int lastActiveSegId, Int segSkipActive,
                Int dcQuant, Int acQuant, Int disableEdgeFilter,
                Int intraEdgeFilterType, Int reducedTxSet, Av1Symbol reader,
                Av1CoeffCdfStore store, Av1TxType txTypeStore,
                Int[] txTypes, Int[] above, Int[] left,
                List<Int[]> levelsOut, List<Int> txTypeOut,
                List<Int> modeOut, Av1ChromaPlanes chroma, Int ssX, Int ssY,
                List<Int[]> levelsUOut, List<Int[]> levelsVOut,
                List<Int> txTypeUOut, List<Int> txTypeVOut,
                List<Int> chromaPredOut) {
        this.frame = frame
        this.stride = stride
        this.frameW = frameW
        this.frameH = frameH
        this.cfg = cfg
        this.lossless = lossless
        this.hasChroma = hasChroma
        this.numPlanes = numPlanes
        this.enableFilterIntra = enableFilterIntra
        this.palettePossible = palettePossible
        this.bitDepth = bitDepth
        this.txMode = txMode
        this.baseQIndex = baseQIndex
        this.segEnabled = segEnabled
        this.segIdPreSkip = segIdPreSkip
        this.lastActiveSegId = lastActiveSegId
        this.segSkipActive = segSkipActive
        this.dcQuant = dcQuant
        this.acQuant = acQuant
        this.disableEdgeFilter = disableEdgeFilter
        this.intraEdgeFilterType = intraEdgeFilterType
        this.reducedTxSet = reducedTxSet
        this.reader = reader
        this.store = store
        this.txTypeStore = txTypeStore
        this.txTypes = txTypes
        this.above = above
        this.left = left
        this.levelsOut = levelsOut
        this.txTypeOut = txTypeOut
        this.modeOut = modeOut
        this.chroma = chroma
        this.ssX = ssX
        this.ssY = ssY
        this.levelsUOut = levelsUOut
        this.chromaPredOut = chromaPredOut
        this.levelsVOut = levelsVOut
        this.txTypeUOut = txTypeUOut
        this.txTypeVOut = txTypeVOut
        // The mi grid is the SPEC's `MiCols`/`MiRows` — the frame ROUNDED UP to
        // whole 8x8 luma blocks (`2 * ceil(w / 8)`), which is what libaom's
        // decoder derives (`dec_set_mb_mi`, av1/decoder/decoder.c) and what the
        // partition walk is handed. EVERY mi-keyed array below uses it — the
        // mode-info maps, the transform contexts, the CDEF units and the
        // transform-type map all key on the SAME grid, so a FLOOR here would
        // disagree with the walk's coordinates at the frame's edge.
        this.miW = 2 * ((this.frameW + 7) >> 3)
        this.miH = 2 * ((this.frameH + 7) >> 3)
        this.modeInfo = Av1ModeInfo(this.reader, this.miW, this.miH)
        this.txSize = Av1TxSize(this.reader, this.miW, this.miH)
        this.maxX = this.frameW
        this.maxY = this.frameH
        this.edgeFilter = true
        if (this.disableEdgeFilter == 1) {
            this.edgeFilter = false
        }
        this.cur = listOf(0, 0, 0, 0)
        this.qIndex = this.baseQIndex
        // Per-block reader positions (diagnostic): two ints per block,
        // the position after the mode info and after the block's residuals.
        this.posOut = listOf()
        this.predLog = listOf()
        this.stagesOut = listOf()
        this.palOut = listOf()
        this.txEndOut = listOf()
        this.blockStartOut = listOf()
        // The palette COLOUR-INDEX maps the `palette_tokens()` stage fills
        // (per pixel, per plane); the reconstruction reads them.
        this.colorIndexY = new Int[this.frameW * this.frameH]
        this.colorIndexUv = new Int[this.chroma.wU * this.chroma.hU]
        // The 64x64 CDEF-unit strengths, keyed by the unit origin (row*miCols+col).
        this.cdefUnits = new Int[this.miW * this.miH]
        var ci = 0
        while (ci < this.cdefUnits.size) {
            this.cdefUnits[ci] = -1
            ci = ci + 1
        }
    }

    // Decodes and reconstructs ONE mode-info block.  The body is the tile
    // driver's per-block stage verbatim (slices 3af/3t/3e/3z/3ab/3u); the
    // frame-level state lives in the fields, and the two accumulators that
    // evolve across blocks (`qIndex` from delta-Q, `cur` from delta-LF) are
    // written back at the end.
    void decodeBlock(Int r, Int c, Int bs) {
        // Diagnostic: the reader position at block ENTRY — i.e. after every
        // partition symbol the walk read for this leaf, before the mode info.
        this.blockStartOut.add(this.reader.position())
        var frame = this.frame
        var stride = this.stride
        var frameW = this.frameW
        var frameH = this.frameH
        var cfg = this.cfg
        var lossless = this.lossless
        var hasChroma = this.hasChroma
        var numPlanes = this.numPlanes
        var enableFilterIntra = this.enableFilterIntra
        var palettePossible = this.palettePossible
        var bitDepth = this.bitDepth
        var txMode = this.txMode
        var baseQIndex = this.baseQIndex
        var segEnabled = this.segEnabled
        var segIdPreSkip = this.segIdPreSkip
        var lastActiveSegId = this.lastActiveSegId
        var segSkipActive = this.segSkipActive
        var dcQuant = this.dcQuant
        var acQuant = this.acQuant
        var disableEdgeFilter = this.disableEdgeFilter
        var intraEdgeFilterType = this.intraEdgeFilterType
        var reducedTxSet = this.reducedTxSet
        var reader = this.reader
        var store = this.store
        var txTypeStore = this.txTypeStore
        var txTypes = this.txTypes
        var above = this.above
        var left = this.left
        var levelsOut = this.levelsOut
        var txTypeOut = this.txTypeOut
        var modeOut = this.modeOut
        var chroma = this.chroma
        var ssX = this.ssX
        var ssY = this.ssY
        var levelsUOut = this.levelsUOut
        var chromaPredOut = this.chromaPredOut
        var levelsVOut = this.levelsVOut
        var txTypeUOut = this.txTypeUOut
        var txTypeVOut = this.txTypeVOut
        var modeInfo = this.modeInfo
        var txSize = this.txSize
        var maxX = this.maxX
        var maxY = this.maxY
        var edgeFilter = this.edgeFilter
        var cur = this.cur
        var qIndex = this.qIndex
        var cdefUnits = this.cdefUnits

        // 1. Mode info: prefix (segment id + skip).
        var skip = 0
        var segId = 0
        if (segEnabled == 1) {
            var pre = modeInfo.readPrefix(r, c, segIdPreSkip, lastActiveSegId,
                                          segSkipActive)
            skip = pre[0]
            segId = pre[1]
        } else {
            skip = modeInfo.readSkip(r, c, 0, 0)
        }
        // Broadcast the flag/id over the block's 4x4 footprint (libaom aliases
        // the whole block to one `MB_MODE_INFO`).
        modeInfo.setSkipSeg(r, c, bs, skip, segId)

        // 1b. Tail: CDEF + delta-Q + delta-LF.
        var cdef = modeInfo.readCdef(r, c, bs, skip, cfg)
        var r0 = r - (r % 16)
        var c0 = c - (c % 16)
        var uidx = r0 * this.miW + c0
        if (cdef >= 0) {
            cdefUnits[uidx] = cdef
        }
        var deltaQ = modeInfo.readDeltaQ(r, c, bs, skip, cfg)
        qIndex = av1ModeInfoClip3(1, 255, qIndex + deltaQ)
        var deltaLf = modeInfo.readDeltaLf(r, c, bs, skip, cur, cfg)
        if (deltaLf.size > 0) {
            cur = deltaLf
        }

        // 1c. Body: Y/UV mode, angles, CFL, palette, filter-intra.
        var body = modeInfo.readBodyBd(r, c, bs, lossless, hasChroma,
                                       enableFilterIntra, palettePossible,
                                       bitDepth)
        var yMode = body[0]
        var angleY = body[1]
        var useFilterIntra = body[6]
        var filterIntraMode = body[7]
        this.stagesOut.add(this.reader.position())

        // 1d. `palette_tokens()`, BETWEEN the mode info and the transform size:
        // av1/decoder/decodeframe.c `parse_decode_block` runs `decode_mbmi_block(..)`
        // and then `av1_visit_palette(..., av1_decode_palette_tokens)` BEFORE the tx
        // size (the spec's `mode_info()` -> `palette_tokens()` -> `read_block_tx_size()`).
        var palY = modeInfo.palSizeYAt(r, c)
        if (palY > 0) {
            var pw = av1BlockWidth(bs)
            var ph = av1BlockHeight(bs)
            // The block may OVERHANG the frame (a HORZ partition at the bottom
            // edge keeps its full height), and libaom's palette map codes only
            // the WITHIN-BOUNDS cells: `av1_get_block_dimensions` (fetched,
            // av1/common/blockd.h) returns `block_rows = block_height +
            // (mi_rows - bh - mi_row) * 4` as the wavefront's `rows`/`cols`,
            // while the map's own width/height stay the FULL block — the cells
            // past the edge are then filled by the last-column/last-row copy.
            // The CODED extent is the aligned mi grid's: libaom's
            // `av1_get_block_dimensions` uses `(mi_rows - bh - mi_row) * 4`,
            // i.e. the 24px-aligned grid, NOT the 20px frame. The map's
            // wavefront and the tokens that follow (the chroma map shares the
            // reader) depend on it; clamping to the pixel frame desyncs the
            // stream (known-bugs §753). PAINTING stays inside the visible
            // frame, since the extra coded cells are off-screen.
            var hMax = ph
            var yBottom = this.miH * 4
            if (r * 4 + hMax > yBottom) { hMax = yBottom - r * 4 }
            var wMax = pw
            var yRight = this.miW * 4
            if (c * 4 + wMax > yRight) { wMax = yRight - c * 4 }
            var cmy = av1PaletteColorMap(reader, modeInfo, 0, palY, pw, ph, hMax, wMax)
            var paintH = hMax
            if (r * 4 + paintH > this.frameH) { paintH = this.frameH - r * 4 }
            var paintW = wMax
            if (c * 4 + paintW > this.frameW) { paintW = this.frameW - c * 4 }
            var pry = 0
            while (pry < paintH) {
                var pcy = 0
                while (pcy < paintW) {
                    this.colorIndexY[(r * 4 + pry) * this.frameW + (c * 4 + pcy)] = cmy[pry * pw + pcy]
                    pcy = pcy + 1
                }
                pry = pry + 1
            }
        }
        var palUv = modeInfo.palSizeUvAt(r, c)
        this.palOut.add(palY)
        this.palOut.add(palUv)
        if (palUv > 0) {
            var pbs = av1PlaneBlockSize(bs, this.ssX, this.ssY)
            var puw = av1BlockWidth(pbs)
            var puh = av1BlockHeight(pbs)
            var u0r = r >> this.ssY
            var u0c = c >> this.ssX
            // Same within-bounds rule as the luma map, on the chroma plane.
            // Same rule on the chroma plane: the coded extent is the aligned
            // mi grid subsampled, the painted extent the visible plane.
            var uhMax = puh
            var uBottom = (this.miH * 4) >> this.ssY
            if (u0r * 4 + uhMax > uBottom) { uhMax = uBottom - u0r * 4 }
            var uwMax = puw
            var uRight = (this.miW * 4) >> this.ssX
            if (u0c * 4 + uwMax > uRight) { uwMax = uRight - u0c * 4 }
            var cmu = av1PaletteColorMap(reader, modeInfo, 1, palUv, puw, puh, uhMax, uwMax)
            var paintHu = uhMax
            if (u0r * 4 + paintHu > this.chroma.hU) { paintHu = this.chroma.hU - u0r * 4 }
            var paintWu = uwMax
            if (u0c * 4 + paintWu > this.chroma.wU) { paintWu = this.chroma.wU - u0c * 4 }
            var pru = 0
            while (pru < paintHu) {
                var pcu = 0
                while (pcu < paintWu) {
                    this.colorIndexUv[(u0r * 4 + pru) * this.chroma.wU + (u0c * 4 + pcu)] = cmu[pru * puw + pcu]
                    pcu = pcu + 1
                }
                pru = pru + 1
            }
        }

        this.stagesOut.add(this.reader.position())

        // 2. Transform size + the transform-context broadcast.
        var txSz = txSize.readTxSize(r, c, bs, skip, txMode, 0, lossless)
        txSize.setTxfmCtxs(r, c, bs, txSz, 0)
        this.posOut.add(this.reader.position())

        modeOut.add(skip)
        modeOut.add(segId)
        modeOut.add(cdefUnits[uidx])
        modeOut.add(qIndex)
        modeOut.add(txSz)
        modeOut.add(body[0])
        modeOut.add(body[1])
        modeOut.add(body[2])
        modeOut.add(body[3])
        modeOut.add(body[4])
        modeOut.add(body[5])
        modeOut.add(body[6])
        modeOut.add(body[7])
        var lk = 0
        while (lk < 4) {
            var lv = 0
            if (lk < deltaLf.size) {
                lv = deltaLf.get(lk)
            }
            modeOut.add(lv)
            lk = lk + 1
        }

        // 3. The block's transform blocks, interleaved decode -> predict -> recon.
        var bw = av1BlockNum4x4Wide(bs)
        var bh = av1BlockNum4x4High(bs)
        var order = av1DecodeBlockGridOrder(txSz, 0, 0, bw, bh)
        var w = av1TxWidth(txSz)
        var h = av1TxHeight(txSz)
        var n = order.size / 2
        // A palette plane carries the INDEX MAP instead of transform coefficients
        // (av1_decode_palette_tokens already consumed them), so the TX loop is empty.
        if (palY > 0) {
            n = 0
        }
        var bi = 0
        while (bi < n) {
            var br = r + order.get(bi * 2)
            var bc = c + order.get(bi * 2 + 1)
            var x = bc << 2
            var y = br << 2
            var haveTop = 0
            if (br != 0) {
                haveTop = 1
            }
            var haveLeft = 0
            if (bc != 0) {
                haveLeft = 1
            }

            // 3a. Coefficients (3e/3x), in libaom's `av1_read_coeffs_txb` ORDER:
            //     the `all_zero` flag FIRST, then — only when it is 0 — the luma
            //     `transform_type` (slice 3t), then the level walk. The order is
            //     load-bearing: the type symbol sits BETWEEN the two.
            var levels = av1DecodeCoeffsBlockEdgeTx(reader, store, bs, 0,
                    br, bc, txSz, above, left, 0, 0, txTypeStore,
                    reducedTxSet, qIndex, yMode, useFilterIntra,
                    filterIntraMode, txTypes, this.miW, bc, br)
            var txType = txTypes[br * this.miW + bc]
            levelsOut.add(levels)
            txTypeOut.add(txType)
            this.txEndOut.add(this.reader.position())

            // 3c. Availability (3ab) from the transform block's ABSOLUTE position.
            var avail = av1IntraAvail(12, bs, 0, txSz, 0, 0,
                    order.get(bi * 2), order.get(bi * 2 + 1), yMode,
                    angleY, useFilterIntra, haveTop, haveLeft, br, bc,
                    this.miW, this.miH, frameW, frameH)
            var haveAboveRight = avail[0]
            var haveBelowLeft = avail[1]

            // 3d. Prediction (3u) with THIS block's mode.
            var pred = av1IntraPredictBlock(frame, stride, x + 1, y + 1, w, h,
                                            maxX, maxY,
                                            haveLeft, haveTop, haveAboveRight,
                                            haveBelowLeft, yMode, angleY,
                                            useFilterIntra, filterIntraMode,
                                            bitDepth, intraEdgeFilterType, edgeFilter)

            // 3e. Dequantize + inverse transform + reconstruct (3z). CLIPPED:
            // this block may overhang the frame (a HORZ partition at the bottom
            // edge keeps its full height), and the cells past the frame have no
            // place in a frame-sized plane.
            av1ReconBlockIntoClip(frame, stride, this.frameW, this.frameH,
                                  x + 1, y + 1, levels, pred, txSz,
                                  txType, bitDepth, false, dcQuant, acQuant)

            // Diagnostic: pair this transform block's PREDICTION with its
            // RECONSTRUCTION at the block's own origin (post-residual).
            predLog.add(this.levelsOut.size - 1)
            predLog.add(r)
            predLog.add(c)
            predLog.add(x)
            predLog.add(y)
            predLog.add(pred[0])
            predLog.add(frame[(y + 1) * stride + (x + 1)])

            bi = bi + 1
        }

        // 3b. The PALETTE reconstruction: each pixel takes the block's palette
        //     colour indexed by the decoded colour map — no prediction, no
        //     dequantization, no inverse transform.
        if (palY > 0) {
            var pbh = av1BlockHeight(bs)
            var pbw = av1BlockWidth(bs)
            // The block may OVERHANG the frame (see `clampedWidth`): only the
            // cells that exist are painted, which is also what keeps the colour
            // MAP read inside its frame-sized array.
            if (r * 4 + pbh > this.frameH) { pbh = this.frameH - r * 4 }
            if (c * 4 + pbw > this.frameW) { pbw = this.frameW - c * 4 }
            var pyy = 0
            while (pyy < pbh) {
                var pxx = 0
                while (pxx < pbw) {
                    var pidx = this.colorIndexY[(r * 4 + pyy) * this.frameW + (c * 4 + pxx)]
                    frame[(r * 4 + pyy + 1) * stride + (c * 4 + pxx + 1)] = modeInfo.palColorYAt(r, c, pidx)
                    pxx = pxx + 1
                }
                pyy = pyy + 1
            }
        }

        // 3c. The UV palette, once, for BOTH chroma planes (the UV colour map is
        //     shared; av1_decode_palette_tokens takes plane 1 only).
        if (palUv > 0) {
            var pbs2 = av1PlaneBlockSize(bs, ssX, ssY)
            var puw2 = av1BlockWidth(pbs2)
            var puh2 = av1BlockHeight(pbs2)
            var u0r2 = r >> ssY
            var u0c2 = c >> ssX
            if (u0r2 * 4 + puh2 > chroma.hU) { puh2 = chroma.hU - u0r2 * 4 }
            if (u0c2 * 4 + puw2 > chroma.wU) { puw2 = chroma.wU - u0c2 * 4 }
            var puy = 0
            while (puy < puh2) {
                var pux = 0
                while (pux < puw2) {
                    var pidx2 = this.colorIndexUv[(u0r2 * 4 + puy) * chroma.wU + (u0c2 * 4 + pux)]
                    chroma.u[(u0r2 * 4 + puy + 1) * chroma.strideU + (u0c2 * 4 + pux + 1)] = modeInfo.palColorUAt(r, c, pidx2)
                    chroma.v[(u0r2 * 4 + puy + 1) * chroma.strideV + (u0c2 * 4 + pux + 1)] = modeInfo.palColorVAt(r, c, pidx2)
                    pux = pux + 1
                }
                puy = puy + 1
            }
        }

        // 4. The CHROMA planes of THIS block, after its luma plane — libaom's
        //    `decode_token_recon_block` runs `plane = 0` then U then V for the
        //    same block, each with its own derived transform size and its own
        //    entropy-context arrays. Chroma is decoded only when the block is a
        //    chroma reference (`xd->is_chroma_ref`).
        // `av1_num_planes(cm)`: a luma-only stream has no chroma symbols to
        // consume, so the chroma walk runs only for a multi-plane frame.
        if (numPlanes > 1 && hasChroma == 1 && palUv == 0) {
            av1DecodeChromaBlock(chroma, bs, ssX, ssY, frame, stride,
                    r, c, body[2], body[3], body[4], body[5],
                    useFilterIntra, filterIntraMode, bitDepth,
                    intraEdgeFilterType, edgeFilter, dcQuant, acQuant, qIndex,
                    reducedTxSet, lossless, reader, store, txTypeStore, txTypes,
                    this.miW, frameW, frameH, levelsUOut, levelsVOut,
                    txTypeUOut, txTypeVOut, chromaPredOut)
        }
        this.posOut.add(this.reader.position())
        this.qIndex = qIndex
        this.cur = cur
    }

    // Decodes the tile's blocks in the order given, sharing every field.
    void run(List<Int> blocks) {
        var nb = blocks.size / 3
        var b = 0
        while (b < nb) {
            var base = b * 3
            this.decodeBlock(blocks.get(base), blocks.get(base + 1),
                             blocks.get(base + 2))
            b = b + 1
        }
    }

    // The per-block reader positions (diagnostic), two ints per block.
    List<Int> positions() {
        return this.posOut
    }

    // The per-mi SKIP grid and the per-64x64 CDEF configuration index, the two
    // inputs `av1_cdef_compute_sb_list` and `cdef_fb_col` read. Exposed so the
    // CDEF integration never re-derives state the tile walk already owns.
    Int[] skipMap() {
        return this.modeInfo.skipMap
    }

    Int[] cdefMap() {
        return this.modeInfo.cdefMap
    }

    // The mi grid's width (the aligned one the maps are indexed with).
    Int miCols() {
        return this.miW
    }

    // The palette COLOUR TABLE of a block (diagnostic): `palColorYAt` indexed by
    // the decoded map value. Paired with `palIndexAt` it settles whether a wrong
    // paint comes from the COLOURS or from the INDICES.
    Int palColorAt(Int r, Int c, Int i) {
        return this.modeInfo.palColorYAt(r, c, i)
    }

    // The decoded palette INDEX at a pixel of the block (diagnostic).
    Int palIndexAt(Int r, Int c, Int k) {
        return this.colorIndexY[(r * 4) * this.frameW + (c * 4 + k)]
    }

    // The per-block Y-MODE span (diagnostic), three ints per block.
    List<Int> ySpans() {
        return this.modeInfo.ySpans()
    }

    // The per-block BODY field positions (diagnostic), four ints per block:
    // after the Y mode, the Y angle group, the UV/CFL/UV-angle group PLUS the
    // palette MODE info, and the filter-intra field (the end of the body).
    List<Int> bodyFields() {
        return this.modeInfo.bodyPositions()
    }

    // The per-block reader position at block ENTRY (diagnostic), one int per
    // block: after the walk's partition symbols, before the mode info.
    List<Int> blockStarts() {
        return this.blockStartOut
    }

    // The per-TRANSFORM-BLOCK end positions (diagnostic), one int per transform
    // block: the reader position right after its coefficients.
    List<Int> txEnds() {
        return this.txEndOut
    }

    // The per-block palette MODE info (diagnostic), 2 ints per block: the Y and
    // UV palette sizes (0 = no palette).
    List<Int> palInfos() {
        return this.palOut
    }

    // The per-block STAGE reader positions (diagnostic), 2 ints per block: after
    // the mode-info body and after the palette tokens (before the tx size).
    List<Int> stages() {
        return this.stagesOut
    }

    // The per-TX-block prediction/reconstruction record (diagnostic), 7 ints per
    // transform block: TX index, mode-block `(r, c)`, TX pixel origin `(x, y)`,
    // the predicted sample at the origin, and the reconstructed sample there
    // after the residual.
    List<Int> predBlocks() {
        return this.predLog
    }

    // The reconstructed plane, flat row-major of size `frameW * frameH`
    // (the one-sample border stripped).
    Int[] planes() {
        var frame = this.frame
        var stride = this.stride
        var frameW = this.frameW
        var frameH = this.frameH
        var out = new Int[frameW * frameH]
        var rr = 0
        while (rr < frameH) {
            var cc = 0
            while (cc < frameW) {
                out[rr * frameW + cc] = frame[(rr + 1) * stride + (cc + 1)]
                cc = cc + 1
            }
            rr = rr + 1
        }
        return out
    }
}

// Decodes and reconstructs one luma plane of a tile from an EXPLICIT block
// list.  Thin wrapper over `Av1TileDecode`, kept at the original signature so
// the tile-driver harnesses are unchanged; `Av1TileTree` drives the same class
// from the partition tree instead.
Int[] av1DecodeTileRecon(Int[] frame, Int stride, Int frameW, Int frameH,
                         List<Int> blocks, Av1ModeTail cfg,
                         Int lossless, Int hasChroma, Int numPlanes,
                         Int enableFilterIntra,
                         Int palettePossible, Int bitDepth, Int txMode,
                         Int baseQIndex, Int segEnabled,
                         Int segIdPreSkip, Int lastActiveSegId,
                         Int segSkipActive, Int dcQuant, Int acQuant,
                         Int disableEdgeFilter, Int intraEdgeFilterType,
                         Int reducedTxSet,
                         Av1Symbol reader, Av1CoeffCdfStore store,
                         Av1TxType txTypeStore, Int[] txTypes,
                         Int[] above, Int[] left, List<Int[]> levelsOut,
                         List<Int> txTypeOut, List<Int> modeOut,
                         Av1ChromaPlanes chroma, Int ssX, Int ssY,
                         List<Int[]> levelsUOut, List<Int[]> levelsVOut,
                         List<Int> txTypeUOut, List<Int> txTypeVOut) {
    var tile = Av1TileDecode(frame, stride, frameW, frameH, cfg, lossless, hasChroma, numPlanes,
        enableFilterIntra, palettePossible, bitDepth, txMode, baseQIndex, segEnabled,
        segIdPreSkip, lastActiveSegId, segSkipActive, dcQuant, acQuant, disableEdgeFilter,
        intraEdgeFilterType, reducedTxSet, reader, store, txTypeStore, txTypes, above, left,
        levelsOut, txTypeOut, modeOut, chroma, ssX, ssY, levelsUOut, levelsVOut, txTypeUOut,
        txTypeVOut, listOf())
    tile.run(blocks)
    return tile.planes()
}
