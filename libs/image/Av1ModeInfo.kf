package image

import image.Av1Block
import image.Av1ModeCdf
import image.Av1Symbol

// kof.image — AV1 intra mode-info prefix, slice 3p of the AVIF front (plan §34).
// The first two syntax elements `intra_frame_mode_info` reads after the
// partition walk of slice 3o: the segment id (§5.11.8 `read_segment_id`,
// including the `neg_deinterleave` postprocess) and the skip flag (§5.11.11
// `read_skip`), in the spec order (`SegIdPreSkip` decides which comes first).
//
// The spatial segment predictor/context is libaom's `av1_get_spatial_seg_pred`
// (`prevUL`/`prevU`/`prevL` from the 4x4 segment map, `cdf_index` 0/1/2) and the
// skip context is the spec's `Skips[MiRow-1][MiCol] + Skips[MiRow][MiCol-1]`
// (libaom `av1_get_skip_txfm_context`). Both CDFs are the slice-3m defaults
// (now including the segment tables) adapted in place per tile.
//
// Pure arithmetic, no `kof.io`, so it runs on every target. `decodeRaster`
// keeps refusing AVIF until the chain closes.

// The frame-level state `read_cdef`/`read_delta_qindex`/`read_delta_lf` consume
// (slice 3r): the superblock size (`BLOCK_64X64` = 12 or `BLOCK_128X128` = 15),
// the number of CDEF strength bits, and the quantizer / loop-filter delta
// parameters from `delta_q_params`/`delta_lf_params` (§5.9.12/§5.9.13) with the
// `CodedLossless` flag (when true the whole tail is skipped).
record Av1ModeTail(Int sbSize, Int cdefBits, Int enableCdef, Int codedLossless,
                   Int deltaQPresent, Int deltaQRes, Int deltaLfPresent,
                   Int deltaLfMulti, Int deltaLfRes, Int numPlanes)

// Clip3( low, high, x ).
Int av1ModeInfoClip3(Int lo, Int hi, Int x) {
    if (x < lo) {
        return lo
    }
    if (x > hi) {
        return hi
    }
    return x
}

// libaom `av1_neg_deinterleave` (spec §5.11.8 `neg_deinterleave`): maps the
// coded symbol back to the segment id, centred on the spatial predictor.
Int av1NegDeinterleave(Int diff, Int ref, Int max) {
    if (ref == 0) {
        return diff
    }
    if (ref >= (max - 1)) {
        return max - diff - 1
    }
    if (2 * ref < max) {
        if (diff <= 2 * ref) {
            if ((diff & 1) == 1) {
                return ref + ((diff + 1) >> 1)
            }
            return ref - (diff >> 1)
        }
        return diff
    }
    if (diff <= 2 * (max - ref - 1)) {
        if ((diff & 1) == 1) {
            return ref + ((diff + 1) >> 1)
        }
        return ref - (diff >> 1)
    }
    return max - (diff + 1)
}

// §9 parsing process: the segment-id CDF context (0/1/2).
Int av1SegIdCtx(Int prevUl, Int prevU, Int prevL) {
    if (prevUl < 0) {
        return 0
    }
    if (prevUl == prevU && prevUl == prevL) {
        return 2
    }
    if (prevUl == prevU || prevUl == prevL || prevU == prevL) {
        return 1
    }
    return 0
}

// libaom `av1_get_spatial_seg_pred`: the spatial segment predictor.
Int av1SegIdPred(Int prevUl, Int prevU, Int prevL) {
    if (prevU < 0) {
        if (prevL < 0) {
            return 0
        }
        return prevL
    }
    if (prevL < 0) {
        return prevU
    }
    if (prevUl == prevU) {
        return prevU
    }
    return prevL
}

// The spec `Intra_Mode_Context[ INTRA_MODES ]` (libaom `intra_mode_context`).
List<Int> av1IntraModeContext() {
    return listOf(0, 1, 2, 3, 4, 4, 4, 4, 3, 0, 1, 2, 0)
}

// `is_directional_mode( mode )`: V_PRED (1) .. D67_PRED (8).
Int av1IsDirectionalMode(Int mode) {
    if (mode >= 1 && mode <= 8) {
        return 1
    }
    return 0
}

// Max( Block_Width[ bs ], Block_Height[ bs ] ).
Int av1ModeInfoMaxDim(Int bs) {
    var w = av1BlockWidth(bs)
    var h = av1BlockHeight(bs)
    if (h > w) {
        return h
    }
    return w
}

// CeilLog2( x ) for x >= 1 (spec `CeilLog2`; 0 for x <= 1). Used by the palette
// delta-bit narrowing `paletteBits = Min( paletteBits, CeilLog2( range ) )`.
Int av1CeilLog2(Int x) {
    var n = 0
    var v = 1
    while (v < x) {
        v = v * 2
        n = n + 1
    }
    return n
}

// `get_palette_cache( plane )` (spec §5.11.8 palette_mode_info): merges the
// above and left palettes (each already sorted ascending) into `out`, dropping
// duplicates. The above palette is only consulted when the current MI is not on
// a 64-sample superblock-row boundary (`( MiRow * MI_SIZE ) % 64`, i.e. MI row
// multiple of 16); the left palette when `c > 0`. Returns the number of cached
// colors. `sizeMap` holds the per-MI palette size, `colorMap` the per-MI sorted
// colors (`mi * 8 + i`).
Int av1GetPaletteCache(Int[] sizeMap, Int[] colorMap, Int r, Int c, Int miCols,
                       Int[] out) {
    var aboveN = 0
    if (r % 16 != 0) {
        aboveN = sizeMap[(r - 1) * miCols + c]
    }
    var leftN = 0
    if (c > 0) {
        leftN = sizeMap[r * miCols + (c - 1)]
    }
    var aboveIdx = 0
    var leftIdx = 0
    var n = 0
    while (aboveIdx < aboveN && leftIdx < leftN) {
        var aboveC = colorMap[((r - 1) * miCols + c) * 8 + aboveIdx]
        var leftC = colorMap[(r * miCols + (c - 1)) * 8 + leftIdx]
        if (leftC < aboveC) {
            if (n == 0 || leftC != out[n - 1]) {
                out[n] = leftC
                n = n + 1
            }
            leftIdx = leftIdx + 1
        } else {
            if (n == 0 || aboveC != out[n - 1]) {
                out[n] = aboveC
                n = n + 1
            }
            aboveIdx = aboveIdx + 1
            if (leftC == aboveC) {
                leftIdx = leftIdx + 1
            }
        }
    }
    while (aboveIdx < aboveN) {
        var pv = colorMap[((r - 1) * miCols + c) * 8 + aboveIdx]
        aboveIdx = aboveIdx + 1
        if (n == 0 || pv != out[n - 1]) {
            out[n] = pv
            n = n + 1
        }
    }
    while (leftIdx < leftN) {
        var pv2 = colorMap[(r * miCols + (c - 1)) * 8 + leftIdx]
        leftIdx = leftIdx + 1
        if (n == 0 || pv2 != out[n - 1]) {
            out[n] = pv2
            n = n + 1
        }
    }
    return n
}

// Ascending insertion sort of `a[0..n-1]` (spec `sort( arr, 0, n-1 )`).
void av1PaletteSort(Int[] a, Int n) {
    var i = 1
    while (i < n) {
        var key = a[i]
        var j = i - 1
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j]
            j = j - 1
        }
        a[j + 1] = key
        i = i + 1
    }
}

// Clip1( x ) for the given bit depth.
Int av1PaletteClip1(Int x, Int bitDepth) {
    var hi = (1 << bitDepth) - 1
    if (x < 0) {
        return 0
    }
    if (x > hi) {
        return hi
    }
    return x
}

class Av1ModeInfo {
    Av1Symbol sym
    Av1ModeCdf modes
    Int miCols
    Int miRows
    Int[] segMap
    Int[] skipMap
    Int[] yModeMap
    Int[] uvModeMap
    Int[] cdefMap
    Int[] palSizeYMap
    Int[] palSizeUvMap
    Int[] palColorYMap
    Int[] palColorUMap
    Int[] palColorVMap
    List<Int[]> segStore
    List<Int[]> skipStore
    List<Int[]> kfYStore
    List<Int[]> uvStore
    List<Int[]> angleStore
    List<Int[]> filterIntraStore
    Int[] filterModeStore
    Int[] cflSignStore
    List<Int[]> cflAlphaStore
    Int[] deltaQStore
    List<Int[]> deltaLfStore
    List<Int[]> palYModeStore
    List<Int[]> palYSizeStore
    List<Int[]> palUvModeStore
    List<Int[]> palUvSizeStore
    List<Int[]> steps

    constructor(Int[] data, Int miCols, Int miRows) {
        this.sym = Av1Symbol(data)
        this.modes = Av1ModeCdf()
        this.miCols = miCols
        this.miRows = miRows
        this.segMap = new Int[miCols * miRows]
        this.skipMap = new Int[miCols * miRows]
        this.yModeMap = new Int[miCols * miRows]
        this.uvModeMap = new Int[miCols * miRows]
        this.cdefMap = new Int[miCols * miRows]
        var ci = 0
        while (ci < this.cdefMap.size) {
            this.cdefMap[ci] = -1
            ci = ci + 1
        }
        this.palSizeYMap = new Int[miCols * miRows]
        this.palSizeUvMap = new Int[miCols * miRows]
        this.palColorYMap = new Int[miCols * miRows * 8]
        this.palColorUMap = new Int[miCols * miRows * 8]
        this.palColorVMap = new Int[miCols * miRows * 8]
        this.segStore = listOf()
        this.skipStore = listOf()
        var i = 0
        while (i < 3) {
            this.segStore.add(this.modes.segmentId(i))
            this.skipStore.add(this.modes.skip(i))
            i = i + 1
        }
        this.kfYStore = listOf()
        i = 0
        while (i < 25) {
            this.kfYStore.add(this.modes.kfY(i / 5, i % 5))
            i = i + 1
        }
        this.uvStore = listOf()
        i = 0
        while (i < 26) {
            if (i < 13) {
                this.uvStore.add(this.modes.uv(0, i))
            } else {
                this.uvStore.add(this.modes.uv(1, i - 13))
            }
            i = i + 1
        }
        this.angleStore = listOf()
        i = 0
        while (i < 8) {
            this.angleStore.add(this.modes.angle(i))
            i = i + 1
        }
        this.filterIntraStore = listOf()
        i = 0
        while (i < 22) {
            this.filterIntraStore.add(this.modes.filterIntra(i))
            i = i + 1
        }
        this.filterModeStore = this.modes.filterMode()
        this.cflSignStore = this.modes.cflSign()
        this.cflAlphaStore = listOf()
        i = 0
        while (i < 6) {
            this.cflAlphaStore.add(this.modes.cflAlpha(i))
            i = i + 1
        }
        this.deltaQStore = this.modes.deltaQ()
        this.deltaLfStore = listOf()
        i = 0
        while (i < 4) {
            this.deltaLfStore.add(this.modes.deltaLf())
            i = i + 1
        }
        this.palYModeStore = listOf()
        i = 0
        while (i < 21) {
            this.palYModeStore.add(this.modes.paletteYMode(i / 3, i % 3))
            i = i + 1
        }
        this.palYSizeStore = listOf()
        i = 0
        while (i < 7) {
            this.palYSizeStore.add(this.modes.paletteYSize(i))
            i = i + 1
        }
        this.palUvModeStore = listOf()
        i = 0
        while (i < 2) {
            this.palUvModeStore.add(this.modes.paletteUvMode(i))
            i = i + 1
        }
        this.palUvSizeStore = listOf()
        i = 0
        while (i < 7) {
            this.palUvSizeStore.add(this.modes.paletteUvSize(i))
            i = i + 1
        }
        this.steps = listOf()
    }

    Int yModeAt(Int r, Int c) {
        if (r < 0 || c < 0) {
            return 0
        }
        return this.yModeMap[r * this.miCols + c]
    }

    Int uvModeAt(Int r, Int c) {
        if (r < 0 || c < 0) {
            return 0
        }
        return this.uvModeMap[r * this.miCols + c]
    }

    void setModes(Int r, Int c, Int bs, Int yMode, Int uvMode) {
        var bw = av1BlockNum4x4Wide(bs)
        var bh = av1BlockNum4x4High(bs)
        var i = 0
        while (i < bh) {
            var j = 0
            while (j < bw) {
                this.yModeMap[(r + i) * this.miCols + (c + j)] = yMode
                this.uvModeMap[(r + i) * this.miCols + (c + j)] = uvMode
                j = j + 1
            }
            i = i + 1
        }
    }

    Int palSizeYAt(Int r, Int c) {
        return this.palSizeYMap[r * this.miCols + c]
    }

    Int palSizeUvAt(Int r, Int c) {
        return this.palSizeUvMap[r * this.miCols + c]
    }

    Int palColorYAt(Int r, Int c, Int i) {
        return this.palColorYMap[(r * this.miCols + c) * 8 + i]
    }

    Int palColorUAt(Int r, Int c, Int i) {
        return this.palColorUMap[(r * this.miCols + c) * 8 + i]
    }

    Int palColorVAt(Int r, Int c, Int i) {
        return this.palColorVMap[(r * this.miCols + c) * 8 + i]
    }

    // `read_palette_colors_y` + `palette_size_y_minus_2` + `has_palette_y`
    // (§5.11.8 `palette_mode_info`): reads the Y palette size and colors, stores
    // them over the block's MI grid and returns the size (0 when no palette).
    Int readPaletteY(Int r, Int c, Int bs, Int bitDepth) {
        var bsizeCtx = av1BlockNumPelsLog2(bs) - 6
        var ctx = 0
        if (r % 16 != 0 && this.palSizeYMap[(r - 1) * this.miCols + c] > 0) {
            ctx = ctx + 1
        }
        if (c > 0 && this.palSizeYMap[r * this.miCols + (c - 1)] > 0) {
            ctx = ctx + 1
        }
        var modev = this.sym.readSymbol(this.palYModeStore.get(bsizeCtx * 3 + ctx), 2)
        if (modev == 0) {
            return 0
        }
        var n = this.sym.readSymbol(this.palYSizeStore.get(bsizeCtx), 7) + 2
        var cache = new Int[16]
        var cacheN = av1GetPaletteCache(this.palSizeYMap, this.palColorYMap,
                                        r, c, this.miCols, cache)
        var colors = new Int[8]
        var idx = 0
        var i = 0
        while (i < cacheN && idx < n) {
            if (this.sym.readBool() == 1) {
                colors[idx] = cache[i]
                idx = idx + 1
            }
            i = i + 1
        }
        if (idx < n) {
            colors[idx] = this.sym.readLiteral(bitDepth)
            idx = idx + 1
        }
        if (idx < n) {
            var bits = (bitDepth - 3) + this.sym.readLiteral(2)
            var range = (1 << bitDepth) - colors[idx - 1] - 1
            while (idx < n) {
                var delta = this.sym.readLiteral(bits) + 1
                colors[idx] = av1PaletteClip1(colors[idx - 1] + delta, bitDepth)
                range = range - (colors[idx] - colors[idx - 1])
                var cbits = av1CeilLog2(range)
                if (cbits < bits) {
                    bits = cbits
                }
                idx = idx + 1
            }
        }
        av1PaletteSort(colors, n)
        this.storePalette(this.palSizeYMap, this.palColorYMap, r, c, bs, n, colors)
        return n
    }

    // `read_palette_colors_uv` + the UV size/mode symbols (§5.11.8). Reads the
    // U palette and the V palette (delta-encoded or literal), stores them and
    // returns the UV palette size (0 when none).
    Int readPaletteUv(Int r, Int c, Int bs, Int bitDepth) {
        var bsizeCtx = av1BlockNumPelsLog2(bs) - 6
        var ctx = 0
        if (this.palSizeYMap[r * this.miCols + c] > 0) {
            ctx = 1
        }
        var modev = this.sym.readSymbol(this.palUvModeStore.get(ctx), 2)
        if (modev == 0) {
            return 0
        }
        var n = this.sym.readSymbol(this.palUvSizeStore.get(bsizeCtx), 7) + 2
        var cache = new Int[16]
        var cacheN = av1GetPaletteCache(this.palSizeUvMap, this.palColorUMap,
                                        r, c, this.miCols, cache)
        var colorsU = new Int[8]
        var idx = 0
        var i = 0
        while (i < cacheN && idx < n) {
            if (this.sym.readBool() == 1) {
                colorsU[idx] = cache[i]
                idx = idx + 1
            }
            i = i + 1
        }
        if (idx < n) {
            colorsU[idx] = this.sym.readLiteral(bitDepth)
            idx = idx + 1
        }
        if (idx < n) {
            var bits = (bitDepth - 3) + this.sym.readLiteral(2)
            var range = (1 << bitDepth) - colorsU[idx - 1]
            while (idx < n) {
                var delta = this.sym.readLiteral(bits)
                colorsU[idx] = av1PaletteClip1(colorsU[idx - 1] + delta, bitDepth)
                range = range - (colorsU[idx] - colorsU[idx - 1])
                var cbits = av1CeilLog2(range)
                if (cbits < bits) {
                    bits = cbits
                }
                idx = idx + 1
            }
        }
        av1PaletteSort(colorsU, n)
        var colorsV = new Int[8]
        if (this.sym.readBool() == 1) {
            var bitsV = (bitDepth - 4) + this.sym.readLiteral(2)
            var maxVal = 1 << bitDepth
            colorsV[0] = this.sym.readLiteral(bitDepth)
            var vi = 1
            while (vi < n) {
                var dv = this.sym.readLiteral(bitsV)
                if (dv != 0 && this.sym.readBool() == 1) {
                    dv = 0 - dv
                }
                var vv = colorsV[vi - 1] + dv
                if (vv < 0) {
                    vv = vv + maxVal
                }
                if (vv >= maxVal) {
                    vv = vv - maxVal
                }
                colorsV[vi] = av1PaletteClip1(vv, bitDepth)
                vi = vi + 1
            }
        } else {
            var vj = 0
            while (vj < n) {
                colorsV[vj] = this.sym.readLiteral(bitDepth)
                vj = vj + 1
            }
        }
        this.storePalette(this.palSizeUvMap, this.palColorUMap, r, c, bs, n, colorsU)
        this.storePalette(this.palSizeUvMap, this.palColorVMap, r, c, bs, n, colorsV)
        return n
    }

    // Broadcasts a palette size and its colors over the block's MI grid.
    void storePalette(Int[] sizeMap, Int[] colorMap, Int r, Int c, Int bs,
                      Int n, Int[] colors) {
        var w4 = av1BlockNum4x4Wide(bs)
        var h4 = av1BlockNum4x4High(bs)
        var rr = 0
        while (rr < h4) {
            var cc = 0
            while (cc < w4) {
                var mi = (r + rr) * this.miCols + (c + cc)
                sizeMap[mi] = n
                var k = 0
                while (k < n) {
                    colorMap[mi * 8 + k] = colors[k]
                    k = k + 1
                }
                cc = cc + 1
            }
            rr = rr + 1
        }
    }

    // The `intra_frame_mode_info` body (§5.11.8): intra Y mode, angle delta Y,
    // UV mode (with the CFL-allowed selection), angle delta UV, CFL alphas,
    // palette mode info and filter-intra mode info. Returns
    // `[ yMode, angleDeltaY, uvMode, angleDeltaUV, cflAlphaU, cflAlphaV,
    //    useFilterIntra, filterIntraMode ]`. `lossless`/`hasChroma`/
    // `enableFilterIntra` mirror the header flags; `palettePossible` is the
    // spec's palette guard (`allow_screen_content_tools` and the block-size
    // rule). 8-bit; `readBodyBd` is the bit-depth-aware form the palette color
    // reads need.
    Int[] readBody(Int r, Int c, Int bs, Int lossless, Int hasChroma,
                   Int enableFilterIntra, Int palettePossible) {
        return this.readBodyBd(r, c, bs, lossless, hasChroma, enableFilterIntra,
                               palettePossible, 8)
    }

    Int[] readBodyBd(Int r, Int c, Int bs, Int lossless, Int hasChroma,
                     Int enableFilterIntra, Int palettePossible, Int bitDepth) {
        var hasU = 0
        if (r > 0) {
            hasU = 1
        }
        var hasL = 0
        if (c > 0) {
            hasL = 1
        }
        var imc = av1IntraModeContext()
        var aboveMode = 0
        if (hasU == 1) {
            aboveMode = imc.get(this.yModeAt(r - 1, c))
        }
        var leftMode = 0
        if (hasL == 1) {
            leftMode = imc.get(this.yModeAt(r, c - 1))
        }
        var yMode = this.sym.readSymbol(this.kfYStore.get(aboveMode * 5 + leftMode), 13)
        var angleY = 0
        if (bs >= 3 && av1IsDirectionalMode(yMode) == 1) {
            var raw = this.sym.readSymbol(this.angleStore.get(yMode - 1), 7)
            angleY = raw - 3
        }
        var uvMode = 0
        var angleUV = 0
        var cflU = 0
        var cflV = 0
        if (hasChroma == 1) {
            var maxDim = av1BlockWidth(bs)
            if (av1BlockHeight(bs) > maxDim) {
                maxDim = av1BlockHeight(bs)
            }
            var cflAllowed = 0
            if (lossless == 1 && bs == 0) {
                cflAllowed = 1
            } else if (lossless == 0 && maxDim <= 32) {
                cflAllowed = 1
            }
            if (cflAllowed == 1) {
                uvMode = this.sym.readSymbol(this.uvStore.get(13 + yMode), 14)
            } else {
                uvMode = this.sym.readSymbol(this.uvStore.get(yMode), 13)
            }
            if (uvMode == 13) {
                var signs = this.sym.readSymbol(this.cflSignStore, 8)
                var signU = (signs + 1) / 3
                var signV = (signs + 1) % 3
                if (signU != 0) {
                    var au = this.sym.readSymbol(this.cflAlphaStore.get((signU - 1) * 3 + signV), 16)
                    cflU = 1 + au
                    if (signU == 2) {
                        cflU = 0 - cflU
                    }
                }
                if (signV != 0) {
                    var av = this.sym.readSymbol(this.cflAlphaStore.get((signV - 1) * 3 + signU), 16)
                    cflV = 1 + av
                    if (signV == 2) {
                        cflV = 0 - cflV
                    }
                }
            }
            if (bs >= 3 && av1IsDirectionalMode(uvMode) == 1) {
                var rawUV = this.sym.readSymbol(this.angleStore.get(uvMode - 1), 7)
                angleUV = rawUV - 3
            }
        }
        // palette_mode_info( ) (§5.11.8), between uv_mode and
        // filter_intra_mode_info. Only a DC_PRED luma/uv mode can start a
        // palette; the guard is the caller's `palettePossible`.
        if (palettePossible == 1) {
            if (yMode == 0) {
                this.readPaletteY(r, c, bs, bitDepth)
            }
            if (hasChroma == 1 && uvMode == 0) {
                this.readPaletteUv(r, c, bs, bitDepth)
            }
        }
        var useFilterIntra = 0
        var filterMode = 0
        if (enableFilterIntra == 1 && yMode == 0 && av1ModeInfoMaxDim(bs) <= 32) {
            useFilterIntra = this.sym.readSymbol(this.filterIntraStore.get(bs), 2)
            if (useFilterIntra == 1) {
                filterMode = this.sym.readSymbol(this.filterModeStore, 5)
            }
        }
        this.setModes(r, c, bs, yMode, uvMode)
        var out = new Int[8]
        out[0] = yMode
        out[1] = angleY
        out[2] = uvMode
        out[3] = angleUV
        out[4] = cflU
        out[5] = cflV
        out[6] = useFilterIntra
        out[7] = filterMode
        return out
    }

    // `read_cdef()` (§5.11.8, spec `clear_cdef`/`read_cdef`): when CDEF is on,
    // every 64x64 unit reads a `cdef_bits`-wide strength literal ONCE — from the
    // FIRST non-skip block that touches the unit, wherever inside it that block
    // sits (the spec masks `MiRow`/`MiCol` to the unit origin and tests the
    // grid) — and broadcasts it over the unit. `skip` is the block's skip flag.
    Int readCdef(Int r, Int c, Int bs, Int skip, Av1ModeTail cfg) {
        if (skip == 1 || cfg.codedLossless == 1 || cfg.enableCdef == 0) {
            return -1
        }
        var cdefSize4 = 16
        var r0 = r - (r % cdefSize4)
        var c0 = c - (c % cdefSize4)
        if (this.cdefMap[r0 * this.miCols + c0] == -1) {
            var strength = this.sym.readLiteral(cfg.cdefBits)
            var w4 = av1BlockNum4x4Wide(bs)
            var h4 = av1BlockNum4x4High(bs)
            var i = r0
            while (i < r0 + h4) {
                var j = c0
                while (j < c0 + w4) {
                    this.cdefMap[i * this.miCols + j] = strength
                    j = j + cdefSize4
                }
                i = i + cdefSize4
            }
            return strength
        }
        return this.cdefMap[r0 * this.miCols + c0]
    }

    // `read_delta_qindex()` (§5.11.8): the `@@delta_q_abs` symbol plus the
    // `DELTA_Q_SMALL` literal escape and the sign bit, returning the reduced
    // delta scaled by `delta_q_res`. The caller adds it to the running quantizer
    // index and clamps to [1,255]. Gated on `ReadDeltas`, on the first block of
    // the superblock (libaom's `mi_col/mi_row & (mib_size-1) == 0`) and on the
    // spec's `MiSize == sbSize && skip` early return.
    Int readDeltaQ(Int r, Int c, Int bs, Int skip, Av1ModeTail cfg) {
        if (bs == cfg.sbSize && skip == 1) {
            return 0
        }
        if (cfg.deltaQPresent == 0) {
            return 0
        }
        var sb4 = 16
        if (cfg.sbSize == 15) {
            sb4 = 32
        }
        if ((r % sb4) != 0 || (c % sb4) != 0) {
            return 0
        }
        var abs = this.sym.readSymbol(this.deltaQStore, 4)
        if (abs == 3) {
            var rem = this.sym.readLiteral(3) + 1
            abs = this.sym.readLiteral(rem) + (1 << rem) + 1
        }
        var sign = 1
        if (abs != 0) {
            sign = this.sym.readLiteral(1)
        }
        var reduced = abs
        if (sign == 1) {
            reduced = 0 - abs
        }
        return reduced << cfg.deltaQRes
    }

    // `read_delta_lf()` (§5.11.8): one delta level per `frameLfCount` entry,
    // each the `@@delta_lf_abs` symbol plus the `DELTA_LF_SMALL` literal escape
    // and the sign bit, accumulated into `cur[i]` and clamped to
    // [-MAX_LOOP_FILTER, MAX_LOOP_FILTER]. Returns the updated levels (an empty
    // list when the reader is gated out). Same superblock-first-block gate as
    // `readDeltaQ`.
    List<Int> readDeltaLf(Int r, Int c, Int bs, Int skip, List<Int> cur, Av1ModeTail cfg) {
        if (bs == cfg.sbSize && skip == 1) {
            return listOf()
        }
        if (cfg.deltaLfPresent == 0) {
            return listOf()
        }
        var sb4 = 16
        if (cfg.sbSize == 15) {
            sb4 = 32
        }
        if ((r % sb4) != 0 || (c % sb4) != 0) {
            return listOf()
        }
        var count = 1
        if (cfg.deltaLfMulti == 1) {
            count = 4
            if (cfg.numPlanes == 1) {
                count = 2
            }
        }
        var out = listOf()
        var i = 0
        while (i < count) {
            var store = this.deltaLfStore.get(0)
            if (cfg.deltaLfMulti == 1) {
                store = this.deltaLfStore.get(i)
            }
            var abs = this.sym.readSymbol(store, 4)
            if (abs == 3) {
                var n = this.sym.readLiteral(3) + 1
                abs = this.sym.readLiteral(n) + (1 << n) + 1
            }
            var sign = 1
            if (abs != 0) {
                sign = this.sym.readLiteral(1)
            }
            var reduced = abs
            if (sign == 1) {
                reduced = 0 - abs
            }
            var prev = 0
            if (i < cur.size) {
                prev = cur.get(i)
            }
            out.add(av1ModeInfoClip3(0 - 63, 63, prev + (reduced << cfg.deltaLfRes)))
            i = i + 1
        }
        return out
    }

    // The 4x4 segment map cell, or -1 when out of the frame (the spec's
    // `prevU`/`prevL`/`prevUL` = -1 edge).
    Int segAt(Int r, Int c) {
        if (r < 0 || c < 0) {
            return -1
        }
        return this.segMap[r * this.miCols + c]
    }

    Int skipAt(Int r, Int c) {
        if (r < 0 || c < 0) {
            return 0
        }
        return this.skipMap[r * this.miCols + c]
    }

    void addStep(Int r, Int c, Int skip, Int segment) {
        var s = new Int[4]
        s[0] = r
        s[1] = c
        s[2] = skip
        s[3] = segment
        this.steps.add(s)
    }

    // `read_skip()`: the SEG_LVL_SKIP shortcut when `SegIdPreSkip`, else the
    // `@@skip` symbol with the neighbour context.
    Int readSkip(Int r, Int c, Int segIdPreSkip, Int segSkipActive) {
        var skip = 0
        if (segIdPreSkip == 1 && segSkipActive == 1) {
            skip = 1
        } else {
            var ctx = this.skipAt(r - 1, c) + this.skipAt(r, c - 1)
            skip = this.sym.readSymbol(this.skipStore.get(ctx), 2)
        }
        this.skipMap[r * this.miCols + c] = skip
        return skip
    }

    // `read_segment_id()`: spatial predictor/context, the `@@segment_id` symbol
    // and the `neg_deinterleave` postprocess. When `skip` the id is the
    // predictor without reading a symbol.
    Int readSegmentId(Int r, Int c, Int skip, Int lastActiveSegId) {
        var prevUl = this.segAt(r - 1, c - 1)
        var prevU = this.segAt(r - 1, c)
        var prevL = this.segAt(r, c - 1)
        var pred = av1SegIdPred(prevUl, prevU, prevL)
        var id = pred
        if (skip == 0) {
            var ctx = av1SegIdCtx(prevUl, prevU, prevL)
            var coded = this.sym.readSymbol(this.segStore.get(ctx), 8)
            id = av1NegDeinterleave(coded, pred, lastActiveSegId + 1)
        }
        this.segMap[r * this.miCols + c] = id
        return id
    }

    // The `intra_frame_mode_info` prefix in spec order. `segIdPreSkip` selects
    // whether the segment id is read before the skip; `segSkipActive` is the
    // SEG_LVL_SKIP feature of the segment (0 in this slice; the segmentation
    // feature tables land with the mode-info reader proper). Returns
    // `[ skip, segment_id ]`.
    Int[] readPrefix(Int r, Int c, Int segIdPreSkip, Int lastActiveSegId, Int segSkipActive) {
        var skip = 0
        var seg = 0
        if (segIdPreSkip == 1) {
            seg = this.readSegmentId(r, c, 0, lastActiveSegId)
        }
        skip = this.readSkip(r, c, segIdPreSkip, segSkipActive)
        if (segIdPreSkip == 0) {
            seg = this.readSegmentId(r, c, skip, lastActiveSegId)
        }
        this.addStep(r, c, skip, seg)
        var out = new Int[2]
        out[0] = skip
        out[1] = seg
        return out
    }
}
