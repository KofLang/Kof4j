package image

import image.Av1Symbol
import image.Av1Tx

// kof.image — AV1 transform-type selection (slice 3t of the AVIF front, plan
// §34). The `transform_type` syntax `decode_block` runs after the transform-size
// read of slice 3s (§5.11.31): for a luma transform block with a residual
// (`all_zero == 0`) it reads the `@@intra_tx_type` symbol from the intra
// transform-type CDF selected by the transform set (§5.9.2 `get_tx_set`) and
// the intra prediction mode, inverts it through `Tx_Type_Intra_Inv_Set*` and
// stamps the result into the frame `TxTypes` map; chroma then derives its type
// via `compute_tx_type` (slice 3b, `libs/image/Av1Tx.kf`). Pure arithmetic, no
// `kof.io`, so it runs on every target. `decodeRaster` keeps refusing AVIF until
// the chain closes.
//
// Still-intra scope: the inter `@@inter_tx_type` path and the inter tables are
// not reachable in an intra-only frame and are not covered here. The spec
// carries `Default_Intra_Tx_Type_Set1_Cdf[ 2 ][ INTRA_MODES ][ 8 ]` and
// `Default_Intra_Tx_Type_Set2_Cdf[ 3 ][ INTRA_MODES ][ 6 ]`; the libaom
// `intra_ext_tx_cdf[3][4][13]` agrees on every reachable row (65 rows, zero
// differences, checked 07/10). `reduced_tx_set` (§5.9.2) is a frame-header flag
// that forces `TX_SET_INTRA_2`; it is handled.
//
// The CDF store adapts persistently across the tile (the spec's `intra_tx_type`
// CDFs live in the frame context), so the class holds its own mutable copies,
// like `Av1TxSize` and `Av1ModeInfo`.

// av1NumExtTxSet[ eset ] (libaom `av1_num_ext_tx_set`, indexed by the transform
// set the spec's `get_tx_set` returns): 0 DCTONLY -> 1, 1 -> 7, 2 -> 5, 3 -> 2.
Int av1NumExtTxTypes(Int eset) {
    if (eset == 0) {
        return 1
    }
    if (eset == 1) {
        return 7
    }
    if (eset == 2) {
        return 5
    }
    return 2
}

// Tx_Type_Intra_Inv_Set1[ 7 ] (§5.9.2): symbol -> TX_TYPE, intra set 1.
Int av1IntraTxTypeInvSet1(Int idx) {
    return listOf(9, 0, 10, 11, 3, 1, 2).get(idx)
}

// Tx_Type_Intra_Inv_Set2[ 5 ] (§5.9.2): symbol -> TX_TYPE, intra set 2.
Int av1IntraTxTypeInvSet2(Int idx) {
    return listOf(9, 0, 3, 1, 2).get(idx)
}

// fimode_to_intradir[ FILTER_INTRA_MODES ] (libaom `fimode_to_intradir`): the
// intra direction a filter-intra mode selects for the transform-type context.
Int av1FilterIntraModeToIntraDir(Int fiMode) {
    return listOf(0, 1, 2, 7, 0).get(fiMode)
}

