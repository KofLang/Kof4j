// The CDF store row index for a transform set and square transform size, in the
// (1,0),(1,1),(2,0),(2,1),(2,2) order: eset 1 -> rows 0/1, eset 2 -> rows 2/3/4.
Int av1IntraTxTypeRow(Int eset, Int squareTxSize) {
    if (eset == 1) {
        return squareTxSize
    }
    return 2 + squareTxSize
}

class Av1TxType {
    Av1Symbol sym
    List<Int[]> store

    constructor(Av1Symbol sym) {
        this.sym = sym
        this.store = listOf()
        var set1 = av1IntraTxTypeSet1Data().split(",")
        var r = 0
        while (r < 2) {
            var m = 0
            while (m < 13) {
                this.store.add(av1TxTypeCopy(set1, (r * 13 + m) * 8, 8))
                m = m + 1
            }
            r = r + 1
        }
        var set2 = av1IntraTxTypeSet2Data().split(",")
        r = 0
        while (r < 3) {
            var m = 0
            while (m < 13) {
                this.store.add(av1TxTypeCopy(set2, (r * 13 + m) * 6, 6))
                m = m + 1
            }
            r = r + 1
        }
    }

    // transform_type( x4, y4, txSz ) (§5.11.31) for an intra luma block.
    // `qindex == 0` (coded lossless) forces DCT_DCT and reads nothing; a
    // DCTONLY transform set (eset 0) also forces DCT_DCT. Otherwise it reads
    // the `@@intra_tx_type` symbol from the store row selected by the transform
    // set and the intra mode, inverts it and stamps the block's 4x4 units in
    // `txTypes` (flattened row-major, `stride` columns). `useFilterIntra`
    // resolves the mode through `fimode_to_intradir`.
    Int readTxType(Int txSz, Int reducedTxSet, Int qindex, Int intraMode,
            Int useFilterIntra, Int filterIntraMode, Int[] txTypes, Int stride,
            Int x4, Int y4) {
        var txType = 0
        if (qindex != 0) {
            var set = av1TxSet(txSz, false, reducedTxSet == 1)
            if (set > 0) {
                var mode = intraMode
                if (useFilterIntra == 1) {
                    mode = av1FilterIntraModeToIntraDir(filterIntraMode)
                }
                var row = av1IntraTxTypeRow(set, av1TxSizeSqr(txSz))
                var cdf = this.store.get(row * 13 + mode)
                var symbol = this.sym.readSymbol(cdf, av1NumExtTxTypes(set))
                if (set == 1) {
                    txType = av1IntraTxTypeInvSet1(symbol)
                } else {
                    txType = av1IntraTxTypeInvSet2(symbol)
                }
            }
        }
        var w4 = av1TxWidth(txSz) >> 2
        var h4 = av1TxHeight(txSz) >> 2
        var i = 0
        while (i < w4) {
            var j = 0
            while (j < h4) {
                txTypes[(y4 + j) * stride + (x4 + i)] = txType
                j = j + 1
            }
            i = i + 1
        }
        return txType
    }
}

Int[] av1TxTypeCopy(String[] parts, Int offset, Int n) {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = parts[offset + i].toInt()
        i = i + 1
    }
    return out
}
