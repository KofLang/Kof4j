    return "1535,8035,9461,12751,23467,27825,32768,0,564,3335,9709,10870,18143,28094,32768,0,672,3247,3676,11982,19415,23127,32768,0,5279,13885,15487,18044,23527,30252,32768,0,4423,6074,7985,10416,25693,29298,32768,0,1486,4241,9460,10662,16456,27694,32768,0,439,2838,3522,6737,18058,23754,32768,0,1190,4233,4855,11670,20281,24377,32768,0,1045,4312,8647,10159,18644,29335,32768,0,202,3734,4747,7298,17127,24016,32768,0,447,4312,6819,8884,16010,23858,32768,0,277,4369,5255,8905,16465,22271,32768,0,3409,5436,10599,15599,19687,24040,32768,0,1870,13742,14530,16498,23770,27698,32768,0,326,8796,14632,15079,19272,27486,32768,0,484,7576,7712,14443,19159,22591,32768,0,1126,15340,15895,17023,20896,30279,32768,0,655,4854,5249,5913,22099,27138,32768,0,1299,6458,8885,9290,14851,25497,32768,0,311,5295,5552,6885,16107,22672,32768,0,883,8059,8270,11258,17289,21549,32768,0,741,7580,9318,10345,16688,29046,32768,0,110,7406,7915,9195,16041,23329,32768,0,363,7974,9357,10673,15629,24474,32768,0,153,7647,8112,9936,15307,19996,32768,0,3511,6332,11165,15335,19323,23594,32768,0"
