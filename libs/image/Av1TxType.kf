// Default_Intra_Tx_Type_Set2_Cdf[ 3 ][ INTRA_MODES ][ 6 ], flattened.
String av1IntraTxTypeSet2Data() {
    return "6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,6554,13107,19661,26214,32768,0,1127,12814,22772,27483,32768,0,145,6761,11980,26667,32768,0,362,5887,11678,16725,32768,0,385,15213,18587,30693,32768,0,25,2914,23134,27903,32768,0,60,4470,11749,23991,32768,0,37,3332,14511,21448,32768,0,157,6320,13036,17439,32768,0,119,6719,12906,29396,32768,0,47,5537,12576,21499,32768,0,269,6076,11258,23115,32768,0,83,5615,12001,17228,32768,0,1968,5556,12023,18547,32768,0"
