package image

import image.Av1Block
import image.Av1DecodeTileRecon
import image.Av1ModeCdf
import image.Av1Symbol

// kof.image — AV1 partition tree walk, slice 3o of the AVIF front (plan §34).
// The recursive `decode_partition( r, c, bSize )` of AV1 §5.11.4 / §6.10.4:
// given a tile's entropy bytes and the frame size in 4x4 units it reads the
// partition symbol of every square block with the slice-3a symbol decoder and
// the default partition CDFs of slice 3m, then recurses exactly as the spec
// does. Each decision is recorded as `[ kind, r, c, value, partition ]` with
// `kind` 0 for a `@@partition` read (value = bSize) and 1 for a `decode_block`
// call (value = subSize), in walk order.
//
// THE MI GRID IS THE CALLER'S, and it must be the SPEC's `MiCols`/`MiRows` —
// the frame ROUNDED UP to whole 8x8 luma blocks (`2 * ceil(w / 8)`), which is
// what libaom's decoder derives: `dec_set_mb_mi` (av1/decoder/decoder.c)
// comments "Ensure that the decoded width and height are both multiples of 8
// luma pixels" and sets `mi_cols = ALIGN_POWER_OF_TWO(width, 3) >>
// MI_SIZE_LOG2`. A FLOOR (`w >> 2`) is smaller whenever a dimension is not a
// multiple of 8, and `has_rows`/`has_cols` below then answer from the wrong grid
// at the frame's edge — which selects a different PARTITION BRANCH.
//
// The neighbour context is libaom's `partition_plane_context`: the `above`
// (per column) and `left` (per row, mod 16) arrays hold `partition_context_lookup`
// bytes, `above = (above[c] >> bsl) & 1`, `left = (left[r & 15] >> bsl) & 1`
// where `bsl = Mi_Width_Log2[bSize] - 1`, and the CDF row index is
// `(left * 2 + above) + bsl * 4`. The `split_or_horz` / `split_or_vert` reads
// (only one neighbour present) use the 2-symbol gathered CDFs of slice 3n and
// are NOT adapted (`read_cdf`, not `read_symbol`); the full partition CDF is
// adapted in place across the tile, one row per context, as libaom does.
//
// Pure arithmetic, no `kof.io`, so it runs on every target. `decodeRaster`
// keeps refusing AVIF until the chain closes.

// The partition context lookup (libaom `partition_context_lookup`), indexed by
// the BLOCK_SIZES order of slice 3n: the `above` byte and the `left` byte.
List<Int> av1PartitionContextLookupAbove() {
    return listOf(31, 31, 30, 30, 30, 28, 28, 28, 24, 24, 24, 16, 16, 16, 0, 0, 31, 28, 30, 24, 28, 16)
}

List<Int> av1PartitionContextLookupLeft() {
    return listOf(31, 30, 31, 30, 28, 30, 28, 24, 28, 24, 16, 24, 16, 0, 16, 0, 28, 31, 24, 30, 16, 28)
}

class Av1Partition {
    Av1Symbol sym
    Av1ModeCdf modes
    Int miCols
    Int miRows
    Int[] above
    Int[] left
    List<Int[]> store
    List<Int[]> steps
    Av1TileDecode? decoder
    // The superblock size this walk starts from: 12 = BLOCK_64X64 (the default)
    // or 15 = BLOCK_128X128 when the sequence sets `use_128x128_superblock`.
    // libaom's `decode_tile` steps `mi_row`/`mi_col` by `cm->seq_params.mib_size`
    // (16 or 32 mi) and starts `decode_partition` at the SAME size — the
    // partition CDF row and the allowed partition types both depend on it.
    Int sbBs

    constructor(Int[] data, Int miCols, Int miRows) {
        this.sym = Av1Symbol(data)
        this.modes = Av1ModeCdf()
        this.miCols = miCols
        this.miRows = miRows
        this.sbBs = 12
        this.above = new Int[miCols + 16]
        this.left = new Int[16]
        this.store = listOf()
        var i = 0
        while (i < 20) {
            this.store.add(this.modes.partitionW(i / 4 + 1, i % 4))
            i = i + 1
        }
        this.steps = listOf()
    }

    // Binds an EXTERNAL entropy reader, replacing the constructor's own.
    //
    // libaom's `decode_partition` reads the partition symbol and then calls
    // `decode_block` on the SAME `aom_reader` (av1/decoder/decodeframe.c), so a
    // real tile's partition symbols and block payloads are INTERLEAVED in one
    // entropy stream. A walk that must stay in sync with a block decoder has to
    // share that one reader — and share the stream position with it. This is
    // that seam: the caller builds the `Av1Symbol` once and hands it to both.
    void useReader(Av1Symbol reader) {
        this.sym = reader
    }

    // The reader's bit position — the observable that proves the walk consumed
    // the reader it was GIVEN rather than one it built itself.
    Int position() {
        return this.sym.position()
    }

    // Binds a BLOCK DECODER: from here on every `decode_block` step decodes its
    // block IMMEDIATELY, before the walk reads the next partition symbol. That is
    // libaom's own interleaving — `decode_partition` calls `decode_block` inline
    // (av1/decoder/decodeframe.c:1296) — and it is the only way to stay in sync
    // with a real tile stream, whose partition symbols and block payloads share
    // one reader. With no decoder bound the walk stays a pure partition walk.
    void bindDecoder(Av1TileDecode tile) {
        this.decoder = tile
    }

    // Sets the SUPERBLOCK size the walk starts from: 12 = BLOCK_64X64 (the
    // default) or 15 = BLOCK_128X128 when the sequence's
    // `use_128x128_superblock` is 1. libaom starts `decode_partition` at
    // `cm->seq_params->sb_size` and steps by `mib_size` (16 or 32 mi); the
    // partition symbol's CDF row and the allowed partition types both depend
    // on it, so a 128-superblock stream decoded as 64 desyncs at the first
    // partition symbol.
    void setSuperblockSize(Int bs) {
        this.sbBs = bs
    }

    // Walks the whole frame, one 64x64 superblock at a time, zeroing the left
    // context per superblock row (libaom `av1_zero_left_context`).
    List<Int[]> walk() {
        return this.walkTile(0, 0, this.miRows, this.miCols)
    }

    // Walks ONE TILE: the same superblock loop, bounded by the tile's mi
    // rectangle. libaom's `decode_tile` iterates `mi_row` from
    // `tile->mi_row_start` to `tile->mi_row_end` and `mi_col` from
    // `tile->mi_col_start` to `tile->mi_col_end` (av1/decoder/decodeframe.c),
    // while the EDGE logic inside a partition (`has_rows`/`has_cols` in
    // `decode_partition`) uses the FRAME's `mi_rows`/`mi_cols` — a tile's right
    // edge is not the frame's, so the two bounds must not be confused.
    //
    // A tile also carries its OWN entropy state: libaom gives every tile a copy
    // of the frame context (`tile_data->tctx = *cm->fc`) and zeroes the above
    // context over the tile's columns, so a caller decoding a whole multi-tile
    // frame hands in a FRESH store and a fresh reader per tile. The `above`
    // array needs no reset here: each tile writes only its own columns (blocks
    // never cross a tile boundary — tiles are superblock-aligned), and the
    // `left` context is zeroed per superblock row by the loop.
    // `walkTile` with the sequence's superblock size (12 = 64x64, 15 = 128x128).
    // The walk start size and the bound decoder's availability margins both
    // depend on it; the caller reads `use_128x128_superblock` from the sequence.
    List<Int[]> walkTileSb(Int r0, Int c0, Int r1, Int c1, Int sb) {
        this.sbBs = sb
        var dec = this.decoder
        if (dec != null) {
            dec.setSuperblockSize(sb)
        }
        return this.walkTile(r0, c0, r1, c1)
    }

    List<Int[]> walkTile(Int r0, Int c0, Int r1, Int c1) {
        // The bound decoder's availability margins are TILE-relative (libaom
        // `set_offsets`: `up_available = mi_row > tile->mi_row_start`), so it
        // must know this tile's origin before the first block is decoded — a
        // tile's first column has no left neighbour even at frame col > 0.
        var dec0 = this.decoder
        if (dec0 != null) {
            dec0.setTileOrigin(r0, c0)
        }
        var step = 16
        if (this.sbBs == 15) {
            step = 32
        }
        var r = r0
        while (r < r1) {
            this.zeroLeft()
            var c = c0
            while (c < c1) {
                this.decodePartition(r, c, this.sbBs)
                c = c + step
            }
            r = r + step
        }
        return this.steps
    }

    void zeroLeft() {
        var i = 0
        while (i < 16) {
            this.left[i] = 0
            i = i + 1
        }
    }

    // bsl = Mi_Width_Log2[ bSize ] - 1 (libaom `get_sqr_bsize_idx - 1`).
    Int offBsl(Int bs) {
        return av1BlockMiWidthLog2(bs) - 1
    }

    Int ctxOf(Int r, Int c, Int bs) {
        var off = this.offBsl(bs)
        var above = 0
        if (r > 0) {
            above = (this.above[c] >> off) & 1
        }
        var left = 0
        if (c > 0) {
            left = (this.left[r & 15] >> off) & 1
        }
        return left * 2 + above
    }

    Int cdfIndex(Int r, Int c, Int bs) {
        return this.ctxOf(r, c, bs) + this.offBsl(bs) * 4
    }

    void updateCtx(Int r, Int c, Int sub, Int bs) {
        var bw = av1BlockNum4x4Wide(bs)
        var bh = av1BlockNum4x4High(bs)
        var a = av1PartitionContextLookupAbove().get(sub)
        var l = av1PartitionContextLookupLeft().get(sub)
        var i = 0
        while (i < bw) {
            this.above[c + i] = a
            i = i + 1
        }
        i = 0
        while (i < bh) {
            this.left[(r + i) & 15] = l
            i = i + 1
        }
    }

    void addStep(Int kind, Int r, Int c, Int value, Int partition) {
        var s = new Int[5]
        s[0] = kind
        s[1] = r
        s[2] = c
        s[3] = value
        s[4] = partition
        this.steps.add(s)
        // The `decode_block` call happens RIGHT HERE when a decoder is bound: the
        // block payload must be consumed before the next partition symbol, or the
        // two readers drift apart.
        if (kind == 1) {
            var dec = this.decoder
            if (dec != null) {
                dec.decodeBlock(r, c, value)
            }
        }
    }

    void decodePartition(Int r, Int c, Int bs) {
        if (r >= this.miRows) {
            return
        }
        if (c >= this.miCols) {
            return
        }
        var num4x4 = av1BlockNum4x4Wide(bs)
        var half = num4x4 >> 1
        var quarter = half >> 1
        var hasRows = (r + half) < this.miRows
        var hasCols = (c + half) < this.miCols
        var partition = 0
        if (bs < 3) {
            partition = av1PartitionNone()
        } else if (hasRows && hasCols) {
            var idx = this.cdfIndex(r, c, bs)
            var n = av1PartitionCdfLength(bs)
            partition = this.sym.readSymbol(this.store.get(idx), n)
            this.addStep(0, r, c, bs, partition)
        } else if (hasCols) {
            var row = this.modes.partitionW(this.offBsl(bs) + 1, this.ctxOf(r, c, bs))
            var g = av1PartitionGatherHorzAlike(row, bs)
            var bit = this.sym.readSymbol(g, 2)
            if (bit == 1) {
                partition = av1PartitionSplit()
            } else {
                partition = 1
            }
            this.addStep(0, r, c, bs, partition)
        } else if (hasRows) {
            var row = this.modes.partitionW(this.offBsl(bs) + 1, this.ctxOf(r, c, bs))
            var g = av1PartitionGatherVertAlike(row, bs)
            var bit = this.sym.readSymbol(g, 2)
            if (bit == 1) {
                partition = av1PartitionSplit()
            } else {
                partition = 2
            }
            this.addStep(0, r, c, bs, partition)
        } else {
            partition = av1PartitionSplit()
            this.addStep(0, r, c, bs, partition)
        }
        var subSize = av1BlockPartitionSubsize(partition, bs)
        var splitSize = av1BlockPartitionSubsize(av1PartitionSplit(), bs)
        if (partition == 0) {
            this.addStep(1, r, c, subSize, 0)
        } else if (partition == 1) {
            this.addStep(1, r, c, subSize, 0)
            if (hasRows) {
                this.addStep(1, r + half, c, subSize, 0)
            }
        } else if (partition == 2) {
            this.addStep(1, r, c, subSize, 0)
            if (hasCols) {
                this.addStep(1, r, c + half, subSize, 0)
            }
        } else if (partition == 3) {
            this.decodePartition(r, c, subSize)
            this.decodePartition(r, c + half, subSize)
            this.decodePartition(r + half, c, subSize)
            this.decodePartition(r + half, c + half, subSize)
        } else if (partition == 4) {
            this.addStep(1, r, c, splitSize, 0)
            this.addStep(1, r, c + half, splitSize, 0)
            this.addStep(1, r + half, c, subSize, 0)
        } else if (partition == 5) {
            this.addStep(1, r, c, subSize, 0)
            this.addStep(1, r + half, c, splitSize, 0)
            this.addStep(1, r + half, c + half, splitSize, 0)
        } else if (partition == 6) {
            this.addStep(1, r, c, splitSize, 0)
            this.addStep(1, r + half, c, splitSize, 0)
            this.addStep(1, r, c + half, subSize, 0)
        } else if (partition == 7) {
            this.addStep(1, r, c, subSize, 0)
            this.addStep(1, r, c + half, splitSize, 0)
            this.addStep(1, r + half, c + half, splitSize, 0)
        } else if (partition == 8) {
            var i = 0
            while (i < 4) {
                var rr = r + i * quarter
                if (i > 0) {
                    if (rr >= this.miRows) {
                        i = 4
                    } else {
                        this.addStep(1, rr, c, subSize, 0)
                    }
                } else {
                    this.addStep(1, rr, c, subSize, 0)
                }
                i = i + 1
            }
        } else {
            var i = 0
            while (i < 4) {
                var cc = c + i * quarter
                if (i > 0) {
                    if (cc >= this.miCols) {
                        i = 4
                    } else {
                        this.addStep(1, r, cc, subSize, 0)
                    }
                } else {
                    this.addStep(1, r, cc, subSize, 0)
                }
                i = i + 1
            }
        }
        this.updateExtCtx(r, c, bs, partition, subSize, splitSize, half)
    }

    // libaom `update_ext_partition_context`, applied AFTER the recursion.
    void updateExtCtx(Int r, Int c, Int bs, Int partition, Int subSize, Int splitSize, Int half) {
        if (bs < 3) {
            return
        }
        if (partition == 3) {
            if (bs == 3) {
                this.updateCtx(r, c, subSize, bs)
            }
            return
        }
        if (partition == 0) {
            this.updateCtx(r, c, subSize, bs)
        } else if (partition == 1) {
            this.updateCtx(r, c, subSize, bs)
        } else if (partition == 2) {
            this.updateCtx(r, c, subSize, bs)
        } else if (partition == 8) {
            this.updateCtx(r, c, subSize, bs)
        } else if (partition == 9) {
            this.updateCtx(r, c, subSize, bs)
        } else if (partition == 4) {
            this.updateCtx(r, c, splitSize, subSize)
            this.updateCtx(r + half, c, subSize, subSize)
        } else if (partition == 5) {
            this.updateCtx(r, c, subSize, subSize)
            this.updateCtx(r + half, c, splitSize, subSize)
        } else if (partition == 6) {
            this.updateCtx(r, c, splitSize, subSize)
            this.updateCtx(r, c + half, subSize, subSize)
        } else if (partition == 7) {
            this.updateCtx(r, c, subSize, subSize)
            this.updateCtx(r, c + half, splitSize, subSize)
        }
    }
}

// The tile's BLOCK GRID: the flat `(r, c, bs)` triples the tile driver
// (`av1DecodeTileRecon`, slice 3ag) consumes, taken from the walk's `decode_block`
// steps in DECODE ORDER. libaom's `decode_partition` calls `decode_block` at every
// leaf of the partition recursion and nowhere else, so the `kind == 1` steps ARE
// the mode-info blocks — this is the link between the partition walk (3o) and the
// driver (3ag): it answers "who produces `blocks` for a real tile".
//
// `steps` is `Av1Partition.walk()`'s output: `[ kind, r, c, value, partition ]`
// per step, `kind` 0 for a `@@partition` read and 1 for a `decode_block` call
// (where `value` is the sub block size). The positions are FRAME-ABSOLUTE 4x4 mi
// coordinates, which is the space the driver works in.
List<Int> av1TileBlockGrid(List<Int[]> steps) {
    var out = listOf<Int>()
    var i = 0
    while (i < steps.size()) {
        var s = steps.get(i)
        if (s[0] == 1) {
            out.add(s[1])
            out.add(s[2])
            out.add(s[3])
        }
        i = i + 1
    }
    return out
}
