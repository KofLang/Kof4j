package image

import image.Image
import image.Raster

// kof.image — pure-Kof raw raster encode, closing the pixel slice (§34.4).
//
// `encodeRaster(r, format)` turns a `Raster` back into image bytes for the
// codecs that are pure Kof on every target: **PNM** `P5`/`P6`, **farbfeld**,
// **BMP** 24-bit and **QOI**. No codec, no interop — full target parity (JS
// inherits the `IOJS001` gap through `kof.io`'s `writeBytes`). `writeRaster`
// writes those bytes to a path through the existing `File.writeBytes`.
//
//   var r = decodeRaster("in.ppm")
//   writeRaster("out.qoi", r, "QOI")
//
// The encoders are direct, valid and lossless for RGB/RGBA input; anything
// they cannot represent (a format they do not implement) throws a `String`
// beginning with `IMAGE:` — never a silent wrong file.

// PNG (zlib) and JPEG stay decode-only: their encoders are not pure Kof.
Int[] encodeRaster(Raster r, String format) {
    guardRaster(r.width * r.height * r.channels)
    if (format == "PPM" || format == "PGM" || format == "PNM") {
        return encodePnm(r, format == "PGM")
    }
    if (format == "farbfeld") {
        return encodeFarbfeld(r)
    }
    if (format == "BMP") {
        return encodeBmp24(r)
    }
    if (format == "QOI") {
        return encodeQoi(r)
    }
    throw "IMAGE: cannot encode raster to " + format
}

Bool writeRaster(String path, Raster r, String format) {
    return File(path).writeBytes(encodeRaster(r, format))
}

// PNM `P6` (color) / `P5` (gray), 8-bit. Alpha is dropped (PNM has none);
// a 2-channel gray+alpha raster is written as gray.
Int[] encodePnm(Raster r, Bool gray) {
    if (gray || r.channels == 1 || r.channels == 2) {
        var n = r.width * r.height
        var head = asciiBytes("P5\n" + r.width.toString() + " " + r.height.toString() + "\n255\n")
        var out = new Int[head.length + n]
        putBytes(out, 0, head)
        var p = 0
        while (p < n) {
            out[head.length + p] = graySample(r, p)
            p = p + 1
        }
        return out
    }
    var n = r.width * r.height * 3
    var head = asciiBytes("P6\n" + r.width.toString() + " " + r.height.toString() + "\n255\n")
    var out = new Int[head.length + n]
    putBytes(out, 0, head)
    var p = 0
    while (p < r.width * r.height) {
        out[head.length + p * 3] = r.samples[p * r.channels]
        out[head.length + p * 3 + 1] = r.samples[p * r.channels + 1]
        out[head.length + p * 3 + 2] = r.samples[p * r.channels + 2]
        p = p + 1
    }
    return out
}

// farbfeld: `farbfeld` + be32 width/height, then RGBA 16-bit big-endian per
// channel (each 8-bit sample scaled by 0x0101 so the round-trip is exact).
Int[] encodeFarbfeld(Raster r) {
    var pixels = r.width * r.height
    var out = new Int[16 + pixels * 8]
    putBytes(out, 0, asciiBytes("farbfeld"))
    putBe32(out, 8, r.width)
    putBe32(out, 12, r.height)
    var p = 0
    while (p < pixels) {
        var r0 = redAt(r, p)
        var g0 = greenAt(r, p)
        var b0 = blueAt(r, p)
        var a0 = alphaAt(r, p)
        var o = 16 + p * 8
        out[o] = r0
        out[o + 1] = r0
        out[o + 2] = g0
        out[o + 3] = g0
        out[o + 4] = b0
        out[o + 5] = b0
        out[o + 6] = a0
        out[o + 7] = a0
        p = p + 1
    }
    return out
}

// BMP 24-bit, bottom-up, BGR rows padded to a 4-byte boundary (alpha dropped).
Int[] encodeBmp24(Raster r) {
    var w = r.width
    var h = r.height
    var rowBytes = ((w * 3 + 3) / 4) * 4
    var pixelBytes = rowBytes * h
    var out = new Int[54 + pixelBytes]
    out[0] = 66
    out[1] = 77
    putLe32(out, 2, 54 + pixelBytes)
    putLe32(out, 10, 54)
    putLe32(out, 14, 40)
    putLe32(out, 18, w)
    putLe32(out, 22, h)
    putLe16(out, 26, 1)
    putLe16(out, 28, 24)
    putLe32(out, 34, pixelBytes)
    putLe32(out, 38, 2835)
    putLe32(out, 42, 2835)
    var row = 0
    while (row < h) {
        var srcRow = h - 1 - row
        var col = 0
        while (col < w) {
            var p = srcRow * w + col
            var o = 54 + row * rowBytes + col * 3
            out[o] = blueAt(r, p)
            out[o + 1] = greenAt(r, p)
            out[o + 2] = redAt(r, p)
            col = col + 1
        }
        row = row + 1
    }
    return out
}

// QOI (Quite OK Image) — a full encoder: RUN, INDEX, DIFF, LUMA, RGB, RGBA
// chunks and the 8-byte end marker, so the output is valid for any decoder.
Int[] encodeQoi(Raster r) {
    var pixels = r.width * r.height
    var channels = 3
    if (r.channels == 4) {
        channels = 4
    }
    var max = 14 + pixels * (channels + 1) + 8
    var out = new Int[max]
    putBytes(out, 0, asciiBytes("qoif"))
    putBe32(out, 4, r.width)
    putBe32(out, 8, r.height)
    out[12] = channels
    out[13] = 0
    var at = 14
    var index = new Int[64]
    var prevR = 0
    var prevG = 0
    var prevB = 0
    var prevA = 255
    var run = 0
    var p = 0
    while (p < pixels) {
        var cr = redAt(r, p)
        var cg = greenAt(r, p)
        var cb = blueAt(r, p)
        var ca = alphaAt(r, p)
        var op = qoiIndex(cr, cg, cb, ca)
        if (cr == prevR && cg == prevG && cb == prevB && ca == prevA) {
            run = run + 1
            if (run == 62 || p == pixels - 1) {
                out[at] = 192 + run - 1
                at = at + 1
                run = 0
            }
        } else {
            if (run > 0) {
                out[at] = 192 + run - 1
                at = at + 1
                run = 0
            }
            if (index[op] == qoiPack(cr, cg, cb, ca)) {
                out[at] = op
                at = at + 1
            } else if (ca == prevA) {
                var dr = cr - prevR
                var dg = cg - prevG
                var db = cb - prevB
                var drdg = dr - dg
                var dbdg = db - dg
                if (dr >= -2 && dr <= 1 && dg >= -2 && dg <= 1 && db >= -2 && db <= 1) {
                    out[at] = 64 + (dr + 2) * 16 + (dg + 2) * 4 + (db + 2)
                    at = at + 1
                } else if (dg >= -32 && dg <= 31 && drdg >= -8 && drdg <= 7 && dbdg >= -8 && dbdg <= 7) {
                    out[at] = 128 + dg + 32
                    out[at + 1] = (drdg + 8) * 16 + (dbdg + 8)
                    at = at + 2
                } else {
                    out[at] = 254
                    out[at + 1] = cr
                    out[at + 2] = cg
                    out[at + 3] = cb
                    at = at + 4
                }
            } else {
                out[at] = 255
                out[at + 1] = cr
                out[at + 2] = cg
                out[at + 3] = cb
                out[at + 4] = ca
                at = at + 5
            }
            index[op] = qoiPack(cr, cg, cb, ca)
        }
        prevR = cr
        prevG = cg
        prevB = cb
        prevA = ca
        p = p + 1
    }
    var i = 0
    while (i < 7) {
        out[at + i] = 0
        i = i + 1
    }
    out[at + 7] = 1
    at = at + 8
    return sliceBytes(out, at)
}

Int qoiIndex(Int r, Int g, Int b, Int a) {
    return (r * 3 + g * 5 + b * 7 + a * 11) % 64
}

Int qoiPack(Int r, Int g, Int b, Int a) {
    return (r << 24) | (g << 16) | (b << 8) | a
}

Int redAt(Raster r, Int p) {
    return r.samples[p * r.channels] & 255
}

Int greenAt(Raster r, Int p) {
    if (r.channels >= 3) {
        return r.samples[p * r.channels + 1] & 255
    }
    return redAt(r, p)
}

Int blueAt(Raster r, Int p) {
    if (r.channels >= 3) {
        return r.samples[p * r.channels + 2] & 255
    }
    return redAt(r, p)
}

Int alphaAt(Raster r, Int p) {
    if (r.channels == 2) {
        return r.samples[p * r.channels + 1] & 255
    }
    if (r.channels == 4) {
        return r.samples[p * r.channels + 3] & 255
    }
    return 255
}

Int graySample(Raster r, Int p) {
    if (r.channels == 1 || r.channels == 2) {
        return r.samples[p * r.channels] & 255
    }
    var o = p * r.channels
    return (r.samples[o] * 77 + r.samples[o + 1] * 150 + r.samples[o + 2] * 29) / 256
}

Int[] asciiBytes(String s) {
    var out = new Int[s.length]
    var i = 0
    while (i < s.length) {
        out[i] = s.charAt(i) & 255
        i = i + 1
    }
    return out
}

putBytes(Int[] dst, Int at, Int[] src) {
    var i = 0
    while (i < src.length) {
        dst[at + i] = src[i]
        i = i + 1
    }
}

putLe16(Int[] a, Int i, Int v) {
    a[i] = v & 255
    a[i + 1] = (v >> 8) & 255
}

putLe32(Int[] a, Int i, Int v) {
    a[i] = v & 255
    a[i + 1] = (v >> 8) & 255
    a[i + 2] = (v >> 16) & 255
    a[i + 3] = (v >> 24) & 255
}

putBe32(Int[] a, Int i, Int v) {
    a[i] = (v >> 24) & 255
    a[i + 1] = (v >> 16) & 255
    a[i + 2] = (v >> 8) & 255
    a[i + 3] = v & 255
}

Int[] sliceBytes(Int[] a, Int n) {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = a[i]
        i = i + 1
    }
    return out
}
