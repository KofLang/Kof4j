package linalg

// kof.linalg — the BLAS face over libopenblas (universal platform Stage
// 6.1, the FIRST slice): `ddot` computes the dot product of two Double
// vectors through openblas's FORTRAN symbol `ddot_`.
//
// THE ABI FIT (measured, not guessed): the FORTRAN calling convention
// passes EVERY argument by POINTER, and the landed scalar-array copy-in
// fatia provides exactly that for the in-only args (`Int[]`/`Double[]`
// copy to the call arena and hand the pointer), while the RESULT comes
// back as a SCALAR Double return. So `ddot_` fits the landed FFI set
// with NO new fatia: there is no pointer-to-struct and no copy-out.
// The level-2/3 faces (axpy_ writes y, gemm_ writes C) need the
// copy-out fatia (compiler territory) and stay the measured follow-up.
//
// The wrapper builds the FORTRAN scalar arguments as one-element Int
// arrays (n, incx, incy) — copy-in supplies the pointers — and hands
// the caller's vectors straight through. incx/incy = 1 (contiguous
// vectors; strided access stays out of this slice).

foreign module openblas {
    library "libopenblas.so.0"
    abi c
    ownership borrowed
    extern ddot_(Int[] n, Double[] x, Int[] incx, Double[] y, Int[] incy): Double
}

// ddot — the dot product of two contiguous Double vectors of EQUAL
// length (the caller's contract: shorter than n would read past; this
// wrapper passes n = x.length and trusts the caller's equality).
Double ddot(Double[] x, Double[] y) {
    var n = new Int[1]
    n[0] = x.length
    var inc = new Int[1]
    inc[0] = 1
    return ddot_(n, x, inc, y, inc)
}

// ── level-1, scalar-return faces (all copy-in + scalar return — the same
// ABI fit as ddot): dnrm2_ (the Euclidean norm), dasum_ (the sum of
// absolute values) and idamax_ (the 1-BASED index of the max-abs
// element — the FORTRAN convention keeps it 1-based).

foreign module openblas_l1 {
    library "libopenblas.so.0"
    abi c
    ownership borrowed
    extern dnrm2_(Int[] n, Double[] x, Int[] incx): Double
    extern dasum_(Int[] n, Double[] x, Int[] incx): Double
    extern idamax_(Int[] n, Double[] x, Int[] incx): Int
}

// dnrm2 — the Euclidean norm of a contiguous Double vector.
Double dnrm2(Double[] x) {
    var n = new Int[1]
    n[0] = x.length
    var inc = new Int[1]
    inc[0] = 1
    return dnrm2_(n, x, inc)
}

// dasum — the sum of the absolute values of a contiguous Double vector.
Double dasum(Double[] x) {
    var n = new Int[1]
    n[0] = x.length
    var inc = new Int[1]
    inc[0] = 1
    return dasum_(n, x, inc)
}

// idamax — the 1-BASED index of the element with the largest absolute
// value (the FORTRAN convention; subtract 1 to index a Kof array).
Int idamax(Double[] x) {
    var n = new Int[1]
    n[0] = x.length
    var inc = new Int[1]
    inc[0] = 1
    return idamax_(n, x, inc)
}

// ── SINGLE-PRECISION level-1 faces: the Float siblings of the double
// trio (snrm2_, sasum_, isamax_) plus sdot_ (the single-precision dot
// product). `Float` is in the FFI set (the `f` slot — fmaxf proves the
// slot), all four are copy-in + scalar-return, the same fit as the
// double faces. NO copy-out.

foreign module openblas_s {
    library "libopenblas.so.0"
    abi c
    ownership borrowed
    extern snrm2_(Int[] n, Float[] x, Int[] incx): Float
    extern sasum_(Int[] n, Float[] x, Int[] incx): Float
    extern isamax_(Int[] n, Float[] x, Int[] incx): Int
    extern sdot_(Int[] n, Float[] x, Int[] incx, Float[] y, Int[] incy): Float
}

// snrm2f — the single-precision Euclidean norm.
Float snrm2f(Float[] x) {
    var n = new Int[1]
    n[0] = x.length
    var inc = new Int[1]
    inc[0] = 1
    return snrm2_(n, x, inc)
}

// dasumf — the single-precision sum of absolute values.
Float dasumf(Float[] x) {
    var n = new Int[1]
    n[0] = x.length
    var inc = new Int[1]
    inc[0] = 1
    return sasum_(n, x, inc)
}

// idamaxf — the 1-BASED index of the max-abs element (single precision).
Int idamaxf(Float[] x) {
    var n = new Int[1]
    n[0] = x.length
    var inc = new Int[1]
    inc[0] = 1
    return isamax_(n, x, inc)
}

// sdotf — the single-precision dot product of two contiguous Float
// vectors of equal length (the caller's contract, as in ddot).
Float sdotf(Float[] x, Float[] y) {
    var n = new Int[1]
    n[0] = x.length
    var inc = new Int[1]
    inc[0] = 1
    return sdot_(n, x, inc, y, inc)
}

// ── THE LEVEL-3 FACE (15/11): gemm through the CBLAS interface — the
// scalars BY VALUE (the landed scalar face; the FORTRAN symbols would need
// every scalar as a one-element array) and the CBLAS enums (CblasRowMajor=
// 102, CblasNoTrans=111 — the standard openblas convention) as Int. Kof
// arrays are ROW-MAJOR and the CBLAS layout parameter carries that
// explicitly — no transpose dance. C is WRITTEN by the C (the copy-out
// opt-in; the module declares `ownership borrowed`).

foreign module openblas_l3 {
    library "libopenblas.so.0"
    abi c
    ownership borrowed
    extern cblas_dgemm(Int layout, Int transa, Int transb, Int m, Int n, Int k,
                       Double alpha, Double[] a, Int lda, Double[] b, Int ldb,
                       Double beta, Double[] c, Int ldc): Void
}

// The CBLAS enum values — MEASURED against this libopenblas (15/11):
// CblasRowMajor = 101 (102 is ColMajor — the swapped pair measured in C:
// layout 102 rejected LDB=2 and computed the column-major garbage;
// layout 101 returned the exact row-major oracle 58/64/139/154),
// CblasNoTrans = 111.
Int cblasRowMajor() { return 101 }

Int cblasNoTrans() { return 111 }

// gemm — the row-major matrix multiply: c = alpha * a(m×k) * b(k×n) + beta * c.
// The caller's contract: a is m*k row-major, b is k*n row-major, c is m*n
// row-major (lda = k, ldb = n, ldc = n for the packed row-major faces);
// beta = 0.0 initializes c fresh (the C never reads the incoming c).
Void gemm(Int m, Int n, Int k, Double[] a, Double[] b, Double[] c) {
    cblas_dgemm(cblasRowMajor(), cblasNoTrans(), cblasNoTrans(),
                m, n, k, 1.0, a, k, b, n, 0.0, c, n)
}

// ── THE COPY-OUT FACES (15/11, the #1156 face): the FORTRAN scal_/axpy_
// WRITE their vector argument — the array copy-out fatia makes the write
// visible in the caller's Kof array (the JVM `kof_ffi_copy_out` + the
// native direct payload, both RED-first proven 15/11).

foreign module openblas_l2 {
    library "libopenblas.so.0"
    abi c
    ownership borrowed
    // THE PRECISION-PREFIX LAW (measured: libopenblas exports dscal_/daxpy_;
    // the unsuffixed scal_/axpy_ do NOT exist — the FORTRAN names carry the
    // precision letter, exactly like ddot_).
    extern dscal_(Int[] n, Double[] alpha, Double[] x, Int[] incx): Void
    extern daxpy_(Int[] n, Double[] alpha, Double[] x, Int[] incx, Double[] y, Int[] incy): Void
}

// dscal — IN-PLACE: x := a*x (the C writes the caller's vector; the Kof
// array sees the new values after the call — the copy-out contract).
Void dscal(Double[] x, Double a) {
    var n = new Int[1]
    n[0] = x.length
    var alpha = new Double[1]
    alpha[0] = a
    var inc = new Int[1]
    inc[0] = 1
    dscal_(n, alpha, x, inc)
}

// axpy — IN-PLACE: y := a*x + y (y is WRITTEN by the C; x is copy-in).
Void axpy(Double a, Double[] x, Double[] y) {
    var n = new Int[1]
    n[0] = x.length
    var alpha = new Double[1]
    alpha[0] = a
    var inc = new Int[1]
    inc[0] = 1
    daxpy_(n, alpha, x, inc, y, inc)
}
