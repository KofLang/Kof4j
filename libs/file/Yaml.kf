package file

import file.TextStream

// kof.file — YAML configuration reader (slice 3.3).
//
// A streaming YAML reader over `TextStream` for the config-style subset:
// block mappings nested by indentation, and block sequences of scalars.
// Mappings are flattened into a canonical dotted key and sequence items are
// indexed (`tags.0`, `tags.1`), so a document is queried without nested maps
// (`Map<String, Map<String, String>>` does not compile — COMP002):
//
//   var y = Yaml("app.yaml")
//   var name = y.getString("service.name")      // String?, null if absent
//   var port = y.getInt("service.port", 8080)    // Int, fallback if absent
//   var tags = y.getArray("service.tags")        // List<String>?, null if absent
//
// Documented subset, honest (never a silent wrong parse):
//   * comments `#` (at line start or after whitespace, outside quotes), blanks;
//   * block mappings `key: value`, nested by a deeper space indent;
//   * block sequences of scalars `- value` (indexed under the parent key);
//   * scalars: plain, single-quoted (`''` = `'`), double-quoted (escapes
//     `\0 \a \b \t \n \v \f \r \e \" \\ \uXXXX \UXXXXXXXX`), boolean, null
//     (`null`/`~`/empty, case-insensitive), integer, float;
//   * a duplicate key, tab indentation, or a malformed line throws a `String`.
//
// Not supported (explicit diagnostic, never a wrong parse): block scalars
// (`|`/`>`), flow collections (`[]`/`{}`), sequences of mappings, nested
// sequences, anchors/aliases/tags, and multi-line scalars. Indentation must be
// spaces (tabs are rejected).
//
// No new syntax, built on `libs/file/TextStream.kf`. JS inherits the
// compile-time gap `IOJS001` (`readRange`); non-BMP text is the Native
// divergence `§537`.

record YamlEntry(String key, String kind, String value, List<String> items)

record YamlScalar(String kind, String value)

class Yaml {
    List<YamlEntry> entries

    constructor(String path) {
        this.entries = parseYaml(path, 8192)
    }

    constructor(String path, Int chunkSize) {
        this.entries = parseYaml(path, chunkSize)
    }

    Bool has(String key) {
        return findEntry(key) != null
    }

    // "string" | "integer" | "float" | "boolean" | "null", or null if absent.
    String? kindOf(String key) {
        var e = findEntry(key)
        if (e == null) {
            return null
        }
        return e.kind
    }

    // Decoded string value, or null when absent, null-typed or not a string.
    String? getString(String key) {
        var e = findEntry(key)
        if (e == null) {
            return null
        }
        if (e.kind != "string") {
            return null
        }
        return e.value
    }

    // Scalar items of the sequence at `key` (`key.0`, `key.1`, ...), or null
    // when no such sequence exists.
    List<String>? getArray(String key) {
        var prefix = key + "."
        var out = listOf<String>()
        var expected = 0
        var found = false
        var i = 0
        while (i < this.entries.size()) {
            var e = this.entries.get(i)
            if (yamlStartsWith(e.key, prefix)) {
                var suffix = e.key.substring(prefix.length, e.key.length)
                if (yamlIsDigits(suffix) && suffix.toInt() == expected) {
                    out.add(e.value)
                    expected = expected + 1
                    found = true
                }
            }
            i = i + 1
        }
        if (!found) {
            return null
        }
        return out
    }

    // Canonical scalar text, or null when absent or null-typed.
    String? getRaw(String key) {
        var e = findEntry(key)
        if (e == null) {
            return null
        }
        if (e.kind == "null") {
            return null
        }
        return e.value
    }

    // Integer value, or `fallback` when absent or not an integer.
    Int getInt(String key, Int fallback) {
        var e = findEntry(key)
        if (e == null) {
            return fallback
        }
        if (e.kind != "integer") {
            return fallback
        }
        return e.value.toInt()
    }

    // Numeric value (integer or float), or `fallback`.
    Double getDouble(String key, Double fallback) {
        var e = findEntry(key)
        if (e == null) {
            return fallback
        }
        if (e.kind != "float" && e.kind != "integer") {
            return fallback
        }
        return e.value.toDouble()
    }

    // Boolean value, or `fallback` when absent or not a boolean.
    Bool getBool(String key, Bool fallback) {
        var e = findEntry(key)
        if (e == null) {
            return fallback
        }
        if (e.kind != "boolean") {
            return fallback
        }
        return e.value == "true"
    }

    // Declared keys (mapping paths and indexed sequence items) in file order.
    List<String> keys() {
        var out = listOf<String>()
        var i = 0
        while (i < this.entries.size()) {
            out.add(this.entries.get(i).key)
            i = i + 1
        }
        return out
    }

    YamlEntry? findEntry(String key) {
        var i = this.entries.size() - 1
        while (i >= 0) {
            if (this.entries.get(i).key == key) {
                return this.entries.get(i)
            }
            i = i - 1
        }
        return null
    }
}

List<YamlEntry> parseYaml(String path, Int chunkSize) {
    var entries = listOf<YamlEntry>()
    var stream = TextStream(path, chunkSize)
    var mapKeys = listOf<String>()
    var mapIndents = listOf<Int>()
    var seqIndents = listOf<Int>()
    var seqCounts = listOf<Int>()
    var lineNo = 0
    var raw = stream.nextLine()
    while (raw != null) {
        var line = raw
        lineNo = lineNo + 1
        line = yamlStripComment(line)
        if (lineNo == 1 && line.length > 0 && line.charAt(0) == (65279 as Char)) {
            line = yamlSlice(line, 1, line.length)
        }
        var indent = yamlIndent(line, lineNo)
        var content = yamlTrim(yamlSlice(line, indent, line.length))
        if (content.length > 0) {
            var first = content.charAt(0)
            if (content == "---" || content == "...") {
                // document start/end markers: skipped
            } else if (first == '-') {
                var itemText = yamlTrim(yamlSlice(content, 1, content.length))
                if (itemText.length == 0) {
                    throw "YAML: nested sequences are not supported (line " + lineNo + ")"
                }
                if (yamlFindColon(itemText) >= 0) {
                    throw "YAML: sequences of mappings are not supported (line " + lineNo + ")"
                }
                yamlRejectSpecial(itemText.charAt(0), lineNo)
                while (seqIndents.size() > 0 && seqIndents.get(seqIndents.size() - 1) > indent) {
                    seqIndents.remove(seqIndents.size() - 1)
                    seqCounts.remove(seqCounts.size() - 1)
                }
                if (seqIndents.size() == 0 || seqIndents.get(seqIndents.size() - 1) < indent) {
                    seqIndents.add(indent)
                    seqCounts.add(0)
                }
                var base = yamlJoin(mapKeys)
                var idx = seqCounts.get(seqCounts.size() - 1)
                var fullKey = "" + idx
                if (base.length > 0) {
                    fullKey = base + "." + idx
                }
                var scalar = yamlScalar(itemText, lineNo)
                entries.add(YamlEntry(fullKey, scalar.kind, scalar.value, listOf<String>()))
                yamlBump(seqCounts, seqCounts.size() - 1)
            } else {
                while (seqIndents.size() > 0 && seqIndents.get(seqIndents.size() - 1) >= indent) {
                    seqIndents.remove(seqIndents.size() - 1)
                    seqCounts.remove(seqCounts.size() - 1)
                }
                while (mapIndents.size() > 0 && mapIndents.get(mapIndents.size() - 1) >= indent) {
                    mapIndents.remove(mapIndents.size() - 1)
                    mapKeys.remove(mapKeys.size() - 1)
                }
                var colon = yamlFindColon(content)
                if (colon < 0) {
                    throw "YAML: malformed line " + lineNo + ": missing ':'"
                }
                var key = yamlKey(yamlTrim(yamlSlice(content, 0, colon)), lineNo)
                var valueText = yamlTrim(yamlSlice(content, colon + 1, content.length))
                var base = yamlJoin(mapKeys)
                var fullKey = key
                if (base.length > 0) {
                    fullKey = base + "." + key
                }
                if (valueText.length > 0) {
                    var c0 = valueText.charAt(0)
                    if (c0 == '|' || c0 == '>') {
                        throw "YAML: block scalars are not supported (line " + lineNo + ")"
                    }
                    if (c0 == '[' || c0 == '{') {
                        throw "YAML: flow collections are not supported (line " + lineNo + ")"
                    }
                    yamlRejectSpecial(c0, lineNo)
                    if (yamlIndexOf(entries, fullKey) >= 0) {
                        throw "YAML: duplicate key '" + fullKey + "' at line " + lineNo
                    }
                    var scalar = yamlScalar(valueText, lineNo)
                    entries.add(YamlEntry(fullKey, scalar.kind, scalar.value, listOf<String>()))
                } else {
                    mapKeys.add(key)
                    mapIndents.add(indent)
                }
            }
        }
        raw = stream.nextLine()
    }
    return entries
}

// Unsupported YAML value kinds, diagnosed explicitly instead of mis-parsed.
yamlRejectSpecial(Char c, Int lineNo) {
    if (c == '&' || c == '*') {
        throw "YAML: anchors/aliases are not supported (line " + lineNo + ")"
    }
    if (c == '!') {
        throw "YAML: tags are not supported (line " + lineNo + ")"
    }
}

yamlBump(List<Int> counts, Int index) {
    var v = counts.get(index)
    counts.remove(index)
    counts.add(v + 1)
}

Int yamlIndexOf(List<YamlEntry> entries, String key) {
    var i = 0
    while (i < entries.size()) {
        if (entries.get(i).key == key) {
            return i
        }
        i = i + 1
    }
    return -1
}

String yamlKey(String keyText, Int lineNo) {
    if (keyText.length == 0) {
        throw "YAML: empty key at line " + lineNo
    }
    var first = keyText.charAt(0)
    if (first == '"') {
        var scalar = yamlScalar(keyText, lineNo)
        return scalar.value
    }
    if (first == '\'') {
        var scalar = yamlScalar(keyText, lineNo)
        return scalar.value
    }
    return keyText
}

YamlScalar yamlScalar(String text, Int lineNo) {
    if (text.length == 0) {
        return YamlScalar("null", "")
    }
    var first = text.charAt(0)
    if (first == '"') {
        if (text.length < 2 || text.charAt(text.length - 1) != '"') {
            throw "YAML: unterminated double-quoted scalar at line " + lineNo
        }
        return YamlScalar("string", yamlUnescape(yamlSlice(text, 1, text.length - 1), lineNo))
    }
    if (first == '\'') {
        if (text.length < 2 || text.charAt(text.length - 1) != '\'') {
            throw "YAML: unterminated single-quoted scalar at line " + lineNo
        }
        return YamlScalar("string", yamlUnsingle(yamlSlice(text, 1, text.length - 1)))
    }
    var lower = yamlLower(text)
    if (lower == "null" || text == "~") {
        return YamlScalar("null", "")
    }
    if (lower == "true") {
        return YamlScalar("boolean", "true")
    }
    if (lower == "false") {
        return YamlScalar("boolean", "false")
    }
    if (yamlIsInteger(text)) {
        return YamlScalar("integer", yamlRemoveUnderscores(text))
    }
    if (yamlIsFloat(text)) {
        return YamlScalar("float", yamlRemoveUnderscores(text))
    }
    return YamlScalar("string", text)
}

Int yamlIndent(String line, Int lineNo) {
    var i = 0
    while (i < line.length) {
        var ch = line.charAt(i)
        if (ch == ' ') {
            i = i + 1
        } else if (ch == '\t') {
            throw "YAML: tab indentation is not supported (line " + lineNo + ")"
        } else {
            return i
        }
    }
    return i
}

String yamlStripComment(String s) {
    var i = 0
    var quote = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        if (quote == 1) {
            if (ch == '\\') {
                i = i + 1
            } else if (ch == '"') {
                quote = 0
            }
        } else if (quote == 2) {
            if (ch == '\'') {
                quote = 0
            }
        } else if (ch == '"') {
            quote = 1
        } else if (ch == '\'') {
            quote = 2
        } else if (ch == '#') {
            if (i == 0 || yamlIsSpace(s.charAt(i - 1))) {
                return yamlSlice(s, 0, i)
            }
        }
        i = i + 1
    }
    return s
}

Int yamlFindColon(String s) {
    var i = 0
    var quote = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        if (quote == 1) {
            if (ch == '\\') {
                i = i + 1
            } else if (ch == '"') {
                quote = 0
            }
        } else if (quote == 2) {
            if (ch == '\'') {
                quote = 0
            }
        } else if (ch == '"') {
            quote = 1
        } else if (ch == '\'') {
            quote = 2
        } else if (ch == ':') {
            if (i + 1 == s.length || s.charAt(i + 1) == ' ') {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

String yamlUnsingle(String s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        if (ch == '\'' && i + 1 < s.length && s.charAt(i + 1) == '\'') {
            out = out + "'"
            i = i + 2
        } else {
            out = out + ch
            i = i + 1
        }
    }
    return out
}

String yamlUnescape(String s, Int lineNo) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        if (ch != '\\') {
            out = out + ch
            i = i + 1
        } else {
            if (i + 1 >= s.length) {
                throw "YAML: dangling escape at line " + lineNo
            }
            var e = s.charAt(i + 1)
            if (e == 'u') {
                out = out + yamlCodePoint(s, i + 2, 4, lineNo)
                i = i + 6
            } else if (e == 'U') {
                out = out + yamlCodePoint(s, i + 2, 8, lineNo)
                i = i + 10
            } else {
                out = out + yamlEscapedChar(e, lineNo)
                i = i + 2
            }
        }
    }
    return out
}

String yamlEscapedChar(Char e, Int lineNo) {
    if (e == '0') {
        return "" + (0 as Char)
    }
    if (e == 'a') {
        return "" + (7 as Char)
    }
    if (e == 'b') {
        return "" + (8 as Char)
    }
    if (e == 't') {
        return "\t"
    }
    if (e == 'n') {
        return "\n"
    }
    if (e == 'v') {
        return "" + (11 as Char)
    }
    if (e == 'f') {
        return "" + (12 as Char)
    }
    if (e == 'r') {
        return "\r"
    }
    if (e == 'e') {
        return "" + (27 as Char)
    }
    if (e == '"') {
        return "\""
    }
    if (e == '\\') {
        return "\\"
    }
    throw "YAML: unsupported escape at line " + lineNo
}

String yamlCodePoint(String s, Int start, Int len, Int lineNo) {
    if (start + len > s.length) {
        throw "YAML: invalid unicode escape at line " + lineNo
    }
    var value = 0
    var i = start
    while (i < start + len) {
        var d = yamlHexValue(s.charAt(i))
        if (d < 0) {
            throw "YAML: invalid unicode escape at line " + lineNo
        }
        value = value * 16 + d
        i = i + 1
    }
    return yamlCodePointToString(value)
}

String yamlCodePointToString(Int cp) {
    if (cp > 65535) {
        var x = cp - 65536
        return "" + ((55296 + (x >> 10)) as Char) + ((56320 + (x & 1023)) as Char)
    }
    return "" + (cp as Char)
}

Bool yamlIsInteger(String s) {
    if (s.length == 0) {
        return false
    }
    var i = 0
    if (s.charAt(0) == '+' || s.charAt(0) == '-') {
        i = 1
    }
    if (i >= s.length) {
        return false
    }
    var digits = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        if (ch == '_') {
            i = i + 1
        } else if (yamlIsDigit(ch)) {
            digits = digits + 1
            i = i + 1
        } else {
            return false
        }
    }
    return digits > 0
}

Bool yamlIsFloat(String s) {
    if (s.length == 0) {
        return false
    }
    var hasDot = false
    var hasExp = false
    var i = 0
    if (s.charAt(0) == '+' || s.charAt(0) == '-') {
        i = 1
    }
    if (i >= s.length) {
        return false
    }
    while (i < s.length) {
        var ch = s.charAt(i)
        if (ch == '_') {
            i = i + 1
        } else if (yamlIsDigit(ch)) {
            i = i + 1
        } else if (ch == '.' && !hasDot && !hasExp) {
            hasDot = true
            i = i + 1
        } else if ((ch == 'e' || ch == 'E') && !hasExp) {
            hasExp = true
            i = i + 1
            if (i < s.length && (s.charAt(i) == '+' || s.charAt(i) == '-')) {
                i = i + 1
            }
        } else {
            return false
        }
    }
    return hasDot || hasExp
}

String yamlRemoveUnderscores(String s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        if (ch != '_') {
            out = out + ch
        }
        i = i + 1
    }
    return out
}

String yamlLower(String s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i) as Int
        if (c >= 65 && c <= 90) {
            out = out + ((c + 32) as Char)
        } else {
            out = out + s.charAt(i)
        }
        i = i + 1
    }
    return out
}

Bool yamlStartsWith(String s, String prefix) {
    if (s.length < prefix.length) {
        return false
    }
    var i = 0
    while (i < prefix.length) {
        if (s.charAt(i) != prefix.charAt(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

Bool yamlIsDigits(String s) {
    if (s.length == 0) {
        return false
    }
    var i = 0
    while (i < s.length) {
        if (!yamlIsDigit(s.charAt(i))) {
            return false
        }
        i = i + 1
    }
    return true
}

Bool yamlIsDigit(Char ch) {
    var c = ch as Int
    return c >= 48 && c <= 57
}

Int yamlHexValue(Char ch) {
    var c = ch as Int
    if (c >= 48 && c <= 57) {
        return c - 48
    }
    if (c >= 97 && c <= 102) {
        return c - 97 + 10
    }
    if (c >= 65 && c <= 70) {
        return c - 65 + 10
    }
    return -1
}

String yamlJoin(List<String> parts) {
    var out = ""
    var i = 0
    while (i < parts.size()) {
        if (i > 0) {
            out = out + "."
        }
        out = out + parts.get(i)
        i = i + 1
    }
    return out
}

String yamlTrim(String s) {
    var start = 0
    var end = s.length
    while (start < end && yamlIsSpace(s.charAt(start))) {
        start = start + 1
    }
    while (end > start && yamlIsSpace(s.charAt(end - 1))) {
        end = end - 1
    }
    return yamlSlice(s, start, end)
}

Bool yamlIsSpace(Char ch) {
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'
}

String yamlSlice(String s, Int from, Int to) {
    var out = ""
    var i = from
    while (i < to) {
        out = out + s.charAt(i)
        i = i + 1
    }
    return out
}
