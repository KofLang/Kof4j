package game

// kof.game — per-frame input snapshot (slice 3.1 of the graphics/gaming front,
// `D-GRAPHICS-GAMING` + `D-GRAPHICS-SPIKE`).
//
// The plan §7 freezes input as a SNAPSHOT per frame: `keys.down("left")`,
// `keys.pressed("space")`, `keys.released("space")`. The backend owns scancode/
// X11/Wayland/KeyboardEvent translation and calls `beginFrame(held)` once per
// frame with the keys held during that frame; the program then queries the three
// states. This module is the PURE, backend-independent half: it keeps the current
// and previous frame's key sets and derives the transitions, so it calls no OS/
// window API and is honest on every target today. The backend window (`Window`/
// `frame`) and the real event translation are layered on top in a later slice.
//
// Deterministic by construction: given the same sequence of `beginFrame` calls,
// `down`/`pressed`/`released` are identical on every target — the property the
// plan requires for input goldens ("virtual clock, deterministic input").
//
//   var keys = Keys()
//   while (clock.hasNext()) {
//       clock.beginFrame(now)
//       keys.beginFrame(backend.heldKeys())   // e.g. listOf("left", "space")
//       if (keys.pressed("space")) { jump() }
//       if (keys.down("left")) { moveLeft(clock.dtMicros()) }
//   }
//
// Semantics (frozen here, tested): a key is `down` when held this frame;
// `pressed` on the frame it first appears (down now, not down before); `released`
// on the frame it disappears (down before, not down now). The first `beginFrame`
// diffs against an empty set, so a key held on frame 0 reads `pressed` (there was
// no prior frame to compare against); `released` is never true on frame 0. Pure
// set arithmetic, no IO.

class Keys {
    Set<String> current
    Set<String> previous

    constructor() {
        this.current = setOf<String>()
        this.previous = setOf<String>()
    }

    // Enter a frame holding `held`: the previous frame's set becomes the
    // baseline and `held` becomes the current set. Duplicates are ignored.
    void beginFrame(List<String> held) {
        this.previous = this.current
        this.current = setOf<String>()
        for (var key in held) {
            this.current.add(key)
        }
    }

    // True while `key` is held this frame.
    Bool down(String key) {
        return this.current.contains(key)
    }

    // True on the frame `key` first appears (down now, not down before).
    Bool pressed(String key) {
        return this.current.contains(key) && !this.previous.contains(key)
    }

    // True on the frame `key` disappears (down before, not down now).
    Bool released(String key) {
        return !this.current.contains(key) && this.previous.contains(key)
    }
}
