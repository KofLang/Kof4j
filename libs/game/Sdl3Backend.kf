package game

import game.Draw
import image.Raster
import game.Window

// kof.game — o BACKEND SDL3 da face NATIVA (plano `docs/development/
// graphics-sdl3-backend.md`, slice 1; ordem da mantenedora 22/11: "nativo +
// wasi é o caminho", SEM KofJS).
//
// Esta e' a unica camada que fala com o sistema operacional. A superficie pura
// (`Window`/`Keys`/`Draw`/`Sprite`) continua deterministica e sem IO; o app da
// o `backend` a ela:
//
//   var b = Sdl3Backend("Enois", 800, 600)
//   var w = Window("Enois")
//   var keys = Keys()
//   var queue = DrawList()
//   w.frame { dt: Int, self: Window ->
//       keys.beginFrame(b.heldKeys())
//       if (b.quitRequested()) { self.stop() }
//       b.clearFrame(10, 20, 30)
//       b.present(queue)
//       queue.clear()
//   }
//   b.close()
//
// MEDIDO 22/11 neste host: janela criada, titulo lido, 60 frames com dt=16ms,
// e a cor escrita no renderer LIDA DE VOLTA pelos pixels (10,200,90,255) —
// a prova do `Sdl3BackendE2ETest`.
//
// HONESTIDADE POR ALVO: este arquivo so' liga onde o `extern` liga (o nativo
// x86-64, e o JVM com a lib no disco). No WASI o `extern` recusa com FFI001 e
// o alvo usa a face de SOFTWARE (`SoftwareBackend`, slice 2).

// Os tipos SDL3 que o backend toca. `Long` carrega os ponteiros opacos
// (SDL_Window*, SDL_Renderer*); o 0 e' a falha.
extern "libSDL3.so.0" SDL_Init(Int flags): Bool
extern "libSDL3.so.0" SDL_CreateWindow(String title, Int w, Int h, Long flags): Long
extern "libSDL3.so.0" SDL_GetWindowTitle(Long win): String
extern "libSDL3.so.0" SDL_CreateRenderer(Long win, String name, Long flags): Long
extern "libSDL3.so.0" SDL_DestroyRenderer(Long ren): void
extern "libSDL3.so.0" SDL_SetRenderDrawColor(Long ren, Int r, Int g, Int b, Int a): Bool
extern "libSDL3.so.0" SDL_RenderClear(Long ren): Bool
extern "libSDL3.so.0" SDL_RenderFillRect(Long ren, Buffer(U8) rect): Bool
extern "libSDL3.so.0" SDL_RenderPresent(Long ren): void
extern "libSDL3.so.0" SDL_PollEvent(Buffer(U8) event): Bool
extern "libSDL3.so.0" SDL_PushEvent(Buffer(U8) event): Bool
extern "libSDL3.so.0" SDL_GetError(): String
extern "libSDL3.so.0" SDL_DestroyWindow(Long win): void
extern "libSDL3.so.0" SDL_Quit(): void
extern "libSDL3.so.0" SDL_RenderReadPixels(Long ren, Long rect): Long
extern "libSDL3.so.0" SDL_ReadSurfacePixel(Long s, Int x, Int y, Buffer(U8) r, Buffer(U8) g, Buffer(U8) b, Buffer(U8) a): Bool
extern "libSDL3.so.0" SDL_DestroySurface(Long s): void
extern "libSDL3.so.0" SDL_CreateTexture(Long ren, Int fmt, Int access, Int w, Int h): Long
extern "libSDL3.so.0" SDL_UpdateTexture(Long tex, Long rect, Buffer(U8) pixels, Int pitch): Bool
extern "libSDL3.so.0" SDL_RenderTexture(Long ren, Long tex, Long src, Buffer(U8) dst): Bool
extern "libSDL3.so.0" SDL_SetTextureScaleMode(Long tex, Int mode): Bool
extern "libSDL3.so.0" SDL_DestroyTexture(Long tex): void

// A janela + o renderer, com o estado de entrada do frame.
class Sdl3Backend {
    Int width
    Int height
    Long windowHandle
    Long rendererHandle
    Map<String, Long> textures
    // §1195: o buffer da ULTIMA imagem decodificada (o chamador recorta o
    // alfa nele — o Buffer agora e' tipo de campo, como qualquer class)
    Buffer lastImageBuf
    Bool lastImageOk
    Int lastImageW
    Int lastImageH
    Bool quitFlag
    List<String> held
    Int pointerXPos
    Int pointerYPos
    List<String> buttonsHeld
    Int[] eventBuffer

    // SDL_INIT_VIDEO
    constructor(String title, Int w, Int h) {
        this.width = w
        this.height = h
        this.quitFlag = false
        this.held = listOf<String>()
        this.buttonsHeld = listOf<String>()
        this.pointerXPos = 0
        this.pointerYPos = 0
        this.textures = mapOf<String, Long>()
        // SDL_Event e' uma union de 128 bytes; um Int[] de 32 cobre (4 B cada)
        this.eventBuffer = new Int[48]
        SDL_Init(32)
        this.windowHandle = SDL_CreateWindow(title, w, h, 0)
        if (this.windowHandle == 0) {
            throw "SDL3: " + SDL_GetError()
        }
        this.rendererHandle = SDL_CreateRenderer(this.windowHandle, "", 1)
        if (this.rendererHandle == 0) {
            throw "SDL3 (renderer): " + SDL_GetError()
        }
    }

    Int widthPx() { return this.width }
    Int heightPx() { return this.height }
    String title() { return SDL_GetWindowTitle(this.windowHandle) }

    // Estado de saida: 'q' ou o fechar-da-janela (SDL_EVENT_QUIT=0x100).
    Bool quitRequested() { return this.quitFlag }

    // As teclas SEGURADAS neste frame (o contrato `Keys.beginFrame`).
    List<String> heldKeys() { return this.held }

    // O ponteiro deste frame (o contrato `Mouse.beginFrame(x, y, buttons)`).
    Int pointerX() { return this.pointerXPos }
    Int pointerY() { return this.pointerYPos }
    List<String> heldButtons() { return this.buttonsHeld }

    // O fundo do frame.
    void clearFrame(Int r, Int g, Int b) {
        SDL_SetRenderDrawColor(this.rendererHandle, r, g, b, 255)
        SDL_RenderClear(this.rendererHandle)
    }

    // Desenha o DrawList: cada DrawCmd vira o seu retangulo na posicao. A
    // IMAGEM do comando e' resolvida pelo cache abaixo (`textureFor`); sem
    // textura registrada o comando pinta um retangulo solido (o mesmo da
    // fatia 1), entao um app nao precisa de imagem para desenhar.
    void present(DrawList queue) {
        var i = 0
        while (i < queue.size()) {
            val cmd = queue.commandAt(i)
            val x = cmd.x as Int
            val y = cmd.y as Int
            val w = (16.0 * cmd.scaleX) as Int
            val h = (16.0 * cmd.scaleY) as Int
            val tex = this.textureFor(cmd.image)
            if (tex != 0) {
                this.drawTexture(tex, x, y, w, h)
            } else {
                SDL_SetRenderDrawColor(this.rendererHandle, 255, 255, 255, 255)
                this.fillRect(x, y, w, h)
            }
            i = i + 1
        }
        SDL_RenderPresent(this.rendererHandle)
    }

    // Um retangulo solido na cor corrente. O `SDL_FRect` e' quatro FLOATS —
    // gravar os inteiros crus fazia o retangulo ter 1e-44 de largura e nada
    // pintava (MEDIDO 22/11: `dentro r=0` com fillRect(8,8,16,16)); os bits
    // saem do `floatBits`, o mesmo caminho que o `drawTexture` ja usa.
    void fillRect(Int x, Int y, Int w, Int h) {
        val r = buffer.alloc(16)
        buffer.poke32(r, 0, floatBits(x))
        buffer.poke32(r, 4, floatBits(y))
        buffer.poke32(r, 8, floatBits(w))
        buffer.poke32(r, 12, floatBits(h))
        SDL_RenderFillRect(this.rendererHandle, r)
    }

    // Empurra um SDL_EVENT_KEY_DOWN sintetico (o caminho deterministico do
    // input: um teste ou um replay de replay nao depende do teclado fisico).
    Bool pushKey(Int keycode) {
        val e = buffer.alloc(128)
        buffer.poke32(e, 0, 768)
        buffer.poke32(e, 24, keycode)
        buffer.poke32(e, 32, 1)
        return SDL_PushEvent(e)
    }

    // Empurra um SDL_EVENT_MOUSE_MOTION sintetico (a fonte deterministica do
    // mouse: x, y e a mascara de botoes — SDL_BUTTON_LMASK=1/RMASK=2/MMASK=4).
    Bool pushMouseMotion(Int x, Int y, Int state) {
        val e = buffer.alloc(128)
        buffer.poke32(e, 0, 1024)
        buffer.poke32(e, 24, state)
        buffer.poke32(e, 28, floatBits(x))
        buffer.poke32(e, 32, floatBits(y))
        return SDL_PushEvent(e)
    }

    // Drena a fila do SDL para ESTE frame: monta `held` e detecta o quit.
    // (O keycode de um SDL_EVENT_KEY_DOWN esta em `key.key`, offset 24 da
    // union; o buffer de evento e' um Buffer, nao o Int[] antigo — o SDL
    // escreve 128 bytes crus.)
    void pumpEvents() {
        this.held = listOf<String>()
        val ev = buffer.alloc(128)
        while (SDL_PollEvent(ev)) {
            val ty = buffer.peek32(ev, 0)
            if (ty == 256) {
                this.quitFlag = true
            } else if (ty == 768) {
                val name = keyName(buffer.peek32(ev, 24))
                if (name != "") { this.held.add(name) }
            } else if (ty == 1024) {
                // SDL_EVENT_MOUSE_MOTION: state (offset 24), x (28), y (32)
                this.pointerXPos = floatToInt(buffer.peek32(ev, 28))
                this.pointerYPos = floatToInt(buffer.peek32(ev, 32))
                this.buttonsHeld = buttonNames(buffer.peek32(ev, 24))
            }
        }
    }

    // A medida do frame: um pixel da tela, como (r,g,b,a) 0..255.
    Int[] readPixel(Int x, Int y) {
        val surf = SDL_RenderReadPixels(this.rendererHandle, 0L)
        if (surf == 0) { throw "SDL3 (readback): " + SDL_GetError() }
        val r = buffer.alloc(1)
        val g = buffer.alloc(1)
        val b = buffer.alloc(1)
        val a = buffer.alloc(1)
        SDL_ReadSurfacePixel(surf, x, y, r, g, b, a)
        val out = new Int[4]
        out[0] = r.bytes()[0]
        out[1] = g.bytes()[0]
        out[2] = b.bytes()[0]
        out[3] = a.bytes()[0]
        SDL_DestroySurface(surf)
        return out
    }

    // Cria a textura RGBA (w x h) e devolve o handle. Os PIXELS vao pelo
    // `SDL_UpdateTexture` (o `Buffer(U8)` so' existe em assinatura
    // `extern` — um metodo normal recusa o tipo, medido 22/11).
    Long createTexture(Int w, Int h) {
        val tex = SDL_CreateTexture(this.rendererHandle, 0x16762004, 1, w, h)
        if (tex == 0) { throw "SDL3 (texture): " + SDL_GetError() }
        return tex
    }


    // Desenha a textura inteira em (x, y) com o tamanho (w, h). O `SDL_FRect`
    // e' quatro FLOATS — os bits IEEE vao crus no buffer (medido 22/11:
    // gravar os inteiros fazia o SDL ler um retangulo vazio e nao pintar).
    // SDL_RenderTexture com `dstrect` NULL nao pinta: o destino e' OBRIGATORIO.
    void drawTexture(Long tex, Int x, Int y, Int w, Int h) {
        val dst = buffer.alloc(16)
        buffer.poke32(dst, 0, floatBits(x))
        buffer.poke32(dst, 4, floatBits(y))
        buffer.poke32(dst, 8, floatBits(w))
        buffer.poke32(dst, 12, floatBits(h))
        SDL_RenderTexture(this.rendererHandle, tex, 0L, dst)
    }

    // O handle da textura da imagem `name` (0 = nao registrada, o comando
    // pinta o retangulo solido). O app registra com `registerTexture`.
    Long textureFor(String name) {
        val tex = this.textures.get(name)
        if (tex == null) { return 0L }
        return tex
    }

    // Registra (ou substitui) a textura de `name` — a altura/largura ficam
    // com o que o `createTexture` definiu.
    void registerTexture(String name, Long tex) {
        this.textures.put(name, tex)
    }

    // Carrega um PNG/PNM/BMP/QOI/GIF/WebP do disco para uma textura RGBA,
    // pela lib `image` em KOF PURO (sem codec externo). Devolve o handle, ou
    // 0 quando o arquivo nao decodifica — a tela desenha a superficie solida.
    /** Decodifica `path` e guarda o buffer RGBA em `lastImageBuf` (0 = falha).
     *  E' a porta UNICA de imagem: `loadImageTexture` e o recorte do avatar
     *  passam por aqui. */
    Int decodeImage(String path) {
        this.lastImageOk = false
        this.lastImageW = 0
        this.lastImageH = 0
        try {
            val r = decodeRaster(path)
            val w = r.width()
            val h = r.height()
            if (w <= 0 || h <= 0) { return 0 }
            val n = w * h
            val rgba = buffer.alloc(n * 4)
            var i = 0
            while (i < n) {
                buffer.poke8(rgba, i * 4, r.samples()[i * r.channels()])
                var c1 = 0
                var c2 = 0
                if (r.channels() > 1) { c1 = r.samples()[i * r.channels() + 1] }
                if (r.channels() > 2) { c2 = r.samples()[i * r.channels() + 2] }
                buffer.poke8(rgba, i * 4 + 1, c1)
                buffer.poke8(rgba, i * 4 + 2, c2)
                buffer.poke8(rgba, i * 4 + 3, 255)
                i = i + 1
            }
            this.lastImageBuf = rgba
            this.lastImageOk = true
            this.lastImageW = w
            this.lastImageH = h
            return 1
        } catch (String e) {
            return 0
        }
    }

    Int imageWidth() { return this.lastImageW }
    Int imageHeight() { return this.lastImageH }

    /** Sobe `lastImageBuf` para uma textura NEAREST (depois do recorte). */
    Long textureFromLastImage() {
        if (!this.lastImageOk || this.lastImageW <= 0) { return 0L }
        val tex = this.createTexture(this.lastImageW, this.lastImageH)
        SDL_UpdateTexture(tex, 0L, this.lastImageBuf, this.lastImageW * 4)
        SDL_SetTextureScaleMode(tex, 0)
        return tex
    }

    Long loadImageTexture(String path) {
        try {
            val r = decodeRaster(path)
            if (r.width() <= 0 || r.height() <= 0) { return 0L }
            val n = r.width() * r.height()
            val rgba = buffer.alloc(n * 4)
            var i = 0
            while (i < n) {
                buffer.poke8(rgba, i * 4, r.samples()[i * r.channels()])
                var c1 = 0
                var c2 = 0
                if (r.channels() > 1) { c1 = r.samples()[i * r.channels() + 1] }
                if (r.channels() > 2) { c2 = r.samples()[i * r.channels() + 2] }
                buffer.poke8(rgba, i * 4 + 1, c1)
                buffer.poke8(rgba, i * 4 + 2, c2)
                buffer.poke8(rgba, i * 4 + 3, 255)
                i = i + 1
            }
            val tex = this.createTexture(r.width(), r.height())
            SDL_UpdateTexture(tex, 0L, rgba, r.width() * 4)
            // o SDL amostra LINEAR por padrao (documentado): uma imagem
            // escalada sai BORRADA e com as cores MISTURADAS (medido 22/11:
            // (8,16,200) virou (8,6,0) e (0,0) saiu preto). NEAREST = 0 e' o
            // que o CSS chama de `image-rendering: pixelated`.
            SDL_SetTextureScaleMode(tex, 0)
            return tex
        } catch (String e) {
            return 0L
        }
    }

    void close() {
        if (this.rendererHandle != 0) { SDL_DestroyRenderer(this.rendererHandle) }
        if (this.windowHandle != 0) { SDL_DestroyWindow(this.windowHandle) }
        SDL_Quit()
    }
}

// Os nomes de tecla da superficie (`Keys` compara strings).
String keyName(Int code) {
    return switch (code) {
        case 0x61 -> "a"
        case 0x64 -> "d"
        case 0x77 -> "w"
        case 0x73 -> "s"
        case 0x20 -> "space"
        case 0x0d -> "enter"
        case 0x1b -> "escape"
        case 0x40000050 -> "left"
        case 0x4000004f -> "right"
        case 0x40000052 -> "up"
        case 0x40000051 -> "down"
        default -> ""
    }
}

// Os bits IEEE-754 (f32) de um Int nao-negativo — o que o `SDL_FRect` le no
// buffer. Monta o float por partes (sinal, expoente, mantissa) sem depender
// de nenhuma primitiva de bits: exato para todo inteiro representavel em f32
// (posicoes e tamanhos, o caso do retangulo). Medido: 0=0, 8=1090519040,
// 16=1098907648. Negativo preserva o sinal; fracionario trunca para o inteiro.
Int floatBits(Int value) {
    if (value == 0) { return 0 }
    var negative = false
    if (value < 0) { negative = true }
    var v = value
    if (negative) { v = 0 - v }
    var exp = 0
    var m = v
    while (m >= 2) {
        m = m / 2
        exp = exp + 1
    }
    // a mantissa de 23 bits: o que sobra depois do bit implicito
    var rest = v - (1 << exp)
    if (exp > 23) {
        rest = rest >> (exp - 23)
    } else {
        rest = rest << (23 - exp)
    }
    val biased = exp + 127
    var sign = 0
    if (negative) { sign = 1 << 31 }
    return sign | (biased << 23) | rest
}

// Os nomes dos botoes segurados a partir da mascara do SDL
// (SDL_BUTTON_LMASK=1, RMASK=2, MMASK=4).
List<String> buttonNames(Int state) {
    val out = listOf<String>()
    if (state & 1 != 0) { out.add("left") }
    if (state & 2 != 0) { out.add("right") }
    if (state & 4 != 0) { out.add("middle") }
    return out
}

// O inteiro de um f32 cru (os bits que o SDL grava nas coordenadas). Le
// sinal, expoente e mantissa — o inverso do `floatBits`; trunca a fracao.
Int floatToInt(Int bits) {
    if (bits == 0) { return 0 }
    var negative = false
    if (bits < 0) { negative = true }
    val abs = bits & 0x7fffffff
    val exp = (abs >> 23) & 0xff
    if (exp == 0) { return 0 }
    val mant = abs & 0x7fffff
    val e = exp - 127
    var v = 0
    if (e >= 23) {
        v = (0x800000 | mant) << (e - 23)
    } else if (e >= 0) {
        v = (0x800000 | mant) >> (23 - e)
    } else {
        return 0
    }
    if (negative) { return 0 - v }
    return v
}
