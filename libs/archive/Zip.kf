package archive

import image.Inflate

// kof-archive — reading the CENTRAL DIRECTORY of a classic ZIP archive
// (APPNOTE 6.3.x). Issue #852, slice 1.
//
// Kof-first, per D-KOF-FILE-GO ("the base stdlib keeps I/O/streaming/text
// light; heavy codecs belong to official packages"): this is a pure-Kof
// library over `kof.io` and it composes what already exists — it does NOT
// introduce a codec and it does NOT add a language primitive.
//
//   * the listing comes from the central directory (never from the local
//     headers), so a data-descriptor entry (flag bit 3, sizes zeroed in the
//     local header) still reports its real sizes;
//   * method 0 (stored) is returned as it is;
//   * method 8 (deflate) is INFLATED by the existing `libs/image/Inflate.kf`
//     (262 lines of pure-Kof DEFLATE). ZIP carries RAW deflate — there is no
//     zlib wrapper to strip, unlike `pdfInflate`;
//   * CRC-32 (reflected, polynomial 0xEDB88320) is verified against the
//     central directory at the end of every read;
//   * the byte ceiling is the CALLER's (`maxBytes`), never the size DECLARED
//     in the archive: `Inflate` never writes past `outLen` and `run()` returns
//     the TRUE byte count, so a lying uncompressed size cannot get past it.
//     That is the decompression-bomb defence the issue asks for. Honest
//     limit: the cap bounds the MEMORY; the CPU still follows the stream.
//
// Refused with an explicit diagnostic, never silence: ZIP64 (any sentinel),
// an encrypted entry (flag bit 0), a method outside {0, 8}, and a
// local/central mismatch.
//
// NOT in this slice (still open in #852): `open()`/`readChunk()` streaming
// driven by the caller, and any `extractTo` — writing to disk needs the
// confinement primitive of #854 (`createNew`), which is a maintainer scope
// decision.
//
// Names follow the format's own rule: the UTF-8 flag (bit 11) decides. With it
// set the name is UTF-8; CLEAR means CP437 (code page 437), the encoding the
// spec mandates for legacy archives — decoding those as UTF-8 used to show
// replacement characters. Both halves are covered: 0x00..0x7F is ASCII and the
// 0x80..0xFF table lives below.

/** One central-directory entry, exactly as the archive declares it. */
record ZipEntry(String name, Int flags, Int method, Int crc32, Int compressedSize,
                Int uncompressedSize, Int externalAttributes, Int localHeaderOffset,
                Int nameLength)

// --- little-endian readers (the ZIP format is little-endian throughout) ---

Int zipU16(Int[] b, Int at) {
    return (b[at] & 255) | ((b[at + 1] & 255) << 8)
}

Int zipU32(Int[] b, Int at) {
    return (b[at] & 255) | ((b[at + 1] & 255) << 8)
        | ((b[at + 2] & 255) << 16) | ((b[at + 3] & 255) << 24)
}

/** A bounded copy — the shape both readers need (the ZIP slices a payload, the
 *  GZIP collects members into one output). */
Int[] zipSlice(Int[] b, Int from, Int len) {
    var out = new Int[len]
    var i = 0
    while (i < len) {
        out[i] = b[from + i] & 255
        i = i + 1
    }
    return out
}

/** CRC-32 (reflected, polynomial 0xEDB88320) over the whole array. */
Int zipCrc32(Int[] data) {
    return zipCrc32(data, data.length)
}

/** CRC-32 over the first `len` bytes — the GZIP's `Inflate.out` is a
 *  caller-sized window, so only the bytes the stream actually produced count. */
Int zipCrc32(Int[] data, Int len) {
    return zipCrc32State(-1, data, len) ^ -1
}

/** CRC-32 state update over the first `len` bytes, WITHOUT the final xor — the
 *  incremental form the writers need (a stream arrives in several calls, and
 *  holding all of it to compute the CRC once would defeat the streaming). */
Int zipCrc32State(Int crc, Int[] data, Int len) {
    var poly = -306674912
    var i = 0
    while (i < len) {
        crc = crc ^ (data[i] & 255)
        var k = 0
        while (k < 8) {
            if ((crc & 1) == 1) {
                crc = ((crc >> 1) & 2147483647) ^ poly
            } else {
                crc = (crc >> 1) & 2147483647
            }
            k = k + 1
        }
        i = i + 1
    }
    return crc
}

/** Bytes UTF-8 de uma string — o par do DECODIFICADOR `zipUtf8`, e o que os
 *  escritores da família precisam (o `kof.io` grava texto mas não expõe o
 *  codificador). 1/2/3/4 bytes por code point, com o par surrogate tratado (o
 *  armazenamento nativo tem WTF-8, §537). */
Int[] zipUtf8Bytes(String s) {
    var out: List<Int> = listOf()
    var i = 0
    while (i < s.length) {
        var cp = s.charAt(i) as Int
        if (cp >= 55296 && cp <= 56319 && i + 1 < s.length) {
            var lo = s.charAt(i + 1) as Int
            if (lo >= 56320 && lo <= 57343) {
                cp = 65536 + ((cp - 55296) << 10) + (lo - 56320)
                i = i + 1
            }
        }
        if (cp < 128) {
            out.add(cp)
        } else if (cp < 2048) {
            out.add(192 | (cp >> 6))
            out.add(128 | (cp & 63))
        } else if (cp < 65536) {
            out.add(224 | (cp >> 12))
            out.add(128 | ((cp >> 6) & 63))
            out.add(128 | (cp & 63))
        } else {
            out.add(240 | (cp >> 18))
            out.add(128 | ((cp >> 12) & 63))
            out.add(128 | ((cp >> 6) & 63))
            out.add(128 | (cp & 63))
        }
        i = i + 1
    }
    var bytes = new Int[out.size()]
    var k = 0
    while (k < out.size()) {
        bytes[k] = out[k]
        k = k + 1
    }
    return bytes
}

/** The 0x80..0xFF half of CP437 (code page 437) — the table APPNOTE 6.3.x
 *  mandates for an entry name when the UTF-8 flag (bit 11) is CLEAR. The
 *  0x00..0x7F half is ASCII, so only this half needs a table. */
String zipCp437High() {
    return "ÇüéâäàåçêëèïîìÄÅÉæÆôöòûùÿÖÜ¢£¥₧ƒáíóúñÑªº¿⌐¬½¼¡«»░▒▓│┤╡╢╖╕╣║╗╝╜╛┐└┴┬├─┼╞╟╚╔╩╦╠═╬╧╨╤╥╙╘╒╓╫╪┘┌█▄▌▐▀αßΓπΣσµτΦΘΩδ∞φε∩≡±≥≤⌠⌡÷≈°∙·√ⁿ²■ "
}

/** CP437 of `len` bytes from `from`. Used for a legacy archive (bit 11 clear):
 *  decoding those names as UTF-8 produced replacement characters. */
String zipCp437(Int[] b, Int from, Int len) {
    var high = zipCp437High()
    var s = ""
    var i = 0
    while (i < len) {
        var c = b[from + i] & 255
        if (c < 128) {
            s = s + (c as Char)
        } else {
            s = s + high.charAt(c - 128)
        }
        i = i + 1
    }
    return s
}

/** UTF-8 of `len` bytes from `from` (see the CP437 limit in the header). */
String zipUtf8(Int[] b, Int from, Int len) {
    var s = ""
    var i = 0
    while (i < len) {
        var c = b[from + i] & 255
        if (c < 128) {
            s = s + (c as Char)
            i = i + 1
        } else if (c < 224) {
            s = s + ((((c & 31) << 6) | (b[from + i + 1] & 63)) as Char)
            i = i + 2
        } else if (c < 240) {
            var cp = ((c & 15) << 12) | ((b[from + i + 1] & 63) << 6) | (b[from + i + 2] & 63)
            s = s + (cp as Char)
            i = i + 3
        } else {
            var cp = ((c & 7) << 18) | ((b[from + i + 1] & 63) << 12)
                | ((b[from + i + 2] & 63) << 6) | (b[from + i + 3] & 63)
            var v = cp - 65536
            s = s + ((55296 + (v >> 10)) as Char)
            s = s + ((56320 + (v & 1023)) as Char)
            i = i + 4
        }
    }
    return s
}

/** Offset of the End Of Central Directory record, or an honest throw.
 *  The record is at most 22 + 65535 bytes from the end (a long comment is
 *  legal, so the scan is bounded by the format itself, not by a guess). */
Int zipEocdAt(Int[] b) {
    var low = b.length - 65557
    if (low < 0) {
        low = 0
    }
    var i = b.length - 22
    while (i >= low) {
        if (zipU32(b, i) == 101010256) {
            return i
        }
        i = i - 1
    }
    throw "archive: end of central directory not found (not a ZIP archive?)"
}

/** Walks the central directory, in file order. */
List<ZipEntry> zipReadCentralDirectory(Int[] b) {
    var eocd = zipEocdAt(b)
    var total = zipU16(b, eocd + 10)
    var cdSize = zipU32(b, eocd + 12)
    var cdOffset = zipU32(b, eocd + 16)
    if (total == 65535 || cdSize < 0 || cdOffset < 0) {
        throw "archive: ZIP64 sentinel in the end of central directory — ZIP64 is not supported"
    }
    if (cdOffset + cdSize > b.length) {
        throw "archive: the central directory lies outside the file (truncated?)"
    }
    var out: List<ZipEntry> = listOf()
    var at = cdOffset
    var n = 0
    while (n < total) {
        if (zipU32(b, at) != 33639248) {
            throw "archive: bad central directory entry signature at " + at
        }
        var flags = zipU16(b, at + 8)
        var method = zipU16(b, at + 10)
        var crc = zipU32(b, at + 16)
        var compressed = zipU32(b, at + 20)
        var uncompressed = zipU32(b, at + 24)
        var nameLen = zipU16(b, at + 28)
        var extraLen = zipU16(b, at + 30)
        var commentLen = zipU16(b, at + 32)
        var externAttrs = zipU32(b, at + 38)
        var localOffset = zipU32(b, at + 42)
        // APPNOTE 6.3.x: bit 11 (EFS) set = the name is UTF-8; CLEAR = CP437.
        var name = (if ((flags & 2048) != 0) zipUtf8(b, at + 46, nameLen)
                else zipCp437(b, at + 46, nameLen))
        out.add(ZipEntry(name, flags, method, crc, compressed, uncompressed,
                externAttrs, localOffset, nameLen))
        at = at + 46 + nameLen + extraLen + commentLen
        n = n + 1
    }
    return out
}

/** A ZIP archive already positioned on its central directory. */
class Zip {

    Int[] bytes
    List<ZipEntry> entries

    public constructor(String path) {
        this.bytes = File(path).readBytes()
        this.entries = zipReadCentralDirectory(this.bytes)
    }

    /** The first entry with this name, or null when the archive has none. */
    ZipEntry? find(String name) {
        for (var e in this.entries) {
            if (e.name == name) {
                return e
            }
        }
        return null
    }

    /** The entry as UTF-8 TEXT — the usual case (XML, SPED, CSV) and the reason
     *  most callers are here at all. Same ceiling and CRC-32 contract as
     *  {@link #readEntry}. */
    String readText(ZipEntry e, Int maxBytes) {
        var bytes = this.readEntry(e, maxBytes)
        return zipUtf8(bytes, 0, bytes.length)
    }

    /** Reads (and, for method 8, INFLATES) one entry, verifying its CRC-32.
     *
     *  `maxBytes` is the caller's ceiling and the ONLY size we trust: an entry
     *  whose real output exceeds it is refused, never returned truncated. */
    Int[] readEntry(ZipEntry e, Int maxBytes) {
        if ((e.flags & 1) != 0) {
            throw "archive: entry '" + e.name + "' is encrypted (flag bit 0) — not supported"
        }
        if (e.method != 0 && e.method != 8) {
            throw "archive: entry '" + e.name + "' uses compression method " + e.method
                + " (only 0 = stored and 8 = deflate are supported)"
        }
        if (e.compressedSize < 0 || e.uncompressedSize < 0 || e.localHeaderOffset < 0) {
            throw "archive: entry '" + e.name + "' carries a ZIP64 sentinel — ZIP64 is not supported"
        }
        // The sizes come from the CENTRAL directory, so a data-descriptor entry
        // (flag bit 3, zeroed local sizes) is read correctly; the local header is
        // used only for its own name/extra lengths, which may legitimately differ.
        var at = e.localHeaderOffset
        if (at + 30 > this.bytes.length || zipU32(this.bytes, at) != 67324752) {
            throw "archive: bad local header signature for '" + e.name + "'"
        }
        if (zipU16(this.bytes, at + 8) != e.method) {
            throw "archive: local header method " + zipU16(this.bytes, at + 8)
                + " disagrees with the central directory (" + e.method + ") for '" + e.name + "'"
        }
        var start = at + 30 + zipU16(this.bytes, at + 26) + zipU16(this.bytes, at + 28)
        if (start + e.compressedSize > this.bytes.length) {
            throw "archive: truncated compressed data for '" + e.name + "'"
        }
        var payload = new Int[e.compressedSize]
        var i = 0
        while (i < e.compressedSize) {
            payload[i] = this.bytes[start + i] & 255
            i = i + 1
        }
        Int[] out
        if (e.method == 0) {
            if (payload.length > maxBytes) {
                throw "archive: entry '" + e.name + "' holds " + payload.length
                    + " bytes, over the limit of " + maxBytes
            }
            out = payload
        } else {
            // The DECLARED size is the first thing that must fit the caller's
            // ceiling: this is the bomb defence at the level the format lets us
            // check for free, and it is what stops a "declares 4 GiB, holds 1 KiB"
            // archive before a single byte is allocated.
            if (e.uncompressedSize > maxBytes) {
                throw "archive: entry '" + e.name + "' declares " + e.uncompressedSize
                    + " bytes, over the limit of " + maxBytes
            }
            // Capacity = the declared size (now known to be <= maxBytes). `Inflate`
            // never writes past `outLen`, so the allocation is bounded by the
            // ceiling; a stream that LIES and inflates to more than it declared
            // walks off the window, which surfaces as an exception — caught here
            // and turned into an explicit refusal, never into a silent truncation.
            var inflate = Inflate(payload, e.uncompressedSize)
            Int got = -1
            try {
                got = inflate.run()
            } catch (String _) {
                // The inner message is platform-specific (the Script's index error
                // carries none), so it is deliberately NOT echoed: the refusal text
                // is the library's own and reads the same on every target.
                throw "archive: entry '" + e.name + "' did not inflate to its declared "
                    + e.uncompressedSize + " bytes — refused"
            }
            // The REAL count is `inflate.outPos`, not `run()`'s return: the return
            // is CLAMPED to the capacity when the output saturates (`return outLen`),
            // so a stream that overran reports exactly the declared size and would
            // read as honest here. The walk-off exception above only fires when a
            // copy reaches past the window; literals-only streams never do. Both
            // shapes must be refused with the SAME message.
            if (inflate.outPos != e.uncompressedSize) {
                throw "archive: entry '" + e.name + "' did not inflate to its declared "
                    + e.uncompressedSize + " bytes — refused"
            }
            got = e.uncompressedSize
            out = new Int[got]
            var k = 0
            while (k < got) {
                out[k] = inflate.out[k] & 255
                k = k + 1
            }
        }
        var crc = zipCrc32(out)
        if (crc != e.crc32) {
            throw "archive: CRC-32 mismatch for '" + e.name + "' (archive " + e.crc32
                + ", computed " + crc + ")"
        }
        return out
    }

// --- extração com CONFINAMENTO (a política que a #852 pede) -------------------

/** Nome relativo SEGURO, ou `""` quando o nome ESCAPA do destino. Recusa:
 *  caminho absoluto (`/...`), unidade Windows (`:`), separador `\` (contrabando
 *  de separador), e os segmentos `..`, `.` e vazios. Esta é a barreira que
 *  protege contra o ZIP malicioso comum — ela olha o NOME, não o sistema de
 *  arquivos, e por isso vale antes de qualquer coisa tocar o disco. */
String zipSafeRelative(String name) {
    if (name.length == 0) {
        return ""
    }
    if (name.indexOf("/") == 0) {
        return ""
    }
    if (name.indexOf(":") >= 0) {
        return ""
    }
    if (name.indexOf("\\") >= 0) {
        return ""
    }
    var parts = name.split("/")
    var out = ""
    var i = 0
    while (i < parts.length) {
        var p = parts[i]
        if (p == "" || p == "." || p == "..") {
            return ""
        }
        out = if (out == "") p else out + "/" + p
        i = i + 1
    }
    return out
}

/** Extrai TODAS as entradas para `destDir`, com confinamento obrigatório e SEM
 *  sobrescrever nada. Devolve quantos ARQUIVOS escreveu (diretórios não contam).
 *
 *  Recusa, com mensagem explícita: entrada que escapa (via `zipSafeRelative`),
 *  caminho que já existe (arquivo OU link) e conteúdo acima do teto do chamador
 *  (`zip.readEntry` aplica o `maxBytes` por entrada, como em todo o resto).
 *
 *  LIMITE HONESTO, e é por isso que a #854 existe: a checagem de link é
 *  "conferir-depois-gravar", então a JANELA TOCTOU entre `isSymlink()`/`exists()`
 *  e a gravação continua aberta — um atacante que planta um link pendente entre
 *  as duas chamadas ainda consegue escrever através dele. O que está fechado
 *  aqui é o confinamento de NOME, que é o vetor do ZIP malicioso comum; o de
 *  corrida exige a primitiva `createNew` (criação exclusiva) da #854. */

    /** Valida a ESTRUTURA do arquivo e devolve quantas entradas conferiu.
     *
     *  A #852 pede isto explicitamente no escopo ("consistência entre cabeçalho
     *  local e diretório central, sobreposição de dados entre entradas"), e são
     *  dois vetores que a LEITURA sozinha não pega:
     *
     *  1. **local x central** — o mesmo nome declarando método, tamanhos ou CRC
     *     diferentes nos dois lugares. Um extrator que confia num e outro no
     *     outro entrega bytes que ninguém pode prever. O `data descriptor`
     *     (flag bit 3) é a EXCEÇÃO prevista na especificação: ali os campos do
     *     cabeçalho local são ZERO por definição, e comparar seria falso
     *     positivo — então nesse caso quem manda é o diretório central;
     *  2. **sobreposição de dados** — duas entradas cujas faixas de bytes se
     *     cruzam; é assim que um arquivo faz o conteúdo de uma aparecer sob o
     *     nome da outra.
     *
     *  Custo honesto: a ordenação é por INSERÇÃO sobre duas listas paralelas —
     *  O(n) para o caso comum (as entradas vêm na ordem do arquivo, que já é a
     *  ordenada) e O(n^2) só com entradas fora de ordem, que é o caso em que a
     *  checagem importa. `extractTo` chama isto antes de escrever nada. */
    Int validate() {
        var starts: List<Int> = listOf()
        var ends: List<Int> = listOf()
        var n = 0
        for (var e in this.entries) {
            var at = e.localHeaderOffset
            if (at < 0 || at + 30 > this.bytes.length || zipU32(this.bytes, at) != 67324752) {
                throw "archive: entry '" + e.name + "' has no readable local header"
            }
            var localFlags = zipU16(this.bytes, at + 6)
            var localMethod = zipU16(this.bytes, at + 8)
            var localNameLen = zipU16(this.bytes, at + 26)
            var localExtraLen = zipU16(this.bytes, at + 28)
            if (localMethod != e.method) {
                throw "archive: entry '" + e.name + "' declares method " + localMethod
                    + " in the local header and " + e.method + " in the central directory"
            }
            var localName = (if ((e.flags & 2048) != 0)
                    zipUtf8(this.bytes, at + 30, localNameLen)
                    else zipCp437(this.bytes, at + 30, localNameLen))
            if (localName != e.name) {
                throw "archive: entry '" + e.name + "' is named '" + localName
                    + "' in the local header — inconsistent with the central directory"
            }
            if ((e.flags & 8) == 0) {          // sem data descriptor: os campos valem
                var localCrc = zipU32(this.bytes, at + 14)
                var localComp = zipU32(this.bytes, at + 18)
                var localUncomp = zipU32(this.bytes, at + 22)
                if (localComp != e.compressedSize || localUncomp != e.uncompressedSize) {
                    throw "archive: entry '" + e.name + "' sizes differ between the local header ("
                        + localComp + "/" + localUncomp + ") and the central directory ("
                        + e.compressedSize + "/" + e.uncompressedSize + ")"
                }
                if (localCrc != e.crc32) {
                    throw "archive: entry '" + e.name + "' CRC-32 differs between the local header ("
                        + localCrc + ") and the central directory (" + e.crc32 + ")"
                }
            }
            var dataAt = at + 30 + localNameLen + localExtraLen
            if (dataAt < 0 || dataAt + e.compressedSize > this.bytes.length) {
                throw "archive: entry '" + e.name + "' data runs past the end of the archive"
            }
            // inserção ordenada (paralela) — O(n) quando já está ordenado
            var k = starts.size()
            while (k > 0 && starts.get(k - 1) > dataAt) { k = k - 1 }
            starts.add(0)
            ends.add(0)
            var j = starts.size() - 1
            while (j > k) {
                starts.set(j, starts.get(j - 1))
                ends.set(j, ends.get(j - 1))
                j = j - 1
            }
            starts.set(k, dataAt)
            ends.set(k, dataAt + e.compressedSize)
            n = n + 1
        }
        var i = 1
        while (i < starts.size()) {
            if (starts.get(i) < ends.get(i - 1) && ends.get(i) > starts.get(i - 1)) {
                throw "archive: entries overlap in the file — the data at " + starts.get(i)
                    + " is inside another entry's range (refused)"
            }
            i = i + 1
        }
        return n
    }

    Int extractTo(String destDir, Int maxBytes) {
        // A validação estrutural vem PRIMEIRO: extrair de um arquivo que mente
        // sobre a própria estrutura é o caso em que o confinamento por nome não
        // basta (o nome é o que ele quer, o conteúdo é o que ele forjou).
        this.validate()
        if (!Directory(destDir).createDirectories()) {
            throw "archive: could not create destination directory '" + destDir + "'"
        }
        var written = 0
        for (var e in this.entries) {
            var safe = zipSafeRelative(e.name)
            if (safe == "") {
                throw "archive: refusing entry '" + e.name + "' — it escapes the destination"
            }
            // §766: `indexOf("/") == length - 1` só reconhecia diretório de UM
            // nível (indexOf acha a PRIMEIRA barra) — "d/e/" (barra em 1, não
            // em length-1=3) virava arquivo vazio e tudo embaixo se perdia em
            // silêncio. `endsWith` vale pra qualquer profundidade de aninhamento.
            var isDirEntry = e.name.endsWith("/")
            var parts = safe.split("/")
            var walked = destDir
            var k = 0
            while (k < parts.length - 1) {
                walked = walked + "/" + parts[k]
                if (!Directory(walked).createDirectories()) {
                    throw "archive: could not create directory '" + walked + "' while extracting '" + e.name + "'"
                }
                k = k + 1
            }
            var full = destDir + "/" + safe
            if (isDirEntry) {
                if (!Directory(full).createDirectories()) {
                    throw "archive: could not create directory '" + full + "' while extracting '" + e.name + "'"
                }
            } else {
                if (File(full).exists() || File(full).isSymlink()) {
                    throw "archive: refusing to overwrite '" + safe + "' — it already exists"
                }
                // `writeBytes` toma Int[] (bytes como inteiros), a MESMA moeda que
                // `readBytes` devolve — sem ponte aqui. (A face binária do crypto é
                // que pede Byte[], e é a única conversão da família.)
                // §766: o Bool de status era descartado — uma falha de escrita
                // silenciosa contava como sucesso em `written`. Agora é honesto.
                if (!File(full).writeBytes(this.readEntry(e, maxBytes))) {
                    throw "archive: could not write '" + safe + "' while extracting '" + e.name + "'"
                }
                written = written + 1
            }
        }
        return written
    }
}

// --- escrita (método 0 = STORED) ---------------------------------------------

/** Escritor de ZIP. Escreve entradas **STORED** (método 0): o conteúdo entra
 *  VERBATIM, sem compressor — nenhuma primitiva nova e nenhuma dependência.
 *  Método 8 (deflate) precisaria de um compressor, e é uma fatia própria; um
 *  escritor que se diz "zip" e não comprime tem de DIZER isso, e diz.
 *
 *  Estrutura: cada entrada é gravada na hora (cabeçalho local + dados), e o
 *  diretório central é montado no `close()` a partir do que ficou ANOTADO
 *  (nome, CRC, tamanhos, offset) — o escritor não retém as cargas em memória.
 *
 *  Determinismo: data/hora ZERO em todo cabeçalho, então o mesmo input produz
 *  bytes idênticos (a mesma regra do `TarWriter`, e a que os goldens exigem).
 *
 *  Nomes vão em **UTF-8 com o bit 11 (EFS) ligado** — que é o sinal que o
 *  formato define para isso, e o mesmo bit que o LEITOR desta livraria já
 *  consulta: o que este escritor produz, ele próprio lê de volta pelo caminho
 *  certo. Nome acima de 65535 bytes é recusado (o campo é u16). */
class ZipWriter {

    String path
    List<String> names
    List<Int> crcs
    List<Int> sizes
    List<Int> offsets
    Int total
    Bool started

    public constructor(String path) {
        this.path = path
        this.names = listOf()
        this.crcs = listOf()
        this.sizes = listOf()
        this.offsets = listOf()
        this.total = 0
        this.started = false
    }

    /** Acrescenta uma entrada STORED. Nome repetido é RECUSADO: o ZIP não tem
     *  identidade por nome, e duas entradas iguais viram, na extração, um
     *  sobrescrever o outro sem aviso. */
    void addFile(String name, Int[] data) {
        var nameBytes = zipUtf8Bytes(name)
        if (nameBytes.length == 0) {
            throw "archive: empty zip entry name"
        }
        if (nameBytes.length > 65535) {
            throw "archive: zip entry name over 65535 bytes (the length field is 16-bit)"
        }
        var i = 0
        while (i < this.names.size()) {
            if (this.names.get(i) == name) {
                throw "archive: entry '" + name + "' was already added — duplicate names are refused"
            }
            i = i + 1
        }
        var crc = zipCrc32(data)
        var header = new Int[30 + nameBytes.length]
        zipU32Put(header, 0, 67324752)                 // PK\x03\x04
        zipU16Put(header, 4, 20)                       // version needed
        zipU16Put(header, 6, 2048)                     // bit 11 = nome em UTF-8
        zipU16Put(header, 8, 0)                        // método 0 = STORED
        zipU32Put(header, 14, crc)
        zipU32Put(header, 18, data.length)
        zipU32Put(header, 22, data.length)
        zipU16Put(header, 26, nameBytes.length)
        var k = 0
        while (k < nameBytes.length) {
            header[30 + k] = nameBytes[k]
            k = k + 1
        }
        this.offsets.add(this.total)
        this.names.add(name)
        this.crcs.add(crc)
        this.sizes.add(data.length)
        this.push(header)
        this.push(data)
    }

    /** Acrescenta uma entrada a partir de TEXTO (UTF-8). */
    void addText(String name, String text) {
        this.addFile(name, zipUtf8Bytes(text))
    }

    /** Escreve o diretório central + o EOCD e devolve o tamanho em bytes. */
    Int close() {
        var cdStart = this.total
        var i = 0
        while (i < this.names.size()) {
            var nameBytes = zipUtf8Bytes(this.names.get(i))
            var rec = new Int[46 + nameBytes.length]
            zipU32Put(rec, 0, 33639248)                // PK\x01\x02
            zipU16Put(rec, 4, 20)                      // version made by
            zipU16Put(rec, 6, 20)                      // version needed
            zipU16Put(rec, 8, 2048)                    // bit 11 = UTF-8
            zipU16Put(rec, 10, 0)                      // método 0
            zipU32Put(rec, 16, this.crcs.get(i))
            zipU32Put(rec, 20, this.sizes.get(i))
            zipU32Put(rec, 24, this.sizes.get(i))
            zipU16Put(rec, 28, nameBytes.length)
            zipU32Put(rec, 42, this.offsets.get(i))
            var k = 0
            while (k < nameBytes.length) {
                rec[46 + k] = nameBytes[k]
                k = k + 1
            }
            this.push(rec)
            i = i + 1
        }
        var cdSize = this.total - cdStart
        var eocd = new Int[22]
        zipU32Put(eocd, 0, 101010256)                  // PK\x05\x06
        zipU16Put(eocd, 8, this.names.size())
        zipU16Put(eocd, 10, this.names.size())
        zipU32Put(eocd, 12, cdSize)
        zipU32Put(eocd, 16, cdStart)
        this.push(eocd)
        return this.total
    }

    void push(Int[] bytes) {
        if (this.started) {
            File(this.path).appendBytes(bytes)
        } else {
            File(this.path).writeBytes(bytes)
            this.started = true
        }
        this.total = this.total + bytes.length
    }
}

/** Escrita little-endian num buffer de Int — o par dos leitores `zipU16`/`zipU32`. */
void zipU16Put(Int[] b, Int at, Int value) {
    b[at] = value & 255
    b[at + 1] = (value >> 8) & 255
}

void zipU32Put(Int[] b, Int at, Int value) {
    b[at] = value & 255
    b[at + 1] = (value >> 8) & 255
    b[at + 2] = (value >> 16) & 255
    b[at + 3] = (value >> 24) & 255
}


