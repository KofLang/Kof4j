main() {
    println(validation.isEmail("a@b.com"))
    println(validation.isEmail("bad"))
    println(validation.isUrl("https://kof.dev"))
    println(validation.isUrl("http://a.b"))
    println(validation.isUrl("https://example.com/path?q=1"))
    println(validation.isUrl("ftp://x"))
    println(validation.isInt("42"))
    println(validation.isInt("4.2"))
    println(validation.isLong("9000000000"))
    println(validation.inRange(5, 1, 10))
    println(validation.inRange(11, 1, 10))
    println(validation.required("x"))
    println(validation.required(""))
    println(validation.notBlank("x"))
    println(validation.notBlank("   "))
    println(validation.minLength("abc", 2))
    println(validation.maxLength("abc", 2))
    println(validation.lengthBetween("abc", 1, 5))
    println(validation.creditCardBrand("4242424242424242"))
    println(validation.creditCardBrand("5555555555554444"))
    println(validation.last4("4242424242424242"))
    println(validation.max(5, 10))
    println(validation.min(5, 10))
    println("end")
}
