main() {
    println(math.parseInt("42"))
    println(math.parseInt(" 42 "))
    println(math.parseInt("-7"))
    println(math.parseInt("+7"))
    println(math.parseInt("0"))
    println(math.parseLong("9000000000"))
    println(math.parseLong("-9000000000"))
    println(math.parseDouble("3.14"))
    println(math.parseDouble("1e3"))
    println(math.parseDouble("-0.5"))
    println(math.parseIntOrDefault("bad", -1))
    println(math.parseIntOrDefault("42", -1))
    println(math.parseIntOrDefault("", -1))
    println(math.parseIntOrDefault("  ", -1))
    println(math.parseIntOrDefault("99999999999999", -1))
    println(math.parseLongOrDefault("bad", -9))
    println(math.parseLongOrDefault("9000000000", -9))
    println(math.parseDoubleOrDefault("bad", -2.5))
    println(math.parseDoubleOrDefault("2.5", -2.5))
    println("end")
}
