main() {
    var m = mapOf("a", 1)
    m.put("b", 2)
    m.put("c", 3)
    println(m.size)
    println(m.containsKey("b"))
    println(m.containsValue(3))
    println(m.get("a"))
    println(m.getOrDefault("z", 9))
    var prev = m.putIfAbsent("a", 99)
    println(prev)
    println(m.get("a"))
    var added = m.putIfAbsent("d", 4)
    println(added == null)
    println(m.size)
    println(m.remove("b"))
    println(m.size)

    var s = setOf(1, 2, 3)
    s.add(3)
    println(s.size)
    println(s.contains(2))
    println(s.isEmpty())
    s.remove(1)
    println(s.size)
    s.clear()
    println(s.isEmpty())
    println(s.size)
}
