main() {
    println(time.parseDateIso("1970-01-01"))
    println(time.parseDateIso("2026-01-01"))
    println(time.parseDateIso("2026-10-10"))
    println(time.parseDateIso("bad"))
    println(time.parseDateIso("2026-13-01"))
    println(time.parseDateIso("2026-02-30"))
    println(time.startOf("2026-10-10", "day"))
    println(time.startOf("2026-10-10", "week"))
    println(time.endOf("2026-10-10", "week"))
    println(time.startOf("2026-10-05", "week"))
    println(time.startOf("2026-10-10", "month"))
    println(time.endOf("2026-10-10", "month"))
    println(time.startOf("2026-10-10", "year"))
    println(time.endOf("2026-10-10", "year"))
    println(time.startOf("2026-10-10", "bogus"))
    println(time.endOf("2026-10-10", "bogus"))
    println(time.startOf("bad", "month"))
    println(time.age(1990, 6, 15, 2026, 10, 10))
    println(time.age(1990, 12, 31, 2026, 10, 10))
    println(time.age(2026, 10, 10, 2026, 10, 10))
    println(time.hoursBetween(2026, 1, 1, 0, 2026, 1, 2, 12))
    println(time.hoursBetween(2026, 1, 2, 12, 2026, 1, 1, 0))
    println("end")
}
