main() {
    println(math.abs(-7))
    println(math.abs(7))
    println(math.sign(-9))
    println(math.sign(0))
    println(math.sign(9))
    println(math.min(3, 8))
    println(math.max(3, 8))
    println(math.isEven(4))
    println(math.isEven(5))
    println(math.isOdd(5))
    println(math.isPositive(2))
    println(math.isPositive(0))
    println(math.isNegative(-2))
    println(math.isZero(0))
    println(math.isZero(1))
    println(math.clamp(15, 0, 10))
    println(math.clamp(-5, 0, 10))
    println(math.sqrt(16.0))
    println(math.lerp(0.0, 10.0, 0.5))
    println(math.percentage(3.0, 4.0))
    println(math.isInteger(4.0))
    println(math.isInteger(4.5))
    println(math.isDecimal(4.5))
    println(math.roundTo(3.14159, 2))
    println(math.roundTo(1234.0, -2))
}
