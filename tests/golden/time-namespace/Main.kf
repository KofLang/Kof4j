main() {
    println(time.isLeapYear(2024))
    println(time.isLeapYear(2023))
    println(time.isLeapYear(2000))
    println(time.isLeapYear(1900))
    println(time.isLeapYear(2100))
    println(time.daysInMonth(2024, 2))
    println(time.daysInMonth(2023, 2))
    println(time.daysInMonth(2024, 4))
    println(time.daysInMonth(2023, 12))
    println(time.dayOfWeek(2026, 10, 10))
    println(time.dayOfWeek(2026, 10, 9))
    println(time.dayOfWeek(2000, 1, 1))
    println(time.isWeekend(2026, 10, 10))
    println(time.isWeekend(2026, 10, 9))
    println(time.daysBetween(2026, 1, 1, 2026, 12, 31))
    println(time.daysBetween(2024, 1, 1, 2024, 3, 1))
    println(time.daysBetween(2026, 1, 1, 2027, 1, 1))
    println(time.diffDays("2026-01-01", "2026-12-31"))
    println(time.addDays("2026-01-31", 1))
    println(time.addDays("2024-02-28", 1))
    println(time.addMonths("2026-01-31", 1))
    println(time.addYears("2024-02-29", 1))
    println(time.formatDateIso(2026, 10, 10))
}
