main() {
    var xs = listOf(3, 1, 2, 5, 4)
    println(xs.reduce((a: Int, b: Int) -> a + b, 0))
    println(xs.indexOf(2))
    println(xs.lastIndexOf(1))
    println(xs.isEmpty())
    println(xs.none((n: Int) -> n > 9))
    println(xs.find((n: Int) -> n > 2))
    println(xs.slice(1, 2).size)
    println(xs.take(2).size)
    println(xs.drop(3).size)
    var g = xs.groupBy((n: Int) -> n % 2)
    println(g.size)
    var y = listOf(1, 2).flatMap((n: Int) -> listOf(n, n * 10))
    println(y.size)
    println(y.get(2))
    var z = listOf(3, 1, 2)
    z.sort()
    println(z.get(0))
    var w = listOf(1, 2)
    w.addAll(listOf(3, 4))
    println(w.size)
    println(w.subList(1, 3).size)
    w.remove(0)
    println(w.size)
    xs.sorted((a: Int, b: Int) -> b - a).forEach((n: Int) -> println("s" + n))
}
