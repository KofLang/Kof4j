<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.kof</groupId>
        <artifactId>kof-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>kof-cli</artifactId>
    <name>Kof CLI</name>

    <dependencies>
        <dependency>
            <groupId>dev.kof</groupId>
            <artifactId>kof-compiler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- testing-platform §6 provider (D-MAINT-BATCH-0610B/C, fourth chat
             poll 10/10): the Playwright JAVA lib as a NORMAL dependency — the
             maintainer's call supersedes 'does not bundle' for the lib jar;
             the BROWSERS stay per-project (npx playwright install). -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.63.0</version>
        </dependency>
        <dependency>
            <groupId>dev.kof</groupId>
            <artifactId>kof-script</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.kof</groupId>
            <artifactId>kof-c-compiler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><version>2.5.252</version><scope>test</scope></dependency><dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>dev.kof.cli.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- §504-class: no module depends on kof-cli, so the
                         dependency-reduced pom is never consumed. Leaving it
                         true makes shade resolve project.getParent() against
                         the CI-friendly `${revision}` parent and abort with
                         "Not fully interpolated artifact dev.kof:kof-parent:
                         pom:${revision}" on newer Maven runners (measured
                         GitHub ubuntu-latest 09/10: `mvn clean package` fails
                         in kof-cli after the tests pass). false skips that
                         model rewrite; the uber-jar is unchanged. -->
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>dev.kof.cli.Main</mainClass>
                            <manifestEntries>
                                <Multi-Release>true</Multi-Release>
                            </manifestEntries>
                        </transformer>
                        
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                    </transformers>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                
                                <exclude>module-info.class</exclude>
                                <exclude>META-INF/versions/*/module-info.class</exclude>
                                
                                <exclude>META-INF/MANIFEST.MF</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- test-architecture Phase 7 ("mvn verify"): the official golden
             (jvm+native+js+script) and CLI integration suites run in the
             `verify` phase against the freshly shaded CLI jar, so
             `mvn verify -Pintegration` is the plan's integration gate. The
             scripts live at the reactor root; maven.multiModuleProjectDirectory
             points there regardless of the module being built. -->
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>golden-tests</id>
                                <phase>verify</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <arguments><argument>tests/run-golden.sh</argument></arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>integration-tests</id>
                                <phase>verify</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <arguments><argument>tests/run-integration.sh</argument></arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>